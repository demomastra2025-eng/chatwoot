#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COLIMA_SOCKET="${HOME}/.colima/default/docker.sock"
DOCKER_HOST_CANDIDATE="unix://${COLIMA_SOCKET}"
APP_PORTS=(3000 3036)
RESTART_INFRA="${RESTART_INFRA:-0}"
PREPARE_DB="${PREPARE_DB:-0}"
CW_BOOTSTRAP_ENTERPRISE="${CW_BOOTSTRAP_ENTERPRISE:-1}"
DEV_LITE_FILTER_NOISE="${DEV_LITE_FILTER_NOISE:-1}"
DATABASE_PREPARED=0
LOG_DIR="${ONELINK_DEV_LITE_LOG_DIR:-${ROOT_DIR}/logs}"
TIMESTAMP="$(date '+%Y%m%d-%H%M%S')"
LOG_FILE="${ONELINK_DEV_LITE_LOG_FILE:-${LOG_DIR}/onelink-dev-lite-${TIMESTAMP}.log}"

filter_dev_lite_noise() {
  while IFS= read -r line; do
    case "$line" in
      *"the attribute \`version\` is obsolete"* ) continue ;;
      *"/.well-known/appspecific/com.chrome.devtools.json"* ) continue ;;
      *'Rack app ("GET /mini-profiler-resources/includes.js'* ) continue ;;
      *'DEPRECATION WARNING: The legacy JS API is deprecated and will be removed in Dart Sass 2.0.0.'* ) continue ;;
      *'More info: https://sass-lang.com/d/legacy-js-api'* ) continue ;;
      *'`defineEmits` is a compiler macro and no longer needs to be imported.'* ) continue ;;
      *'`defineExpose` is a compiler macro and no longer needs to be imported.'* ) continue ;;
      *'`defineProps` is a compiler macro and no longer needs to be imported.'* ) continue ;;
      *'`defineModel` is a compiler macro and no longer needs to be imported.'* ) continue ;;
      *'`defineOptions` is a compiler macro and no longer needs to be imported.'* ) continue ;;
      *'::v-deep usage as a combinator has been deprecated.'* ) continue ;;
      *'ActionController::RoutingError (No route matches [GET] "/.well-known/appspecific/com.chrome.devtools.json"):'* ) continue ;;
    esac

    printf '%s\n' "$line"
  done
}

mkdir -p "$LOG_DIR"
ln -sfn "$LOG_FILE" "$LOG_DIR/onelink-dev-lite-latest.log"
if [[ "$DEV_LITE_FILTER_NOISE" == "1" ]]; then
  exec > >(filter_dev_lite_noise | tee -a "$LOG_FILE") 2>&1
else
  exec > >(tee -a "$LOG_FILE") 2>&1
fi

echo "Logging Onelink dev-lite output to $LOG_FILE"

log() {
  printf '[dev-lite-restart] %s\n' "$*"
}

env_value() {
  local key="$1"
  local default_value="$2"
  local file="${ROOT_DIR}/.env"

  if [[ -f "$file" ]]; then
    local value
    value="$(grep -E "^${key}=" "$file" | tail -n 1 | cut -d= -f2- || true)"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  fi

  printf '%s' "$default_value"
}

ensure_rbenv() {
  if command -v rbenv >/dev/null 2>&1; then
    eval "$(rbenv init -)"
  fi
}

ensure_dependencies() {
  if ! bundle check >/dev/null 2>&1; then
    log "Installing missing Ruby gems"
    bundle install
  fi

  if [[ ! -d "${ROOT_DIR}/node_modules" ]]; then
    log "Installing missing pnpm packages"
    pnpm install
  fi
}

ensure_docker() {
  if docker info >/dev/null 2>&1; then
    return 0
  fi

  if ! command -v colima >/dev/null 2>&1; then
    log "Docker is unavailable and colima is not installed"
    exit 1
  fi

  export DOCKER_HOST="${DOCKER_HOST_CANDIDATE}"

  if ! docker info >/dev/null 2>&1; then
    log "Starting colima"
    colima start --cpu 2 --memory 4 --disk 20
  fi

  if ! docker info >/dev/null 2>&1; then
    log "Docker is still unavailable after starting colima"
    exit 1
  fi
}

stop_listeners() {
  local port
  local pids

  for port in "${APP_PORTS[@]}"; do
    pids="$(lsof -tiTCP:${port} -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "$pids" ]]; then
      log "Stopping listeners on port ${port}: ${pids//$'\n'/ }"
      kill $pids 2>/dev/null || true
    fi
  done

  sleep 1

  for port in "${APP_PORTS[@]}"; do
    pids="$(lsof -tiTCP:${port} -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "$pids" ]]; then
      log "Force stopping listeners on port ${port}: ${pids//$'\n'/ }"
      kill -9 $pids 2>/dev/null || true
    fi
  done
}

start_infra() {
  log "Starting postgres and redis"
  docker compose up -d postgres redis

  if [[ "$RESTART_INFRA" == "1" ]]; then
    log "Restarting postgres and redis containers"
    docker compose restart postgres redis
  fi
}

wait_for_postgres() {
  local db_name db_user attempts
  db_name="$(env_value POSTGRES_DATABASE chatwoot_dev)"
  db_user="$(env_value POSTGRES_USERNAME postgres)"
  attempts=60

  until docker compose exec -T postgres pg_isready -U "$db_user" -d "$db_name" >/dev/null 2>&1; do
    attempts=$((attempts - 1))
    if (( attempts == 0 )); then
      log "Postgres did not become ready in time"
      exit 1
    fi
    sleep 1
  done
}

wait_for_redis() {
  local redis_password attempts
  local redis_cmd
  redis_password="$(env_value REDIS_PASSWORD redis)"
  attempts=30
  redis_cmd=(docker compose exec -T redis redis-cli)

  if [[ -n "$redis_password" ]]; then
    redis_cmd+=(-a "$redis_password")
  fi

  redis_cmd+=(ping)

  until [[ "$("${redis_cmd[@]}" 2>/dev/null | tail -n 1)" == "PONG" ]]; do
    attempts=$((attempts - 1))
    if (( attempts == 0 )); then
      log "Redis did not become ready in time"
      exit 1
    fi
    sleep 1
  done
}

database_needs_prepare() {
  local db_name db_user table_exists
  db_name="$(env_value POSTGRES_DATABASE chatwoot_dev)"
  db_user="$(env_value POSTGRES_USERNAME postgres)"
  table_exists="$(
    docker compose exec -T postgres \
      psql -U "$db_user" -d "$db_name" -tAc \
      "SELECT 1 FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'ar_internal_metadata' LIMIT 1;" \
      2>/dev/null | tr -d '[:space:]' || true
  )"

  [[ "$table_exists" != "1" ]]
}

database_has_partial_schema_artifacts() {
  local db_name db_user schema_count
  db_name="$(env_value POSTGRES_DATABASE chatwoot_dev)"
  db_user="$(env_value POSTGRES_USERNAME postgres)"
  schema_count="$(
    docker compose exec -T postgres \
      psql -U "$db_user" -d "$db_name" -tAc \
      "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name IN ('agent_transport', 'evolution_api', 'mastra_agent');" \
      2>/dev/null | tr -d '[:space:]' || true
  )"

  [[ "$schema_count" != "0" && -n "$schema_count" ]]
}

reset_database() {
  local db_name db_user
  db_name="$(env_value POSTGRES_DATABASE chatwoot_dev)"
  db_user="$(env_value POSTGRES_USERNAME postgres)"

  log "Resetting partially initialized database ${db_name}"
  docker compose exec -T postgres dropdb --if-exists -U "$db_user" "$db_name"
  docker compose exec -T postgres createdb -U "$db_user" "$db_name"
}

prepare_database() {
  if [[ "$PREPARE_DB" == "1" ]]; then
    log "Preparing database"
    bundle exec rake db:chatwoot_prepare
    DATABASE_PREPARED=1
  elif database_needs_prepare; then
    if database_has_partial_schema_artifacts; then
      reset_database
    fi
    log "Database is not initialized yet, running db:chatwoot_prepare"
    bundle exec rake db:chatwoot_prepare
    DATABASE_PREPARED=1
  else
    log "Skipping database prepare (set PREPARE_DB=1 to force it)"
  fi
}

bootstrap_enterprise() {
  if [[ "$CW_BOOTSTRAP_ENTERPRISE" != "1" ]]; then
    log "Skipping enterprise bootstrap (set CW_BOOTSTRAP_ENTERPRISE=1 to enable it)"
    return 0
  fi

  if [[ "$DATABASE_PREPARED" == "1" ]]; then
    log "Enterprise bootstrap already applied via db:chatwoot_prepare"
    return 0
  fi

  log "Applying enterprise bootstrap"
  bundle exec rake chatwoot:instance:unlock_enterprise
}

start_app() {
  export DISABLE_MINI_PROFILER="${DISABLE_MINI_PROFILER:-1}"
  export SASS_SILENCE_DEPRECATIONS="${SASS_SILENCE_DEPRECATIONS:-legacy-js-api}"
  log "Starting Rails + Vite (dev lite)"
  exec foreman start -f ./Procfile.dev-lite
}

main() {
  cd "$ROOT_DIR"
  ensure_rbenv
  ensure_dependencies
  ensure_docker
  stop_listeners
  start_infra
  wait_for_postgres
  wait_for_redis
  prepare_database
  bootstrap_enterprise
  start_app
}

main "$@"
