#!/usr/bin/env bash

set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORKSPACE_ROOT="$(cd "${APP_DIR}/../.." && pwd)"
COMMAND="${1:-start}"
PROCFILE_PATH="./Procfile.dev-hybrid"
DEV_HYBRID_FILTER_NOISE="${DEV_HYBRID_FILTER_NOISE:-1}"
DEV_HYBRID_PRESERVE_DEBUG="${DEV_HYBRID_PRESERVE_DEBUG:-0}"
DEV_HYBRID_LOG_DIR="${DEV_HYBRID_LOG_DIR:-${APP_DIR}/logs}"
DEV_HYBRID_LOG_FILE="${DEV_HYBRID_LOG_FILE:-${DEV_HYBRID_LOG_DIR}/dev-hybrid.log}"
DEV_HYBRID_LATEST_LOG_LINK="${DEV_HYBRID_LOG_DIR}/onelink-dev-hybrid-latest.log"

filter_dev_hybrid_noise() {
  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "$line" in
      *"Exception 'LoadError' at "*"/ffi/"*"Could not open library 'inotify':"* ) continue ;;
      *"Exception 'LoadError' at "*"/ffi/"*"Could not open library 'libinotify.so':"* ) continue ;;
      *"Could not open library 'libinotify.so':"* ) continue ;;
      *"Searched in <system library path>"* ) continue ;;
      *"Exception 'Errno::ENOTDIR' at <internal:dir>:184 - Not a directory @ dir_initialize - ${APP_DIR}/"* ) continue ;;
      *"bootsnap/load_path_cache/path.rb:"* ) continue ;;
      *"visit_ActiveRecord_Relation_QueryAttribute"* ) continue ;;
      *"visit_ActiveModel_Attribute_WithCastValue"* ) continue ;;
    esac

    printf '%s\n' "$line"
  done
}

load_env() {
  local line key value
  [[ -f "${WORKSPACE_ROOT}/.env.development" ]] || return

  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -z "${line}" ]] && continue
    [[ "${line}" =~ ^[[:space:]]*# ]] && continue
    [[ "${line}" != *=* ]] && continue

    key="${line%%=*}"
    value="${line#*=}"
    export "${key}=${value}"
  done < "${WORKSPACE_ROOT}/.env.development"
}

setup_dev_hybrid_logging() {
  mkdir -p "${DEV_HYBRID_LOG_DIR}"
  ln -sfn "${DEV_HYBRID_LOG_FILE}" "${DEV_HYBRID_LATEST_LOG_LINK}"

  if [[ "${DEV_HYBRID_FILTER_NOISE}" == "1" ]]; then
    exec > >(filter_dev_hybrid_noise | tee -a "${DEV_HYBRID_LOG_FILE}")
    exec 2> >(filter_dev_hybrid_noise | tee -a "${DEV_HYBRID_LOG_FILE}" >&2)
  else
    exec > >(tee -a "${DEV_HYBRID_LOG_FILE}")
    exec 2> >(tee -a "${DEV_HYBRID_LOG_FILE}" >&2)
  fi
}

usage() {
  cat <<'EOF'
Usage:
  bin/dev-hybrid prepare
  bin/dev-hybrid prepare-test
  bin/dev-hybrid start
  bin/dev-hybrid start-foreman
  bin/dev-hybrid rails <args...>
  bin/dev-hybrid rails-test <args...>
  bin/dev-hybrid rspec <args...>
  bin/dev-hybrid vite
EOF
}

setup_ruby_environment() {
  local rbenv_root candidate

  for candidate in "${RBENV_ROOT:-}" "${HOME:-}/.rbenv" /root/.rbenv; do
    [[ -n "${candidate}" ]] || continue
    [[ -x "${candidate}/bin/rbenv" ]] || continue
    rbenv_root="${candidate}"
    break
  done

  [[ -n "${rbenv_root:-}" ]] || return

  export RBENV_ROOT="${rbenv_root}"
  export PATH="${RBENV_ROOT}/bin:${RBENV_ROOT}/shims:${PATH}"

  if command -v rbenv >/dev/null 2>&1; then
    eval "$(rbenv init - bash)"
  fi
}

setup_ruby_environment
load_env

# Keep the browser voice preview on the locally published Pipecat runtime in DEV.
# Production receives these values from docker-compose.production.yml instead.
export ONELINK_AI_VOICE_PIPECAT_BASE_URL="${ONELINK_AI_VOICE_PIPECAT_BASE_URL:-http://127.0.0.1:18084}"
export ONELINK_AI_VOICE_PIPECAT_INTERNAL_TOKEN="${ONELINK_AI_VOICE_PIPECAT_INTERNAL_TOKEN:-${ONELINK_AI_VOICE_INTERNAL_TOKEN:-}}"

guard_dev_environment() {
  if [[ "${RAILS_ENV:-development}" == "production" || "${NODE_ENV:-development}" == "production" ]]; then
    printf 'Refusing to start dev-hybrid with production environment variables.\n' >&2
    exit 1
  fi

  if [[ "${POSTGRES_DATABASE:-chatwoot_dev}" != "chatwoot_dev" ]]; then
    printf 'Refusing to start dev-hybrid with non-dev database: %s\n' "${POSTGRES_DATABASE:-unset}" >&2
    exit 1
  fi

  if [[ "${REDIS_URL:-}" =~ /0($|[?]) ]]; then
    printf 'Refusing to start dev-hybrid with Redis DB 0. Use a dev Redis DB such as /3.\n' >&2
    exit 1
  fi
}

guard_dev_environment

ensure_dev_sidekiq_db_pool() {
  local required_pool=1
  local value
  local variable

  for variable in \
    SIDEKIQ_CONCURRENCY \
    CAPTAIN_RUNTIME_SIDEKIQ_CONCURRENCY \
    OUTBOUND_MESSAGES_SIDEKIQ_CONCURRENCY \
    REMINDERS_SIDEKIQ_CONCURRENCY \
    TELEPHONY_REALTIME_SIDEKIQ_CONCURRENCY \
    AUDIO_TRANSCRIPTION_SIDEKIQ_CONCURRENCY \
    WHATSAPP_CALLS_SIDEKIQ_CONCURRENCY \
    WHATSAPP_WEBHOOK_FORWARD_SIDEKIQ_CONCURRENCY \
    TELEGRAM_INBOUND_SIDEKIQ_CONCURRENCY \
    TELEGRAM_PERSONAL_INBOUND_SIDEKIQ_CONCURRENCY \
    TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY \
    WHATSAPPWEB_INBOUND_SIDEKIQ_CONCURRENCY \
    WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY \
    WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY; do
    value="${!variable:-}"
    [[ "${value}" =~ ^[0-9]+$ ]] || continue
    (( value > required_pool )) && required_pool="${value}"
  done

  value="${SIDEKIQ_DB_POOL:-}"
  if ! [[ "${value}" =~ ^[0-9]+$ ]] || (( value < required_pool )); then
    export SIDEKIQ_DB_POOL="${required_pool}"
  fi
}

ensure_dev_sidekiq_db_pool
setup_dev_hybrid_logging
cd "${APP_DIR}"

if [[ "${DEV_HYBRID_PRESERVE_DEBUG}" != "1" ]]; then
  unset DEBUG
fi

ensure_dev_proxy_config() {
  if [[ "${DEV_PROXY_GUARD:-1}" != "1" ]]; then
    return 0
  fi

  "${APP_DIR}/bin/dev-proxy-check" --strict
}

configure_test_environment() {
  export RAILS_ENV=test
  export NODE_ENV=test
  export POSTGRES_DATABASE="${DEV_HYBRID_TEST_DATABASE:-${POSTGRES_TEST_DATABASE:-chatwoot_test}}"

  if [[ "${POSTGRES_DATABASE}" == "chatwoot_dev" || "${POSTGRES_DATABASE}" == "chatwoot_production" ]]; then
    printf 'Refusing to run tests against non-test database: %s\n' "${POSTGRES_DATABASE}" >&2
    exit 1
  fi

  if [[ -n "${TEST_REDIS_URL:-}" ]]; then
    export REDIS_URL="${TEST_REDIS_URL}"
  elif [[ -n "${REDIS_URL:-}" ]]; then
    export REDIS_URL="$(ruby -ruri -e 'uri = URI(ENV.fetch("REDIS_URL")); uri.path = "/#{ENV.fetch("TEST_REDIS_DB", "4")}"; puts uri')"
  fi
}

case "${COMMAND}" in
  prepare)
    exec bundle exec rails db:prepare
    ;;
  prepare-test)
    configure_test_environment
    exec bundle exec rails db:prepare
    ;;
  start)
    ensure_dev_proxy_config

    if command -v overmind >/dev/null 2>&1; then
      exec overmind start -f "${PROCFILE_PATH}"
    fi

    exec foreman start -f "${PROCFILE_PATH}"
    ;;
  start-foreman)
    ensure_dev_proxy_config
    exec foreman start -f "${PROCFILE_PATH}"
    ;;
  rails)
    shift
    exec bin/rails "$@"
    ;;
  rails-test)
    shift
    configure_test_environment
    exec bin/rails "$@"
    ;;
  rspec)
    shift
    configure_test_environment
    exec bundle exec rspec "$@"
    ;;
  vite)
    ensure_dev_proxy_config
    exec env VITE_RUBY_CONFIG_PATH="${VITE_RUBY_CONFIG_PATH:-config/vite.hybrid.json}" ./node_modules/.bin/vite build --watch --config vite.config.mts
    ;;
  *)
    usage
    exit 1
    ;;
esac
