<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <p class="mb-4 mt-0 text-xs text-n-slate-11">
    <%= t('super_admin.limits.form_hint') %>
  </p>

  <%# The meters are in the rows. What the operator typed is drawn again when the form comes back with a problem (@limit_form). %>
  <%= render 'super_admin/accounts/limit_rows', rows: field.rows(state: @limit_form&.state, problems: @limit_form&.problems) %>
</div>
