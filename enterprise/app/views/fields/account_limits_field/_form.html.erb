<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <p class="text-xs text-gray-500 mb-4">
    Leave a field blank to inherit the global or plan value. Use <code>0</code> to block that capability for the account.
  </p>

  <div class="space-y-4">
    <% field.rows.each do |row| %>
      <div>
        <label class="block font-medium mb-1" for="<%= row[:input_id] %>"><%= row[:label] %></label>
        <%= number_field_tag "account[limits][#{row[:key]}]", row[:value], id: row[:input_id], min: 0, step: row[:step] || 1, class: "w-full" %>
        <p class="mt-1 text-xs text-gray-500"><%= row[:hint] %></p>
        <% if row[:bytes] && row[:value].present? %>
          <p class="mt-1 text-xs text-gray-500">Current override: <%= number_with_precision(row[:value], precision: 2, strip_insignificant_zeros: true) %> GB</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
