<%
  format_value = lambda do |row|
    next t('super_admin.limits.default') if row[:value].nil?

    if row[:bytes]
      "#{number_with_precision(row[:value], precision: 2, strip_insignificant_zeros: true, separator: ',')} ГБ"
    else
      super_admin_number(row[:value])
    end
  end
%>

<div class="flex flex-col gap-3">
  <p class="m-0 text-xs text-n-slate-11"><%= t('super_admin.limits.show_hint_html') %></p>

  <% field.rows.each do |row| %>
    <div class="rounded-lg p-3 outline outline-1 outline-n-container">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="font-medium text-n-slate-12"><%= row[:label] %></div>
          <div class="mt-1 text-xs text-n-slate-11"><%= row[:hint] %></div>
        </div>
        <div class="text-end text-sm font-medium text-n-slate-12"><%= format_value.call(row) %></div>
      </div>
    </div>
  <% end %>
</div>
