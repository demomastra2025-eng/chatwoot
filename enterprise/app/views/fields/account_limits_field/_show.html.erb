<%
  settings = Accounts::LimitSettings.new(field.resource)
%>

<ul class="m-0 flex list-none flex-col gap-2 p-0">
  <% Accounts::Plans::LIMIT_KEYS.each do |key| %>
    <li class="flex items-start justify-between gap-4 rounded-lg p-3 outline outline-1 outline-n-container">
      <span class="font-medium text-n-slate-12"><%= t("super_admin.limits.#{key}.label") %></span>
      <span class="text-end text-sm text-n-slate-12">
        <%= t("super_admin.limits.choices.#{settings.source(key)}") %>:
        <%= SuperAdmin::LimitWords.amount(key, settings.effective(key)) %>
      </span>
    </li>
  <% end %>
</ul>
