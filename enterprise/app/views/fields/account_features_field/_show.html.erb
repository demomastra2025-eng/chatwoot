<%#
# Functions of a clinic

The functions that are switched on, by their Russian names. The clinic card
shows the same state in its «Тонкая настройка» block.
%>
<% enabled = field.data.to_h.select { |_name, on| on }.keys %>

<% if enabled.any? %>
  <div class="flex flex-wrap gap-1.5">
    <% enabled.map { |name| SuperAdmin::AccountFeaturesHelper.feature_label(name) }.sort.each do |label| %>
      <span class="admin-badge"><%= label %></span>
    <% end %>
  </div>
<% else %>
  <span class="text-xs italic text-n-slate-10"><%= t('super_admin.fine_tuning.none_enabled') %></span>
<% end %>
