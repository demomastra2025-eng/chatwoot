<%#
# Functions of a clinic on the edit form

The grouped «Тонкая настройка» switches replace the raw list of every flag. The
switches post `enabled_features[feature_<flag>]` with the rest of the form.
%>
<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <p class="mb-4 mt-0 text-xs text-n-slate-11"><%= t('super_admin.fine_tuning.hint') %></p>
  <%= render 'super_admin/accounts/fine_tuning', account: f.object, columns: 2 %>
</div>
