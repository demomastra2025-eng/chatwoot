<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <%= render "fields/account_usage_field/show", field: field %>
  <p class="mt-3 text-xs text-gray-500">
    Usage is read-only here.
    <% if f.object.persisted? %>
      Resettable counters can be managed from the <%= link_to 'account show page', [:super_admin, f.object] %>.
    <% else %>
      Resettable counters become available on the account show page after the account is created.
    <% end %>
  </p>
</div>
