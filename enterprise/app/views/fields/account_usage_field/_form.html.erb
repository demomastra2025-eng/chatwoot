<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <%= render "fields/account_usage_field/show", field: field %>
  <p class="mt-3 text-xs text-n-slate-11">
    <% if f.object.persisted? %>
      <%= t('super_admin.limits.form_note_html', link: link_to(t('super_admin.limits.card_link'), [:super_admin, f.object])) %>
    <% else %>
      <%= t('super_admin.limits.form_note_new') %>
    <% end %>
  </p>
</div>
