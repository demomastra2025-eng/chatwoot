{% render 'communication_thread', communication_thread: communication_thread %}
{% endif -%}

{% if contact -%}
{% render 'contact', contact: contact, contact_visible_fields: contact_visible_fields, contact_custom_attribute_labels: contact_custom_attribute_labels %}
{% endif -%}

{% if deal -%}
{% render 'deal', deal: deal, deal_visible_fields: deal_visible_fields, deal_custom_attribute_labels: deal_custom_attribute_labels %}
{% endif -%}

{% if task -%}
{% render 'task', task: task, task_visible_fields: task_visible_fields, task_custom_attribute_labels: task_custom_attribute_labels %}
{% endif -%}

{% if appointment -%}
{% render 'appointment', appointment: appointment, appointment_visible_fields: appointment_visible_fields, appointment_custom_attribute_labels: appointment_custom_attribute_labels %}
{% endif -%}

{% if campaign != blank -%}
{% render 'campaign', campaign: campaign %}
{% endif -%}
{% endif -%}

