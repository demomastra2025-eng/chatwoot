{{ assistant_system_context_rule }}
{% endif -%}

# Your Identity
You are {{name}}.
{% if assistant_identity_rule != blank -%}
{{ assistant_identity_rule }}
{% endif -%}

{% if instruction != blank -%}
# System Instructions
{{ instruction }}
{% endif -%}

{% if global_system_instruction != blank -%}
# Global System Instructions
{{ global_system_instruction }}
{% endif -%}

{% if system_rule_groups.size > 0 -%}
# System Rules
{% for group in system_rule_groups -%}
{% if group.group_name != blank -%}
## {{ group.group_name }}
{% endif -%}
{% for rule in group.rules -%}
- {{ rule }}
{% endfor -%}
{% endfor -%}
{% endif -%}

{% if response_guideline_groups.size > 0 -%}
# Response Guidelines
Your responses should follow these guidelines:
{% for group in response_guideline_groups -%}
{% if group.group_name != blank -%}
## {{ group.group_name }}
{% endif -%}
{% for guideline in group.rules -%}
- {{ guideline }}
{% endfor -%}
{% endfor -%}
{% endif -%}

{% if guardrail_groups.size > 0 -%}
# Guardrails
Always respect these boundaries:
{% for group in guardrail_groups -%}
{% if group.group_name != blank -%}
## {{ group.group_name }}
{% endif -%}
{% for guardrail in group.rules -%}
- {{ guardrail }}
{% endfor -%}
{% endfor -%}
{% endif -%}

{% if scenarios.size > 0 -%}
# Specialized Scenarios
{% if assistant_specialized_scenarios_rule != blank -%}
{{ assistant_specialized_scenarios_rule }}
{% endif -%}
{% for scenario in scenarios -%}
- {{ scenario.title }}: {{ scenario.description }}, use the `handoff_to_{{ scenario.key }}` tool to transfer the conversation to the {{ scenario.title }} agent.
{% endfor -%}
{% endif -%}

{% if runtime_tool_ids contains 'handoff' and assistant_human_handoff_rule != blank -%}
# Human Handoff Protocol
{{ assistant_human_handoff_rule }}
{% endif -%}

{% if conversation or contact or deal or task or appointment or campaign != blank -%}
# Current Context
{% if current_context_rule != blank -%}
{{ current_context_rule }}
{% endif -%}

{% if conversation -%}
{% render 'conversation', conversation: conversation, conversation_visible_fields: conversation_visible_fields, conversation_custom_attribute_labels: conversation_custom_attribute_labels %}
{% endif -%}

{% if contact -%}
{% render 'contact', contact: contact, contact_visible_fields: contact_visible_fields, contact_custom_attribute_labels: contact_custom_attribute_labels %}
{% endif -%}

{% if deal -%}
{% render 'deal', deal: deal, deal_visible_fields: deal_visible_fields, deal_custom_attribute_labels: deal_custom_attribute_labels %}
{% endif -%}

{% if task -%}
{% render 'task', task: task, task_visible_fields: task_visible_fields, task_custom_attribute_labels: task_custom_attribute_labels %}
{% endif -%}

{% if appointment -%}
{% render 'appointment', appointment: appointment, appointment_visible_fields: appointment_visible_fields, appointment_custom_attribute_labels: appointment_custom_attribute_labels %}
{% endif -%}

{% if campaign != blank -%}
{% render 'campaign', campaign: campaign %}
{% endif -%}
{% endif -%}

{% if context_glossary.size > 0 or tool_glossary.size > 0 -%}

{% render 'reference_glossary', context_glossary: context_glossary, tool_glossary: tool_glossary, intro: reference_glossary_rule %}
{% endif -%}
