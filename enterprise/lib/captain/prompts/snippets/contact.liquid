# Contact Information
{% if contact_visible_fields contains 'id' -%}
- Contact ID: {{ contact.id }}
{% endif -%}
{% if contact_visible_fields contains 'name' -%}
- Name: {{ contact.name | default: "Unknown" }}
{% endif -%}
{% if contact_visible_fields contains 'email' -%}
- Email: {{ contact.email | default: "None" }}
{% endif -%}
{% if contact_visible_fields contains 'phone_number' -%}
- Phone: {{ contact.phone_number | default: "None" }}
{% endif -%}
{% if contact_visible_fields contains 'identifier' -%}
- Identifier: {{ contact.identifier | default: "None" }}
{% endif -%}
{% if contact_visible_fields contains 'contact_type' -%}
- Type: {{ contact.contact_type | default: "visitor" }}
{% endif -%}
{% if contact.custom_attributes -%}
  {% for attribute in contact.custom_attributes -%}
  {% assign attribute_key = attribute[0] | append: '' -%}
  {% assign attribute_label = contact_custom_attribute_labels[attribute_key] | default: attribute[0] -%}
- {{ attribute_label }} ({{ attribute[0] }}): {{ attribute[1] }}
  {% endfor -%}
{% endif -%}
{% if contact.additional_attributes -%}
  {% for attribute in contact.additional_attributes -%}
- {{ attribute[0] }}: {{ attribute[1] }}
  {% endfor -%}
{% endif -%}
