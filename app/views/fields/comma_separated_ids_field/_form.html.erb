<div class="field-unit field-unit--text">
  <%= f.label field.attribute,
              field.options.fetch(:label, field.attribute.to_s.humanize),
              class: "field-unit__label" %>
  <div class="field-unit__field">
    <%= f.text_area field.attribute,
                    value: field.to_s,
                    rows: 3,
                    placeholder: "12, 34, 56" %>
    <p class="text-xs text-gray-500 mt-2">
      Comma, space, or newline separated user IDs. These users will be excluded from workspace limit counters.
    </p>
  </div>
</div>
