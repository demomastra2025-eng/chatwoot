<%#
# Logs

The Grafana dashboard of the logs for the last 24 hours, embedded, with the
ways to the monitoring, the alerts, the queues and Grafana itself.
%>
<% content_for(:title) do %><%= t('super_admin.logs.title') %><% end %>

<%
  dashboard_url = '/monitoring/grafana/d/crafty-production-logs/crafty-production-logs?orgId=1&from=now-24h&to=now&refresh=10s'
  external = { target: '_blank', rel: 'noopener noreferrer' }
%>

<%= render layout: 'super_admin/shared/page_header', locals: { title: content_for(:title), description: t('super_admin.logs.description') } do %>
  <%= link_to t('super_admin.logs.monitoring'), super_admin_monitoring_path, class: 'button button--secondary' %>
  <%= link_to t('super_admin.logs.alerts'), '/monitoring/grafana/alerting/list', class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.logs.queues'), sidekiq_web_url, class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.logs.explore'), '/monitoring/grafana/explore', class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.logs.open_dashboard'), dashboard_url, class: 'button', **external %>
<% end %>

<%= render 'super_admin/shared/grafana_embed',
           hint: t('super_admin.logs.hint'),
           embed_url: "#{dashboard_url}&kiosk=tv",
           frame_title: t('super_admin.logs.frame_title') %>
