<%#
# AI analytics

What the AI agents of all clinics did in the period: key figures, the clinics with
the most activity and the spread by function, model and provider. Everything is
in Russian, times are Astana time, amounts are US dollars.

## Local variables (controller instance variables):

- `@fleet_report`: the snapshot, the top clinics and the date range
  (Llm::Monitoring::FleetSnapshot).
%>
<% content_for(:title) do %><%= t('super_admin.ai_analytics.title') %><% end %>

<%
  snapshot = @fleet_report[:snapshot] || {}
  top_accounts = Array(@fleet_report[:top_accounts])
  fleet_range = @fleet_report[:date_range]
  none = t('super_admin.ai_analytics.none')
  no_data = t('super_admin.ai_analytics.no_data')
  spread = {
    features: snapshot.fetch(:by_feature, {}),
    models: snapshot.fetch(:by_model, {}),
    providers: snapshot.fetch(:by_provider, {})
  }
%>

<%= render layout: 'super_admin/shared/page_header', locals: { title: content_for(:title), description: t('super_admin.ai_analytics.description') } do %>
  <%= link_to t('super_admin.ai_analytics.monitoring'), super_admin_monitoring_path, class: 'button button--secondary' %>
  <%= link_to t('super_admin.ai_analytics.logs'), super_admin_logs_path, class: 'button button--secondary' %>
<% end %>

<section class="main-content__body flex flex-col gap-5">
  <% if fleet_range.present? %>
    <p class="m-0 text-xs text-n-slate-11" data-testid="ai-range">
      <%= t('super_admin.ai_analytics.range', from: super_admin_time(fleet_range.begin), to: super_admin_time(fleet_range.end)) %>
    </p>
  <% end %>

  <%= render 'super_admin/shared/stat_group', items: [
    { label: t('super_admin.ai_analytics.stats.events'), value: super_admin_number(snapshot[:total_events].to_i) },
    { label: t('super_admin.ai_analytics.stats.requests'), value: super_admin_number(snapshot[:request_count].to_i) },
    { label: t('super_admin.ai_analytics.stats.errors'), value: super_admin_number(snapshot[:error_count].to_i), tone: (:bad if snapshot[:error_count].to_i.positive?) },
    { label: t('super_admin.ai_analytics.stats.cost'), value: super_admin_usd(snapshot[:total_estimated_cost].to_f) }
  ] %>

  <div class="grid items-start gap-5 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
    <section class="admin-block" aria-labelledby="ai-top-title">
      <div class="admin-block__head">
        <h2 class="admin-block__title" id="ai-top-title"><%= t('super_admin.ai_analytics.top.title') %></h2>
        <p class="admin-block__hint"><%= t('super_admin.ai_analytics.top.hint') %></p>
      </div>

      <% if top_accounts.any? %>
        <div class="-mx-5 overflow-x-auto" data-testid="ai-top">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-n-weak text-xs font-medium text-n-slate-11">
                <th scope="col" class="px-3 py-2.5 first:ps-5"><%= t('super_admin.ai_analytics.top.clinic') %></th>
                <th scope="col" class="px-3 py-2.5 text-end"><%= t('super_admin.ai_analytics.top.events') %></th>
                <th scope="col" class="px-3 py-2.5 text-end"><%= t('super_admin.ai_analytics.top.requests') %></th>
                <th scope="col" class="px-3 py-2.5 text-end"><%= t('super_admin.ai_analytics.top.errors') %></th>
                <th scope="col" class="px-3 py-2.5 text-end"><%= t('super_admin.ai_analytics.top.cost') %></th>
                <th scope="col" class="whitespace-nowrap px-3 py-2.5 last:pe-5"><%= t('super_admin.ai_analytics.top.last_event') %></th>
              </tr>
            </thead>
            <tbody>
              <% top_accounts.each do |row| %>
                <tr class="border-b border-n-weak last:border-b-0">
                  <td class="px-3 py-3 first:ps-5">
                    <div class="font-medium text-n-slate-12"><%= row[:account_name] %></div>
                    <% if row[:account_id].present? %>
                      <div class="text-xs text-n-slate-11"><%= t('super_admin.ai_analytics.top.clinic_number', id: row[:account_id]) %></div>
                    <% end %>
                  </td>
                  <td class="px-3 py-3 text-end tabular-nums"><%= super_admin_number(row[:total_events]) %></td>
                  <td class="px-3 py-3 text-end tabular-nums"><%= super_admin_number(row[:request_count]) %></td>
                  <td class="px-3 py-3 text-end tabular-nums <%= row[:error_count].to_i.positive? ? 'text-n-ruby-11' : '' %>"><%= super_admin_number(row[:error_count]) %></td>
                  <td class="px-3 py-3 text-end tabular-nums"><%= super_admin_usd(row[:estimated_cost].to_f) %></td>
                  <td class="whitespace-nowrap px-3 py-3 text-n-slate-11 last:pe-5"><%= super_admin_time(row[:last_event_at]) || no_data %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="admin-notice" data-testid="ai-top-empty"><%= t('super_admin.ai_analytics.top.empty') %></div>
      <% end %>
    </section>

    <div class="flex min-w-0 flex-col gap-5">
      <section class="admin-block" aria-labelledby="ai-spread-title">
        <h2 class="admin-block__title" id="ai-spread-title"><%= t('super_admin.ai_analytics.spread.title') %></h2>
        <% spread.each do |kind, counts| %>
          <div class="flex flex-col gap-2" data-testid="ai-spread-<%= kind %>">
            <h3 class="m-0 text-xs font-medium text-n-slate-11"><%= t("super_admin.ai_analytics.spread.#{kind}") %></h3>
            <div class="admin-chips">
              <% counts.sort_by { |(_, count)| -count.to_i }.first(6).each do |name, count| %>
                <span class="admin-chip"><%= "#{name.presence || none} (#{super_admin_number(count)})" %></span>
              <% end %>
              <% if counts.blank? %>
                <span class="text-sm text-n-slate-11"><%= no_data %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>

      <section class="admin-block" aria-labelledby="ai-baseline-title">
        <h2 class="admin-block__title" id="ai-baseline-title"><%= t('super_admin.ai_analytics.baseline.title') %></h2>
        <dl class="admin-kv">
          <div class="admin-kv__row">
            <dt class="admin-kv__key"><%= t('super_admin.ai_analytics.baseline.blocked') %></dt>
            <dd class="admin-kv__value tabular-nums"><%= super_admin_number(snapshot[:blocked_count].to_i) %></dd>
          </div>
          <div class="admin-kv__row">
            <dt class="admin-kv__key"><%= t('super_admin.ai_analytics.baseline.schema_invalid') %></dt>
            <dd class="admin-kv__value tabular-nums"><%= super_admin_number(snapshot[:schema_invalid_count].to_i) %></dd>
          </div>
          <div class="admin-kv__row">
            <dt class="admin-kv__key"><%= t('super_admin.ai_analytics.baseline.tool_failures') %></dt>
            <dd class="admin-kv__value tabular-nums"><%= super_admin_number(snapshot[:tool_failure_count].to_i) %></dd>
          </div>
          <div class="admin-kv__row">
            <dt class="admin-kv__key"><%= t('super_admin.ai_analytics.baseline.last_event') %></dt>
            <dd class="admin-kv__value"><%= super_admin_time(snapshot[:last_event_at]) || no_data %></dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</section>
