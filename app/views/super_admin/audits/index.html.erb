<%#
# Audit log

Who changed what and when: the changes of the platform settings, channels, clinic
plans, users and configuration, newest first. A filter by the kind of object, the
action and the clinic; every entry opens the list of the fields it changed. Times
are Astana time.

## Local variables (controller instance variables):

- `@audits`: the page of entries (Audited::Audit, 25 per page).
- `@auditable_types`: the kinds of object that have entries, for the filter.
%>
<% content_for(:title) do %><%= t('super_admin.audits.title') %><% end %>

<%
  total = @audits.respond_to?(:total_count) ? @audits.total_count : @audits.size
  actions = %w[create update destroy impersonate start_trial extend_trial expire_trial apply_plan update_channel_override
               update_channel_visibility update_service_flags remove_user cleanup_storage empty_trash link_account unlink_account
               link_organization unlink_organization] + SuperAdmin::AuditsController::SECURITY_ACTIONS
  action_badges = { 'create' => 'admin-badge--teal', 'update' => 'admin-badge--blue', 'destroy' => 'admin-badge--ruby' }
%>

<%= render layout: 'super_admin/shared/page_header', locals: { title: content_for(:title), description: t('super_admin.audits.description') } do %>
  <span class="admin-badge admin-badge--quiet tabular-nums" data-testid="audits-total"><%= t('super_admin.audits.total', count: super_admin_number(total)) %></span>
<% end %>

<section class="main-content__body">
  <%= form_with url: super_admin_audits_path, method: :get, local: true, class: 'collection-toolbar !items-end' do |f| %>
    <div class="flex w-full flex-wrap items-end gap-3 sm:w-auto">
      <div class="flex w-full flex-col gap-1.5 sm:w-52">
        <%= label_tag :auditable_type, t('super_admin.audits.entity_type'), class: 'text-xs text-n-slate-11' %>
        <%= f.select :auditable_type,
                     options_for_select([[t('super_admin.audits.all_types'), '']] + @auditable_types.map { |type| [t("super_admin.audits.types.#{type.underscore}", default: type), type] }, params[:auditable_type]),
                     {} %>
      </div>

      <div class="flex w-full flex-col gap-1.5 sm:w-64">
        <%= label_tag :audit_action, t('super_admin.audits.action'), class: 'text-xs text-n-slate-11' %>
        <%= f.select :audit_action,
                     options_for_select([[t('super_admin.audits.all_actions'), '']] + actions.map { |action| [t("super_admin.audits.actions.#{action}", default: action), action] }, params[:audit_action]),
                     {} %>
      </div>

      <div class="flex w-full flex-col gap-1.5 sm:w-36">
        <%= label_tag :account_id, t('super_admin.audits.account_id'), class: 'text-xs text-n-slate-11' %>
        <%= f.number_field :account_id, value: params[:account_id], placeholder: t('super_admin.audits.account_id_placeholder') %>
      </div>

      <div class="flex gap-2">
        <%= f.submit t('super_admin.audits.apply') %>
        <%= link_to t('super_admin.audits.reset'), super_admin_audits_path, class: 'button button--secondary' %>
      </div>
    </div>
  <% end %>

  <div class="admin-card admin-card--table">
    <table aria-labelledby="page-title">
      <thead>
        <tr>
          <th scope="col"><%= t('super_admin.audits.columns.date_time') %></th>
          <th scope="col"><%= t('super_admin.audits.columns.user') %></th>
          <th scope="col"><%= t('super_admin.audits.columns.object') %></th>
          <th scope="col"><%= t('super_admin.audits.columns.action') %></th>
          <th scope="col"><%= t('super_admin.audits.columns.changes') %></th>
        </tr>
      </thead>
      <tbody>
        <% if @audits.empty? %>
          <tr>
            <td colspan="5" class="py-10 text-center text-n-slate-11"><%= t('super_admin.audits.empty') %></td>
          </tr>
        <% end %>
        <% @audits.each do |audit| %>
          <tr>
            <td class="whitespace-nowrap tabular-nums text-n-slate-11">
              <%= super_admin_time(audit.created_at, '%d.%m.%Y %H:%M:%S') %>
            </td>
            <td>
              <% if audit.user_type == 'PlatformApp' %>
                <%# A partner access of the Platform API: named as a partner, so nobody takes it for a person %>
                <span class="font-medium"><%= t('super_admin.audits.partner', name: audit.user.try(:name) || "№#{audit.user_id}") %></span>
              <% elsif audit.user.respond_to?(:name) %>
                <span class="font-medium"><%= audit.user.name %></span>
              <% elsif audit.user_id.present? %>
                <span class="font-medium"><%= t('super_admin.audits.user_id', id: audit.user_id) %></span>
              <% elsif audit.username.present? %>
                <span class="font-medium"><%= audit.username %></span>
              <% else %>
                <span class="text-n-slate-11"><%= t('super_admin.audits.system') %></span>
              <% end %>
            </td>
            <td class="whitespace-nowrap">
              <% if audit.auditable_type.present? %>
                <span class="font-medium"><%= t("super_admin.audits.types.#{audit.auditable_type.to_s.underscore}", default: audit.auditable_type.to_s) %></span>
                <span class="text-n-slate-11 tabular-nums">#<%= audit.auditable_id %></span>
              <% else %>
                <%# An attempt to sign in as an e-mail nobody has: there is no object %>
                <span class="text-n-slate-11">—</span>
              <% end %>
            </td>
            <td>
              <span class="admin-badge <%= action_badges[audit.action] %>">
                <%= t("super_admin.audits.actions.#{audit.action}", default: audit.action) %>
              </span>
            </td>
            <td class="min-w-[14rem]">
              <details>
                <summary class="cursor-pointer text-n-brand hover:underline"><%= t('super_admin.audits.changes_summary', count: (audit.audited_changes || {}).keys.size) %></summary>
                <pre class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap rounded-lg bg-n-slate-3 p-2 font-mono text-[11px] text-n-slate-12"><%= JSON.pretty_generate(audit.audited_changes) rescue audit.audited_changes.inspect %></pre>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @audits.respond_to?(:total_pages) && @audits.total_pages > 1 %>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-n-slate-11">
      <div><%= t('super_admin.audits.page', current: @audits.current_page, total: @audits.total_pages) %></div>
      <%= paginate @audits %>
    </div>
  <% end %>
</section>
