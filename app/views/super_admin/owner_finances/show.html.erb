<% content_for(:title) { 'Финансы, сроки и инфраструктура' } %>
<%
  manifest_path = Rails.root.join('public/vite/.vite/manifest.json')
  manifest = File.exist?(manifest_path) ? JSON.parse(File.read(manifest_path)) : {}
  page_entry = manifest['dashboard/routes/dashboard/ownerFinance/pages/OwnerFinancePage.vue'] || {}
  imports_map = Array(page_entry['imports']).each_with_object({}) { |k, h| h[k.sub(/-[^-]+\.js\z/, '')] = k }
  page_js = page_entry['file'] ? "/vite/#{page_entry['file']}" : nil
  vue_js = imports_map['_vue.esm-bundler'] ? "/vite/#{manifest.dig(imports_map['_vue.esm-bundler'], 'file')}" : nil
  i18n_js = imports_map['_vue-i18n'] ? "/vite/#{manifest.dig(imports_map['_vue-i18n'], 'file')}" : nil
  global_js = imports_map['_globalConfig'] ? "/vite/#{manifest.dig(imports_map['_globalConfig'], 'file')}" : nil
  extra_css = Array(page_entry['imports']).flat_map { |k| Array(manifest.dig(k, 'css')) }.uniq.map { |c| "/vite/#{c}" }
%>
<% content_for(:vue_entry) do %>
  <% extra_css.each do |css_href| %>
    <link rel="stylesheet" href="<%= css_href %>">
  <% end %>
  <style>
    .ceo-cockpit-wrap {
      font-variant-numeric: tabular-nums;
      padding: 20px 24px 4px 24px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }
    .ceo-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .ceo-section-title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #334155;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ceo-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
    }
    .ceo-badge-ok { background: #dcfce7; color: #166534; }
    .ceo-badge-warn { background: #fef3c7; color: #92400e; }
    .ceo-badge-crit { background: #fee2e2; color: #991b1b; }
    .ceo-badge-neutral { background: #e2e8f0; color: #334155; }
    .ceo-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 18px;
    }
    @media (max-width: 1280px) {
      .ceo-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 680px) {
      .ceo-grid-4 { grid-template-columns: 1fr; }
    }
    .ceo-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: border-color 160ms ease-out, box-shadow 160ms ease-out;
    }
    .ceo-card:hover {
      border-color: #cbd5e1;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    }
    .ceo-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }
    .ceo-card-label {
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
    }
    .ceo-card-metric {
      font-size: 24px;
      font-weight: 700;
      color: #0f172a;
      line-height: 1.15;
      letter-spacing: -0.02em;
    }
    .ceo-card-sub {
      font-size: 12px;
      color: #475569;
      margin-top: 4px;
    }
    .ceo-chart-box {
      height: 64px;
      width: 100%;
      margin: 10px 0 6px 0;
      position: relative;
    }
    .ceo-kv-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #f1f5f9;
      font-size: 12px;
    }
    .ceo-kv-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      color: #334155;
    }
    .ceo-kv-val {
      font-weight: 600;
      color: #0f172a;
    }
    .ceo-progress-track {
      width: 100%;
      height: 6px;
      background: #f1f5f9;
      border-radius: 999px;
      overflow: hidden;
      margin-top: 6px;
    }
    .ceo-progress-bar {
      height: 100%;
      border-radius: 999px;
      transition: width 220ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .ceo-capsule-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 8px;
    }
    .ceo-capsule-pill {
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 6px;
      background: #f1f5f9;
      color: #334155;
      font-weight: 500;
    }
    .ceo-capsule-pill.active {
      background: #dbeafe;
      color: #1e40af;
      font-weight: 600;
    }
  </style>
<% end %>

