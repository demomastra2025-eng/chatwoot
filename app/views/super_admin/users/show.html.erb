<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<header class="main-content__header" role="banner">
  <div class="main-content__heading">
    <h1 class="main-content__page-title">
      <%= content_for(:title) %>
    </h1>
  </div>

  <div class="main-content__actions">
    <%# The second factor of a person who lost the phone: asks first, never for your own sign-in (SuperAdmin::UsersController#reset_two_factor) %>
    <% if page.resource.mfa_enabled? && page.resource.id != current_super_admin.id %>
      <%= render 'super_admin/shared/confirm_action', key: 'reset-two-factor', label: t('super_admin.safety.two_factor.reset'), floating: true,
                 title: t('super_admin.safety.two_factor.title', name: page.resource.name),
                 text: [t('super_admin.safety.two_factor.text'), t('super_admin.safety.audited')],
                 url: reset_two_factor_super_admin_user_path(page.resource), submit: t('super_admin.safety.two_factor.submit'),
                 trigger_class: 'button button--secondary' %>
    <% end %>
    <%= link_to(
            t("administrate.actions.edit"),
            [:edit, namespace,  page.resource.becomes(User)],
            class: "button",
          ) if authorized_action? page.resource, :edit %>
  </div>
</header>

<%
  # What only a developer reads (the number, the date of the last change, the token) is folded away; an empty row is not drawn.
  developer_attributes = %w[id updated_at access_token]
  groups = page.attributes.map do |title, attributes|
    shown = attributes.reject do |attribute|
      developer_attributes.include?(attribute.name.to_s) || (attribute.name.to_s == 'unconfirmed_email' && attribute.data.blank?)
    end
    [title, shown]
  end
  developer = page.attributes.flat_map { |_title, attributes| attributes }.select { |attribute| developer_attributes.include?(attribute.name.to_s) }
%>
<section class="main-content__body">
  <div class="flex flex-col gap-5">
    <% groups.each_with_index do |(title, attributes), index| %>
      <section class="admin-card">
        <% if title.present? %>
          <h2 class="admin-card__title"><%= t "helpers.label.#{page.resource_name}.#{title}", default: title %></h2>
        <% end %>

        <dl class="attribute-list">
          <% attributes.each do |attribute| %>
            <dt class="attribute-label" id="<%= attribute.name %>">
              <%= t(
                "helpers.label.#{resource_name}.#{attribute.name}",
                default: page.resource.class.human_attribute_name(attribute.name),
              ) %>
            </dt>

            <dd class="attribute-data attribute-data--<%=attribute.html_class%>"
                ><%= render_field attribute, page: page %></dd>
          <% end %>

          <%# Two-factor authentication closes the last group of attributes. %>
          <% if index == groups.size - 1 %>
            <dt class="attribute-label" id="mfa_enabled"><%= t('super_admin.users.two_factor') %></dt>
            <dd class="attribute-data attribute-data--string">
              <% mfa_enabled = page.resource.mfa_enabled? %>
              <span class="<%= mfa_enabled ? 'bg-n-teal-2 text-n-teal-11 outline-n-teal-4' : 'bg-n-slate-2 text-n-slate-12 outline-n-weak' %> inline-flex h-[22px] items-center rounded-md px-2 text-xs font-medium outline outline-1 -outline-offset-1">
                <%= mfa_enabled ? t('super_admin.users.two_factor_on') : t('super_admin.users.two_factor_off') %>
              </span>
            </dd>
          <% end %>
        </dl>
      </section>
    <% end %>

    <% if developer.any? %>
      <details class="admin-collapse" data-testid="developer-block">
        <summary>
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="text-heading-2 text-n-slate-12"><%= t('super_admin.developer.title') %></span>
            <span class="text-body-main text-n-slate-11"><%= t('super_admin.developer.user_hint') %></span>
          </span>
          <span class="admin-collapse__chevron i-lucide-chevron-down size-4" aria-hidden="true"></span>
        </summary>
        <div class="admin-collapse__body">
          <dl class="attribute-list">
            <% developer.each do |attribute| %>
              <dt class="attribute-label" id="<%= attribute.name %>">
                <%= t(
                  "helpers.label.#{resource_name}.#{attribute.name}",
                  default: page.resource.class.human_attribute_name(attribute.name),
                ) %>
              </dt>

              <dd class="attribute-data attribute-data--<%=attribute.html_class%>"
                  ><%= render_field attribute, page: page %></dd>
            <% end %>
          </dl>
        </div>
      </details>
    <% end %>
  </div>
</section>

<%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'user' %>

<%= render partial: "impersonate", locals: {page: page} %>

<%# The times super admins entered an account as this user: collapsed, the last 20. %>
<section class="main-content__body">
  <%= render 'super_admin/shared/impersonation_history', entries: SuperAdmin::ImpersonationHistory.for_user(page.resource), scope: :user %>
</section>
