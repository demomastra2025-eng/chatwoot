<% content_for(:title) do %>
  Monitoring
<% end %>

<header class="main-content__header" role="banner">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="main-content__page-title" id="page-title">
        <%= content_for(:title) %>
      </h1>
      <p class="text-sm text-slate-700 mt-2">
        Grafana already has Loki logs and Prometheus metrics connected for this production stack.
      </p>
    </div>

    <%= link_to 'Open Grafana in a new tab', '/monitoring/grafana/', target: '_blank', rel: 'noopener noreferrer', class: 'inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800' %>
  </div>
</header>

<section class="main-content__body">
  <div class="rounded-lg border border-slate-200 bg-white overflow-hidden">
    <iframe
      src="/monitoring/grafana/"
      title="Grafana Monitoring"
      class="w-full min-h-[85vh] bg-white"
      loading="lazy"
      referrerpolicy="same-origin"
    ></iframe>
  </div>
</section>
