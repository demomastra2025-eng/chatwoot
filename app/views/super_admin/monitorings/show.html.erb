<%#
# Monitoring

One page, four tabs (links, the current one marked with `aria-current`): the metrics and the logs of the platform
(Grafana, embedded), the background queues (Sidekiq) and the state of the server. Only the tab in use is drawn.

## Local variables (controller instance variables):

- `@tab`: `metrics`, `logs`, `queues` or `status`.
- `@queue_stats`: SuperAdmin::QueueStats::Result for the queues tab (nil: Redis cannot be read).
- `@status_sections`: the sections of the status tab (SuperAdmin::InstanceStatus#sections).
%>
<% content_for(:title) do %><%= t('super_admin.monitoring.title') %><% end %>

<%= render layout: 'super_admin/shared/page_header', locals: { title: content_for(:title), description: t('super_admin.monitoring.description') } do %><% end %>

<section class="main-content__body flex flex-col gap-5">
  <nav class="segmented self-start" aria-label="<%= t('super_admin.monitoring.tabs_label') %>" data-testid="monitoring-tabs">
    <% SuperAdmin::MonitoringsController::TABS.each do |tab| %>
      <%= link_to t("super_admin.monitoring.tabs.#{tab}"), super_admin_monitoring_path(tab: tab), class: 'segmented__item', data: { tab: tab },
                                                           aria: { current: (tab == @tab ? 'true' : nil) } %>
    <% end %>
  </nav>

  <%= render "super_admin/monitorings/#{@tab}" %>
</section>
