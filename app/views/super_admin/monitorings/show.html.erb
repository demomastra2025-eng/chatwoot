<%#
# Monitoring

The Grafana overview of production health for the last 24 hours, embedded, with
the ways to the logs, the alerts, the queues and Grafana itself.
%>
<% content_for(:title) do %><%= t('super_admin.monitoring.title') %><% end %>

<%
  dashboard_url = '/monitoring/grafana/d/crafty-production-overview/crafty-production-overview?orgId=1&from=now-24h&to=now&refresh=30s'
  external = { target: '_blank', rel: 'noopener noreferrer' }
%>

<%= render layout: 'super_admin/shared/page_header', locals: { title: content_for(:title), description: t('super_admin.monitoring.description') } do %>
  <%= link_to t('super_admin.monitoring.logs'), super_admin_logs_path, class: 'button button--secondary' %>
  <%= link_to t('super_admin.monitoring.explore'), '/monitoring/grafana/explore', class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.monitoring.alerts'), '/monitoring/grafana/alerting/list', class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.monitoring.queues'), sidekiq_web_url, class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.monitoring.grafana'), '/monitoring/grafana/', class: 'button button--secondary', **external %>
  <%= link_to t('super_admin.monitoring.open_dashboard'), dashboard_url, class: 'button', **external %>
<% end %>

<%= render 'super_admin/shared/grafana_embed',
           hint: t('super_admin.monitoring.hint'),
           embed_url: "#{dashboard_url}&kiosk=tv",
           frame_title: t('super_admin.monitoring.frame_title') %>
