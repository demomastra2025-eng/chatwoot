<%#
# Trial row inside the Passport card
%>
<%
  days = Accounts::Plans.trial_days
  trial_state = state.trial_state
  limits_key = state.trial_locks_limits? ? 'locked' : 'kept'
  remaining = state.trial_remaining
  badge = { none: ['admin-badge--quiet', t('super_admin.accounts.trial.inactive')],
            active: ['admin-badge--teal', t('super_admin.accounts.trial.active')],
            expired: ['admin-badge--amber', t('super_admin.accounts.trial.expired')] }.fetch(trial_state)
  remaining_text = if remaining.nil?
                     nil
                   elsif remaining[:days].positive?
                     t('super_admin.accounts.trial.remaining_days', days: remaining[:days], hours: remaining[:hours])
                   elsif remaining[:hours].positive?
                     t('super_admin.accounts.trial.remaining_hours', hours: remaining[:hours], minutes: remaining[:minutes])
                   else
                     t('super_admin.accounts.trial.remaining_minutes', minutes: remaining[:minutes])
                   end
%>

<div class="flex flex-col gap-2 border-t border-n-weak pt-3" data-testid="trial-block" data-trial-state="<%= trial_state %>">
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-medium text-n-slate-11" id="trial-title"><%= t('super_admin.accounts.trial.title') %></span>
    <span class="admin-badge <%= badge.first %>"><%= badge.last %></span>
  </div>

  <% if trial_state == :active %>
    <p class="m-0 text-xs text-n-slate-11">
      <%= remaining_text %> (<%= t('super_admin.accounts.trial.until') %> <%= super_admin_time(state.trial_expires_at) %>)
    </p>
    <% if state.trial_managed? %>
      <p class="admin-block__note hidden" aria-hidden="true" data-testid="trial-end-note">
        <%= t('super_admin.accounts.trial.at_end') %>
        <%= t("super_admin.accounts.trial.limits_#{limits_key}") %>
      </p>
    <% end %>
  <% elsif trial_state == :expired %>
    <p class="m-0 text-xs text-n-slate-11">
      <%= t('super_admin.accounts.trial.ended_at', time: super_admin_time(state.trial_expired_at || state.trial_expires_at) || t('super_admin.accounts.trial.unknown_time')) %>
    </p>
    <% if state.trial_limits_held? %>
      <p class="admin-block__note text-n-amber-11" data-testid="trial-limits-held"><%= t('super_admin.safety.trial.limits_held', button: state.apply_label) %></p>
    <% end %>
  <% end %>

  <% if state.trial_managed? || state.can_start_trial? %>
    <div class="flex flex-wrap gap-2">
      <% if state.trial_managed? %>
        <%= render 'super_admin/shared/confirm_action', key: 'extend-trial', label: t('super_admin.accounts.trial.extend', days: days),
                   text: [t('super_admin.accounts.trial.extend_confirm', days: days)], url: extend_trial_super_admin_account_path(account),
                   tone: :primary, submit: t('super_admin.safety.trial.extend_submit'), trigger_class: 'button button--small button--secondary' %>
        <% if trial_state == :active %>
          <%= render 'super_admin/shared/confirm_action', key: 'expire-trial', label: t('super_admin.accounts.trial.expire'),
                     text: [t("super_admin.accounts.trial.expire_confirm_#{limits_key}"), t('super_admin.safety.audited')],
                     url: expire_trial_super_admin_account_path(account), submit: t('super_admin.safety.trial.expire_submit') %>
        <% end %>
      <% else %>
        <%= render 'super_admin/shared/confirm_action', key: 'start-trial', label: t('super_admin.accounts.trial.start', days: days),
                   text: [t("super_admin.accounts.trial.start_confirm_#{limits_key}", days: days)], url: extend_trial_super_admin_account_path(account),
                   params: { start: true }, tone: :primary, submit: t('super_admin.safety.trial.start_submit'),
                   trigger_class: 'button button--small button--secondary' %>
      <% end %>
    </div>
  <% end %>
</div>
