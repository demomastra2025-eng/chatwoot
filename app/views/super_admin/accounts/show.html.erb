<%#
# Clinic card

The page of one clinic. Header: name, status, #id, creation date (Astana time),
«Войти в аккаунт», «Заблокировать» / «Разблокировать» (asks first, with a reason) and «Редактировать»; a blocked account has
a strip on top that says when, by whom and why it was blocked. Main column: plan (base + modules, with
the preview of what a change does), limits and spend, channels, «Тонкая
настройка» and «Служебные» (both collapsed), users, «Входы в аккаунт» and «Для разработчика» (all collapsed). Side column: trial,
basic facts, organization, maintenance.

## Local variables:

- `page`: an `Administrate::Page::Show`; `page.resource` is the clinic.
%>
<%
  account = page.resource
  state = SuperAdmin::AccountPlanState.new(account)
  status_tone = { active: 'admin-badge--teal', suspended: 'admin-badge--amber', deleting: 'admin-badge--ruby' }.fetch(state.status)
  target_user = account.administrators.first || account.users.first
  # An account that is being deleted is neither blocked nor unblocked: its deletion is cancelled first
  blockable = state.status != :deleting
  block = SuperAdmin::AccountBlocking.last_block(account) if blockable && account.suspended?
%>

<% content_for(:title) { account.name } %>

<header class="main-content__header" role="banner">
  <div class="main-content__heading">
    <nav aria-label="<%= t('super_admin.clinic_card.breadcrumb') %>" class="text-[13px] text-n-slate-11">
      <%= link_to t('super_admin.navigation.items.accounts'), super_admin_accounts_path, class: 'text-n-brand hover:underline' %>
      <span class="mx-1.5 text-n-slate-10" aria-hidden="true">/</span>
      <span><%= account.name %></span>
    </nav>
    <div class="flex flex-wrap items-center gap-2.5">
      <h1 class="main-content__page-title"><%= account.name %></h1>
      <span class="admin-badge <%= status_tone %>" data-testid="account-status"><%= state.status_label %></span>
    </div>
    <p class="main-content__description" data-testid="account-meta">
      <span class="tabular-nums">#<%= account.id %></span>
      · <%= t('super_admin.clinic_card.created', date: super_admin_date(account.created_at)) %>
    </p>
  </div>

  <div class="main-content__actions">
    <% if target_user.present? %>
      <%# POST on purpose: the one-time login token is only created (and audited) when the button is pressed, not on every page view. %>
      <%= button_to(t('super_admin.clinic_card.actions.enter'), [:impersonate, :super_admin, account], method: :post, form: { target: "_blank" },
                    class: "button button--secondary", title: t('super_admin.clinic_card.actions.enter_hint')) %>
    <% end %>
    <% if blockable %>
      <%# «Заблокировать» / «Разблокировать» ask first; a block asks for the reason (both optional) and is written to the audit log %>
      <% if account.suspended? %>
        <%= render 'super_admin/shared/confirm_action', key: 'unblock', label: t('super_admin.safety.block.unblock'), floating: true,
                   title: t('super_admin.safety.block.unblock_title', name: account.name),
                   text: [t('super_admin.safety.block.unblock_text'), t('super_admin.safety.audited')],
                   url: activate_super_admin_account_path(account), tone: :primary, submit: t('super_admin.safety.block.unblock_submit'),
                   trigger_class: 'button button--secondary' %>
      <% else %>
        <% reason_fields = capture do %>
          <label class="flex flex-col gap-1 text-xs text-n-slate-11" for="block-reason">
            <%= t('super_admin.safety.block.reason') %>
            <select name="reason" id="block-reason">
              <option value=""><%= t('super_admin.safety.block.no_reason') %></option>
              <% SuperAdmin::AccountBlocking::REASONS.each do |reason| %>
                <option value="<%= reason %>"><%= t("super_admin.safety.block.reasons.#{reason}") %></option>
              <% end %>
            </select>
          </label>
          <label class="flex flex-col gap-1 text-xs text-n-slate-11" for="block-note">
            <%= t('super_admin.safety.block.note') %>
            <textarea name="note" id="block-note" rows="2" maxlength="<%= SuperAdmin::AccountBlocking::NOTE_LIMIT %>"></textarea>
          </label>
        <% end %>
        <%= render 'super_admin/shared/confirm_action', key: 'block', label: t('super_admin.safety.block.block'), floating: true,
                   title: t('super_admin.safety.block.block_title', name: account.name),
                   text: [t('super_admin.safety.block.block_text'), t('super_admin.safety.audited')], fields: reason_fields,
                   url: suspend_super_admin_account_path(account), submit: t('super_admin.safety.block.block_submit'),
                   trigger_class: 'button button--alt' %>
      <% end %>
    <% end %>
  </div>
</header>

<section class="main-content__body">
  <%# A deletion that is scheduled is the first thing to see, with the way to take it back (SuperAdmin::AccountDeletion). %>
  <% deletion = SuperAdmin::AccountDeletion.new(account: account) %>
  <% if deletion.scheduled? %>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-n-ruby-2 px-4 py-3 text-sm text-n-ruby-11 outline outline-1 -outline-offset-1 outline-n-ruby-4" role="alert" data-testid="deletion-banner">
      <span><%= t('super_admin.clinic_card.deletion.banner', date: super_admin_time(deletion.deletion_at)) %></span>
      <%= render 'super_admin/shared/confirm_action', key: 'cancel-deletion', label: t('super_admin.clinic_card.deletion.cancel'),
                 text: [t('super_admin.clinic_card.deletion.cancel_confirm', name: account.name)], url: cancel_deletion_super_admin_account_path(account),
                 tone: :primary, submit: t('super_admin.safety.deletion.cancel_submit'), trigger_class: 'button button--small button--secondary' %>
    </div>
  <% end %>

  <%# A blocked account says so at the top: when, by whom, why (the entry of the audit log) and what it means. The button that takes the block off is in the header. %>
  <% if blockable && account.suspended? %>
    <div class="admin-notice admin-notice--amber mb-5 !flex-col !items-start gap-1" role="status" data-testid="block-banner">
      <span class="font-medium">
        <%= block ? t('super_admin.safety.block.banner_at', time: super_admin_time(block.at)) : t('super_admin.safety.block.banner') %><%= " · #{block.by}" if block&.by.present? %>
      </span>
      <% if block&.reason.present? || block&.note.present? %>
        <span class="text-[13px]" data-testid="block-reason">
          <%= t('super_admin.safety.block.banner_reason', reason: t("super_admin.safety.block.reasons.#{block.reason}")) if block.reason.present? %>
          <%= t('super_admin.safety.block.banner_note', note: block.note) if block.note.present? %>
        </span>
      <% end %>
      <span class="text-[13px]"><%= t('super_admin.safety.block.banner_effect') %></span>
    </div>
  <% end %>

  <div class="admin-card-layout">
    <div class="flex min-w-0 flex-col gap-5">
      <%= render 'plan', account: account, state: state %>

      <% if ChatwootApp.enterprise? %>
        <%= render 'limits_usage', account: account, usage: SuperAdmin::AccountUsage.new(account) %>
        <div class="hidden" aria-hidden="true">
          <%= render 'ai', account: account %>
        </div>
      <% end %>

      <div class="hidden" aria-hidden="true">
        <%= render 'channels', account: account %>
      </div>

      <%= render 'users', account: account, page: page %>

      <%# Who from the super admins entered this account, and as whom: collapsed, the last 20. %>
      <%= render 'super_admin/shared/impersonation_history', entries: SuperAdmin::ImpersonationHistory.for_account(account), scope: :account %>

      <div class="hidden" aria-hidden="true">
        <%= render 'technical', account: account, state: state %>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-5">
      <%= render 'trial', account: account, state: state %>
      <%= render 'info', account: account, state: state %>
      <%= render 'organization', account: account %>
      <%= render 'maintenance', account: account %>
    </div>
  </div>
</section>
