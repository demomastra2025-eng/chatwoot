<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show %>

<% content_for(:title) do
  t("administrate.actions.show_resource", name: page.page_title)
end %>

<header class="main-content__header" role="banner">
  <div class="main-content__heading">
    <h1 class="main-content__page-title">
      <%= content_for(:title) %>
    </h1>
  </div>

  <div class="main-content__actions">
    <% target_user = page.resource.administrators.first || page.resource.users.first %>
    <% if target_user.present? %>
      <%# POST on purpose: the one-time login token is only created (and audited) when the button is pressed, not on every page view. %>
      <%= button_to("Войти в аккаунт", [:impersonate, :super_admin, page.resource], method: :post, form: { target: "_blank" }, class: "button button--secondary", title: "Беспарольный вход в кабинет клиента глазами администратора аккаунта") %>
    <% end %>
    <%= if accessible_action?(page.resource, :edit)
      link_to(t("administrate.actions.edit"), [:edit, namespace, page.resource], class: "button")
    end %>
  </div>
</header>

<section class="main-content__body">
  <div class="flex flex-col gap-5">
    <% page.attributes.each do |title, attributes| %>
      <% if title.present? && title == 'all_features' %>
        <% regular_features, premium_features =
          attributes.partition do |attr|
            !SuperAdmin::AccountFeaturesHelper.account_premium_features.include?(
              attr.data.keys.first,
            )
          end %>

        <section class="admin-card">
          <% [regular_features, premium_features].reject(&:empty?).each_with_index do |features, index| %>
            <dl class="attribute-list <%= 'border-t border-n-weak' if index.positive? %>">
              <% features.each do |attribute| %>
                <dt class="attribute-label" id="<%= attribute.name %>">
                  <%= t(
                    "helpers.label.#{resource_name}.#{attribute.name}",
                    default: page.resource.class.human_attribute_name(attribute.name),
                  ) %>
                </dt>

                <dd class="attribute-data attribute-data--<%=attribute.html_class%>"
                    ><%= render_field attribute, page: page %></dd>
              <% end %>
            </dl>
          <% end %>
        </section>
      <% else %>
        <%= render "attribute_list", title: title, attributes: attributes, page: page %>
      <% end %>
    <% end %>
  </div>
</section>

<%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'account' %>

<% if ChatwootApp.enterprise? %>
  <%= render partial: "usage_controls", locals: { account: page.resource } %>
<% end %>

<%= render partial: "seed_data", locals: { page: page } %>

<%= render partial: "reset_cache", locals: { page: page } %>
