<section class="main-content__body">
  <hr class="my-6 border-slate-200" />

  <%
    storage_overview = account.account_usage_overview[:storage] || {}
    consumed_bytes = storage_overview[:consumed].to_i
    total_bytes = storage_overview[:total_count].to_i
    is_unlimited = storage_overview[:unlimited]

    bytes_per_gb = 1.gigabyte.to_f
    consumed_gb = (consumed_bytes / bytes_per_gb).round(2)
    total_gb = is_unlimited ? nil : (total_bytes / bytes_per_gb).round(2)

    usage_percent = if is_unlimited || total_bytes <= 0
                      0.0
                    else
                      [((consumed_bytes.to_f / total_bytes) * 100).round(1), 100.0].min
                    end

    badge_text, badge_classes, progress_bar_classes = if is_unlimited
                                                        ['Безлимит', 'bg-slate-100 text-slate-700 border-slate-300', 'bg-slate-400']
                                                      elsif usage_percent >= 95
                                                        ['Лимит >95%', 'bg-red-100 text-red-800 border-red-300', 'bg-red-500']
                                                      elsif usage_percent >= 80
                                                        ['Внимание >80%', 'bg-amber-100 text-amber-800 border-amber-300', 'bg-amber-500']
                                                      else
                                                        ['Норма', 'bg-emerald-100 text-emerald-800 border-emerald-300', 'bg-emerald-500']
                                                      end

    breakdown = account.storage_breakdown
    bytes_mb = 1.megabyte.to_f
    audio_mb = (breakdown[:audio] / bytes_mb).round(2)
    image_mb = (breakdown[:images] / bytes_mb).round(2)
    video_mb = (breakdown[:videos] / bytes_mb).round(2)
    docs_mb = (breakdown[:documents] / bytes_mb).round(2)
    captain_mb = (breakdown[:captain] / bytes_mb).round(2)
    other_mb = (breakdown[:other] / bytes_mb).round(2)
  %>

  <%
    is_trial = account.custom_attributes&.dig('plan_type') == 'trial'
    trial_expires_at = if account.custom_attributes&.dig('trial_expires_at').present?
                         begin
                           Time.zone.parse(account.custom_attributes['trial_expires_at'].to_s)
                         rescue ArgumentError
                           nil
                         end
                       end

    trial_active = is_trial && trial_expires_at.present? && trial_expires_at > Time.current
    trial_expired = is_trial && (trial_expires_at.blank? || trial_expires_at <= Time.current)

    time_remaining_text = if !is_trial
                            'Триал не активирован'
                          elsif trial_expired
                            'Истёк'
                          else
                            seconds_left = (trial_expires_at - Time.current).to_i
                            days_left = seconds_left / 86400
                            hours_left = (seconds_left % 86400) / 3600
                            minutes_left = (seconds_left % 3600) / 60
                            if days_left > 0
                              "Осталось: #{days_left} дн. #{hours_left} ч."
                            elsif hours_left > 0
                              "Осталось: #{hours_left} ч. #{minutes_left} мин."
                            else
                              "Осталось: #{minutes_left} мин."
                            end
                          end

    trial_badge_text = if !is_trial
                         'Неактивен'
                       elsif trial_active
                         'Активен'
                       else
                         'Истёк'
                       end

    trial_badge_classes = if !is_trial
                            'bg-slate-100 text-slate-700 border-slate-300'
                          elsif trial_active
                            'bg-emerald-100 text-emerald-800 border-emerald-300'
                          else
                            'bg-amber-100 text-amber-800 border-amber-300'
                          end
  %>

  <div class="space-y-6">
    <!-- Trial Status Card -->
    <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-3">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl font-bold shadow-2xs">
            🎁
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <h3 class="text-base font-bold text-slate-900">Пробный период (Trial Status)</h3>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border <%= trial_badge_classes %>">
                <%= trial_badge_text %>
              </span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
              Управление 3-дневным Full Free триалом со всеми функциями, каналами и AI
            </p>
          </div>
        </div>

        <div class="text-left md:text-right">
          <div class="text-lg font-black text-slate-900 tracking-tight">
            <%= time_remaining_text %>
          </div>
          <div class="text-xs font-medium text-slate-500 mt-0.5">
            <% if trial_expires_at.present? %>
              До: <%= trial_expires_at.in_time_zone.strftime("%d.%m.%Y %H:%M") %>
            <% else %>
              Срок действия не задан
            <% end %>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center">
        <%= button_to '➕ Продлить триал на +3 дня', [:extend_trial, :super_admin, account], method: :post, class: 'button mt-2', form_class: 'inline-block mr-2' %>
        <%= button_to '⏹️ Завершить триал', [:expire_trial, :super_admin, account], method: :post, class: 'button button--danger mt-2', form_class: 'inline-block' %>
      </div>
    </div>

    <!-- Prominent Storage Card -->
    <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl font-bold shadow-2xs">
            💾
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <h3 class="text-base font-bold text-slate-900">Хранилище и Диск (Storage)</h3>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border <%= badge_classes %>">
                <%= badge_text %>
              </span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
              Вложения, медиафайлы чатов, аудиозаписи звонков, аватары и документы базы знаний
            </p>
          </div>
        </div>

        <div class="text-left md:text-right">
          <div class="text-2xl font-black text-slate-900 tracking-tight">
            <%= number_with_precision(consumed_gb, precision: 2, strip_insignificant_zeros: true) %> GB
            <span class="text-sm font-normal text-slate-500">
              / <%= is_unlimited ? '∞ (Безлимит)' : "#{number_with_precision(total_gb, precision: 2, strip_insignificant_zeros: true)} GB" %>
            </span>
          </div>
          <div class="text-xs font-medium text-slate-500 mt-0.5">
            <% if is_unlimited %>
              Лимит не ограничен
            <% else %>
              Занято <%= usage_percent %>%
              <% available_bytes = (total_bytes - consumed_bytes).clamp(0, total_bytes) %>
              · Доступно <%= number_with_precision((available_bytes / bytes_per_gb).round(2), precision: 2, strip_insignificant_zeros: true) %> GB
            <% end %>
          </div>
        </div>
      </div>

      <!-- Visual Progress Bar -->
      <div class="w-full bg-slate-100 rounded-full h-3.5 overflow-hidden p-0.5 border border-slate-200">
        <div class="h-2.5 rounded-full transition-all duration-500 <%= progress_bar_classes %>"
             style="width: <%= is_unlimited ? '100' : [usage_percent, 1.5].max %>%;"></div>
      </div>

      <div class="flex items-center justify-between text-[11px] text-slate-400 mt-2 px-0.5">
        <span>0 GB</span>
        <span><%= is_unlimited ? 'Безлимитный тариф' : "Квота: #{total_gb} GB" %></span>
      </div>

      <!-- File Types Breakdown -->
      <div class="mt-4 pt-4 border-t border-slate-100">
        <div class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5">
          Детализация по типам файлов (Breakdown)
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5 text-xs">
          <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-slate-500 flex items-center gap-1">🎙️ Аудио / Звонки</div>
            <div class="font-bold text-slate-900 mt-1"><%= audio_mb %> MB</div>
          </div>
          <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-slate-500 flex items-center gap-1">🖼️ Фото / Скрины</div>
            <div class="font-bold text-slate-900 mt-1"><%= image_mb %> MB</div>
          </div>
          <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-slate-500 flex items-center gap-1">🎥 Видео</div>
            <div class="font-bold text-slate-900 mt-1"><%= video_mb %> MB</div>
          </div>
          <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-slate-500 flex items-center gap-1">📄 Документы</div>
            <div class="font-bold text-slate-900 mt-1"><%= docs_mb %> MB</div>
          </div>
          <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-slate-500 flex items-center gap-1">🤖 Captain AI Docs</div>
            <div class="font-bold text-slate-900 mt-1"><%= captain_mb %> MB</div>
          </div>
          <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-slate-500 flex items-center gap-1">🗂️ Прочее</div>
            <div class="font-bold text-slate-900 mt-1"><%= other_mb %> MB</div>
          </div>
        </div>
      </div>

      <!-- Storage Cleaner Section -->
      <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-amber-50/60 p-3 rounded-lg border border-amber-200/60">
        <div>
          <h4 class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
            <span>🧹</span> Умная очистка диска (Storage Cleaner)
          </h4>
          <p class="text-xs text-slate-600 mt-0.5">
            Безопасное удаление устаревших аудиозаписей звонков для освобождения места в хранилище. Сами сообщения и переписка сохраняются.
          </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <%= button_to "🗑️ Удалить аудио >6 мес.", [:cleanup_storage, :super_admin, account], params: { months: 6 }, method: :post, data: { confirm: "Удалить аудиозаписи звонков старше 6 месяцев для этого аккаунта?" }, class: "button button--secondary !text-xs !py-1 !px-2.5", form_class: "inline-block" %>
          <%= button_to "🗑️ Удалить аудио >3 мес.", [:cleanup_storage, :super_admin, account], params: { months: 3 }, method: :post, data: { confirm: "Удалить аудиозаписи звонков старше 3 месяцев для этого аккаунта?" }, class: "button button--secondary !text-xs !py-1 !px-2.5", form_class: "inline-block" %>
        </div>
      </div>
    </div>

    <!-- Usage controls heading -->
    <div>
      <h2 class="text-base font-semibold text-slate-900">Управление расходом (Сброс счетчиков)</h2>
      <p class="mt-1 text-sm text-slate-600">
        Управление динамическими счетчиками использования. Действия ниже сбрасывают только изменяемые счетчики.
      </p>
      <p class="text-xs text-slate-500">
        Диалоги, инбоксы, хранилище и документы Captain вычисляются автоматически из базы данных.
      </p>
    </div>

    <!-- Resettable counters -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-sm text-slate-900">Ответы Captain AI</span>
          <span class="text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">AI</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">
          Текущий расход: <strong class="text-slate-900"><%= number_with_delimiter(account.account_usage_overview.dig(:captain, :responses, :consumed).to_i) %></strong>
        </p>
        <p class="mt-1 text-xs text-slate-500">Сбрасывает счетчик ответов в <code>0</code>. Лимит аккаунта не изменяется.</p>
        <%= button_to 'Сбросить расход ответов Captain', [:reset_captain_responses_usage, :super_admin, account], method: :post, class: 'button mt-3 w-full text-center', form_class: 'block w-full' %>
      </div>

      <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-sm text-slate-900">Токены Captain AI</span>
          <span class="text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">Tokens</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">
          Текущий расход: <strong class="text-slate-900"><%= number_with_delimiter(account.account_usage_overview.dig(:captain, :tokens, :consumed).to_i) %></strong>
        </p>
        <p class="mt-1 text-xs text-slate-500">Сбрасывает счетчик токенов в <code>0</code>. Лимит аккаунта не изменяется.</p>
        <%= button_to 'Сбросить расход токенов Captain', [:reset_captain_tokens_usage, :super_admin, account], method: :post, class: 'button mt-3 w-full text-center', form_class: 'block w-full' %>
      </div>

      <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-sm text-slate-900">Email за сегодня</span>
          <span class="text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">Email</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">
          Отправлено сегодня: <strong class="text-slate-900"><%= number_with_delimiter(account.account_usage_overview.dig(:emails, :consumed).to_i) %></strong>
        </p>
        <p class="mt-1 text-xs text-slate-500">Очищает счетчик отправленных email в Redis за сегодня.</p>
        <%= button_to 'Сбросить счетчик отправки Email', [:reset_email_usage, :super_admin, account], method: :post, class: 'button mt-3 w-full text-center', form_class: 'block w-full' %>
      </div>
    </div>
  </div>
</section>
