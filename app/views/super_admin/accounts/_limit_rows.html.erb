<%#
# The limits of an account: one row each, with three choices

For every limit: its name, what is used and a meter, a hint, what applies now in words (the number the code enforces), and three
choices: «Как в тарифе» (with the number it gives now), «Без ограничений» and «Своё число». The field for the number is shown only
while «Своё число» is chosen: that is a switch of the radio buttons in the stylesheet, so it works without a script. The storage
is typed in gigabytes. The rows only draw the fields (`account[limit_choices][key]`, `account[limit_values][key]`); the form around
them belongs to the page (the card has its own, the edit form of the account is the other).

## Local variables:

- `rows`: a `SuperAdmin::LimitRows`.
%>
<div class="admin-limits" data-testid="limit-rows">
  <% unless rows.plan_assigned? %>
    <p class="admin-block__note" data-testid="limits-no-plan"><%= t('super_admin.limits.no_plan_note') %></p>
  <% end %>

  <% rows.rows.each do |row| %>
    <%
      id = "limit-#{row.key}"
      usage = row.usage
      used_text = ->(number) { row.bytes ? SuperAdmin::LimitWords.storage_size(number) : super_admin_number(number) }
      total_text = ->(number) { row.bytes ? SuperAdmin::LimitWords.storage_limit(number) : super_admin_number(number) }
      options = [
        ['plan', t('super_admin.limits.choices.plan'), row.plan_detail],
        ['unlimited', t('super_admin.limits.choices.unlimited'), nil],
        ['custom', t('super_admin.limits.choices.custom'), nil]
      ]
    %>
    <div class="admin-limit" data-usage="<%= row.usage_key %>" data-limit="<%= row.key %>" data-choice="<%= row.choice %>"<%= ' data-problem' if row.problem %>>
      <div class="admin-limit__head">
        <span class="admin-limit__label" id="<%= id %>-label"><%= row.label %></span>
        <% if usage %>
          <span class="admin-limit__usage">
            <%= used_text.call(usage.consumed) %>
            <% if usage.unlimited %>
              <span class="font-normal text-n-slate-11">· <%= t('super_admin.limits.unlimited') %></span>
            <% else %>
              <span class="font-normal text-n-slate-11"><%= t('super_admin.limits.of') %> <%= total_text.call(usage.total) %></span>
            <% end %>
          </span>
        <% end %>
      </div>

      <%# A limit held at 0 by an ended trial says so in one line below: no «запрещено» badge and no empty meter next to it %>
      <% unless row.held %>
        <% if usage&.blocked? %>
          <span class="admin-badge admin-badge--ruby w-fit"><%= t('super_admin.limits.blocked') %></span>
        <% elsif usage && !usage.unlimited %>
          <% fill_class = { good: '', warn: 'admin-meter__fill--warn', bad: 'admin-meter__fill--bad', idle: 'admin-meter__fill--idle' }.fetch(usage.tone) %>
          <div class="admin-meter" role="img" aria-label="<%= t('super_admin.limits.meter_label', label: row.label, percent: usage.percent) %>">
            <div class="admin-meter__fill <%= fill_class %>" style="width: <%= [[usage.percent.to_f, 0].max, 100].min %>%"></div>
          </div>
          <% if usage.overage? %>
            <span class="admin-badge admin-badge--amber w-fit" data-testid="limit-overage"><%= t('super_admin.limits.overage_badge', count: super_admin_number(usage.overage_count)) %></span>
          <% end %>
        <% end %>
      <% end %>

      <span class="admin-limit__hint"><%= row.hint %></span>
      <% if row.held %>
        <span class="admin-limit__now admin-limit__now--held" data-testid="limit-held"><%= row.held %></span>
      <% else %>
        <span class="admin-limit__now" data-testid="limit-now"><%= row.now %></span>
      <% end %>
      <% if row.drift %>
        <span class="admin-limit__drift" data-testid="limit-drift"><%= row.drift %></span>
      <% end %>

      <fieldset class="admin-limit__choices" aria-labelledby="<%= id %>-label">
        <% options.each do |value, title, detail| %>
          <label class="admin-limit__option" for="<%= id %>-<%= value %>">
            <%= radio_button_tag "account[limit_choices][#{row.key}]", value, row.choice == value, id: "#{id}-#{value}" %>
            <span class="admin-limit__option-text">
              <span class="admin-limit__option-title"><%= title %></span>
              <% if detail %><span class="admin-limit__option-sub"><%= detail %></span><% end %>
            </span>
          </label>
        <% end %>
      </fieldset>

      <div class="admin-limit__value">
        <label for="account_limit_values_<%= row.key %>">
          <%= t('super_admin.limits.number_label') %><span class="sr-only"> · <%= row.input_label %></span>
        </label>
        <%# The storage is typed in gigabytes with a comma or a dot (1,5): a field of type number refuses the comma in some browsers %>
        <% if row.bytes %>
          <%= text_field_tag "account[limit_values][#{row.key}]", row.input_value, id: "account_limit_values_#{row.key}", inputmode: 'decimal',
                             autocomplete: 'off', class: 'admin-limit__input', placeholder: t('super_admin.limits.number_placeholder') %>
        <% else %>
          <%= number_field_tag "account[limit_values][#{row.key}]", row.input_value, id: "account_limit_values_#{row.key}", min: 0, step: 1,
                               class: 'admin-limit__input', placeholder: t('super_admin.limits.number_placeholder') %>
        <% end %>
        <% if row.bytes %><span class="admin-limit__unit"><%= t('super_admin.limits.gigabytes') %></span><% end %>
      </div>
    </div>
  <% end %>
</div>
