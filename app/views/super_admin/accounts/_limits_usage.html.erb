<%#
# Limits and spend of a clinic

Every limit with what is used, a meter and a hint (operators, channels,
conversations, main channels, storage, AI answers, AI documents, AI tokens,
mail per day); «Не ограничено» when there is no limit, sizes in ГБ/МБ. Below:
where the storage goes and the buttons that reset the counters that can be reset.

## Local variables:

- `account`: the clinic (Account).
- `usage`: its `SuperAdmin::AccountUsage` (the overview is computed once).
%>
<%
  # A snapshot without a breakdown is treated like a measurement that has not finished
  breakdown = account.storage_breakdown.presence || { calculating: true }
  breakdown_keys = %i[recordings audio images videos documents captain other trash]
  resets = SuperAdmin::CounterResets.new(account)
  counters = [
    { key: :responses, action: :reset_captain_responses_usage },
    { key: :tokens, action: :reset_captain_tokens_usage },
    { key: :emails, action: :reset_email_usage }
  ]
%>

<section class="admin-block" aria-labelledby="usage-title" data-testid="usage-block">
  <div class="admin-block__head">
    <h2 class="admin-block__title" id="usage-title"><%= t('super_admin.clinic_card.usage.title') %></h2>
    <p class="admin-block__hint"><%= t('super_admin.clinic_card.usage.hint') %></p>
  </div>

  <div class="admin-usage-grid">
    <% usage.rows.each do |row| %>
      <%= render 'super_admin/accounts/usage_row', row: row %>
    <% end %>
  </div>

  <p class="admin-block__note"><%= t('super_admin.accounts.storage.informational_notice') %></p>

  <div class="flex flex-col gap-3 border-t border-n-weak pt-4" data-testid="storage-breakdown">
    <h3 class="m-0 text-heading-3 text-n-slate-12"><%= t('super_admin.accounts.storage.breakdown') %></h3>
    <% if breakdown[:calculating] %>
      <p class="admin-block__note" role="status"><%= t('storage_management.calculating') %></p>
    <% else %>
      <dl class="m-0 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <% breakdown_keys.each do |key| %>
          <div class="rounded-lg bg-n-slate-2 px-3 py-2 outline outline-1 -outline-offset-1 outline-n-weak">
            <dt class="text-xs text-n-slate-11"><%= t("super_admin.accounts.storage.#{key}") %></dt>
            <dd class="m-0 mt-0.5 font-medium tabular-nums text-n-slate-12"><%= super_admin_bytes(breakdown[key].to_i) %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>

  <div class="flex flex-col gap-3 border-t border-n-weak pt-4" data-testid="counter-resets">
    <div class="admin-block__head">
      <h3 class="m-0 text-heading-3 text-n-slate-12"><%= t('super_admin.clinic_card.usage.reset_title') %></h3>
      <p class="admin-block__note"><%= t('super_admin.clinic_card.usage.reset_hint') %></p>
    </div>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
      <% counters.each do |counter| %>
        <% kind = counter[:key] %>
        <% current = resets.current(kind) %>
        <% last = resets.last(kind) %>
        <div class="flex flex-col gap-2 rounded-lg p-3 outline outline-1 -outline-offset-1 outline-n-weak" data-counter="<%= kind %>">
          <span class="text-n-slate-12"><%= t("super_admin.clinic_card.usage.counters.#{kind}.label") %></span>
          <span class="text-xs text-n-slate-11">
            <%= t("super_admin.clinic_card.usage.counters.#{kind}.current", value: super_admin_number(current)) %>
          </span>
          <%# Who set the counter back last: the entry of the audit log %>
          <span class="text-xs text-n-slate-10" data-testid="last-reset">
            <% if last %>
              <%= t('super_admin.safety.counters.last_reset', time: super_admin_time(last.at)) %><%= ", #{last.by}" if last.by.present? %>
            <% else %>
              <%= t('super_admin.safety.counters.never_reset') %>
            <% end %>
          </span>
          <div class="mt-auto w-full">
            <%= render 'super_admin/shared/confirm_action',
                       key: "reset-#{kind}", label: t("super_admin.clinic_card.usage.counters.#{kind}.button"),
                       title: t("super_admin.safety.counters.#{kind}.title"),
                       text: [t("super_admin.safety.counters.#{kind}.text", value: super_admin_number(current)), t('super_admin.safety.audited')],
                       url: polymorphic_path([counter[:action], :super_admin, account]), submit: t("super_admin.safety.counters.#{kind}.submit"),
                       trigger_class: 'button button--small button--secondary w-full' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
