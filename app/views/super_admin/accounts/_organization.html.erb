<%#
# Organization row inside the Passport card
%>
<%
  organization = account.organization
  options = [[t('super_admin.accounts.organization.none'), '']] + SuperAdmin::OrganizationOptions.for_select
  confirm = t('super_admin.accounts.organization.confirm', account: account.name) if organization
%>

<div class="flex flex-col gap-1.5 border-t border-n-weak pt-3" data-testid="organization-block">
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-medium text-n-slate-11" id="organization-title"><%= t('super_admin.accounts.organization.title') %></span>
    <% if organization %>
      <div class="flex min-w-0 flex-col items-end gap-0.5 text-end" data-testid="account-organization">
        <%= link_to organization.name, super_admin_organization_path(organization), class: 'text-sm font-medium text-n-slate-12 hover:text-n-brand' %>
        <% if organization.bin.present? %>
          <span class="text-[11px] tabular-nums text-n-slate-10"><%= Organization.human_attribute_name(:bin) %> <%= organization.bin %></span>
        <% end %>
      </div>
    <% else %>
      <span class="text-xs text-n-slate-10" data-testid="account-organization"><%= t('super_admin.accounts.organization.empty') %></span>
    <% end %>
  </div>

  <details>
    <summary class="cursor-pointer list-none text-xs font-medium text-n-brand hover:underline">Сменить организацию</summary>
    <%= form_with url: link_organization_super_admin_account_path(account), method: :post, local: true, class: 'mt-2 flex flex-col gap-2' do %>
      <div class="flex flex-col gap-1.5">
        <%= label_tag :organization_id, t('super_admin.accounts.organization.select_label'), class: 'sr-only' %>
        <%= select_tag :organization_id, options_for_select(options, organization&.id.to_s) %>
        <%= hidden_field_tag :expected_organization_id, organization&.id.to_s, id: nil %>
      </div>
      <div class="flex justify-end">
        <%= submit_tag t('super_admin.shell.save'), name: nil, class: 'button button--small', data: { confirm: confirm }.compact %>
      </div>
    <% end %>
  </details>
</div>
