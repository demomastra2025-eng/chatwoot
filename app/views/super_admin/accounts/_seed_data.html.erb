<% if ENV.fetch('ENABLE_ACCOUNT_SEEDING', !Rails.env.production?)  %>
<section class="main-content__body">
 <hr/>
  <%= form_for([:seed, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>

  <div class="form-actions">
    <div class="pb-3">
      <p>Click the button to generate seed data in this workspace for demos.</p>
      <p class="text-color-red">Note: This will clear all existing data in this workspace.</p>
    </div>
  <%= f.submit 'Generate Seed Data' %>
  </div>
  <% end %>
</section>
<% end %>
