<% if ENV.fetch('ENABLE_ACCOUNT_SEEDING', !Rails.env.production?)  %>
<section class="main-content__body">
 <hr/>
  <%= form_for([:seed, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>

  <div class="form-actions">
    <div class="pb-3">
      <p>Нажмите кнопку, чтобы сгенерировать демо-данные в этом аккаунте для тестирования.</p>
      <p class="text-color-red">Внимание: это действие перезапишет существующие данные аккаунта.</p>
    </div>
  <%= f.submit 'Сгенерировать демо-данные', data: { confirm: 'Вы уверены? Данные аккаунта будут заменены демо-данными.' } %>
  </div>
  <% end %>
</section>
<% end %>
