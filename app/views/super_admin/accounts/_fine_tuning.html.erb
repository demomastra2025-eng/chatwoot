<%#
# Switches of «Тонкая настройка (Custom)»

Single functions on top of the plan, in groups (see SuperAdmin::FineTuning), plus
the owner-decision service switches when rendered inside the clinic card's tariff block.
%>
<%
  tuning = SuperAdmin::FineTuning.new(account)
  feature_label = SuperAdmin::AccountFeaturesHelper.method(:feature_label)
  grid_classes = local_assigns.fetch(:columns, 3) == 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 xl:grid-cols-3'
  include_service_switches = local_assigns.fetch(:include_service_switches, false)
  service_switches = include_service_switches ? tuning.service_switches : []
%>

<div class="flex flex-col gap-5" data-testid="fine-tuning">
  <div class="grid grid-cols-1 gap-x-8 gap-y-5 <%= grid_classes %>">
    <% tuning.groups.each do |group| %>
      <section class="flex min-w-0 flex-col" aria-labelledby="fine-group-<%= group.key %>">
        <h3 class="m-0 pb-1 text-xs font-semibold uppercase tracking-wider text-n-slate-10" id="fine-group-<%= group.key %>"><%= group.title %></h3>
        <% group.switches.each do |switch| %>
          <label class="flex min-h-9 cursor-pointer items-center justify-between gap-3 font-normal" for="feature-<%= switch.name %>" data-flag="<%= switch.name %>">
            <span class="flex min-w-0 flex-wrap items-center gap-x-1.5">
              <span class="text-n-slate-12"><%= switch.label %></span>
              <% if switch.manual %>
                <span class="text-[11px] text-n-amber-11" data-manual="true"><%= t('super_admin.fine_tuning.manual') %></span>
              <% end %>
            </span>
            <span class="admin-switch">
              <%= hidden_field_tag "enabled_features[feature_#{switch.name}]", 'false', id: nil %>
              <%= check_box_tag "enabled_features[feature_#{switch.name}]", 'true', switch.enabled, id: "feature-#{switch.name}", class: 'admin-switch__input' %>
              <span class="admin-switch__track" aria-hidden="true"></span>
              <span class="admin-switch__thumb" aria-hidden="true"></span>
            </span>
          </label>
        <% end %>
      </section>
    <% end %>
  </div>

  <% if service_switches.any? %>
    <div class="flex flex-col gap-2 border-t border-n-weak pt-4" id="service-flags" data-testid="service-flags-block">
      <div class="flex flex-col gap-0.5">
        <h3 class="m-0 text-xs font-semibold uppercase tracking-wider text-n-slate-10"><%= t('super_admin.service_flags.title') %></h3>
        <p class="m-0 text-xs text-n-slate-11"><%= t('super_admin.service_flags.hint') %></p>
      </div>
      <div class="flex flex-col">
        <% service_switches.each do |switch| %>
          <label class="admin-switch-row cursor-pointer font-normal" for="service-<%= switch.name %>" data-flag="<%= switch.name %>">
            <span class="admin-switch-row__text">
              <span class="admin-switch-row__title"><%= switch.label %></span>
              <span class="admin-switch-row__hint"><%= switch.hint %></span>
            </span>
            <span class="admin-switch">
              <%= hidden_field_tag "enabled_features[feature_#{switch.name}]", 'false', id: nil %>
              <%= check_box_tag "enabled_features[feature_#{switch.name}]", 'true', switch.enabled, id: "service-#{switch.name}", class: 'admin-switch__input',
                                data: { confirm_on: switch.confirm_on, confirm_off: switch.confirm_off } %>
              <span class="admin-switch__track" aria-hidden="true"></span>
              <span class="admin-switch__thumb" aria-hidden="true"></span>
            </span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <p class="admin-block__note">
    <%= t('super_admin.fine_tuning.always_on', features: Accounts::Plans.locked_on.map { |name| feature_label.call(name) }.join(', ')) %>
    <%= t('super_admin.fine_tuning.never_on', features: tuning.never_enabled_labels.join(', ')) %>
    <%= t('super_admin.fine_tuning.internal') %>
  </p>
</div>
