<%#
# Passport of a clinic: compact key/value facts and inline rename
%>
<%
  rows = [
    [t('super_admin.clinic_card.info.created'), super_admin_time(account.created_at)]
  ]
  rows << [t('super_admin.clinic_card.info.plan_applied'), super_admin_time(state.applied_at).presence || '—'] if state.assigned?
%>

<div class="flex flex-col gap-2" data-testid="info-block">
  <div class="flex items-center justify-between gap-2">
    <h2 class="admin-block__title m-0" id="info-title">Паспорт аккаунта</h2>
    <details class="relative">
      <summary class="cursor-pointer list-none text-xs font-medium text-n-brand hover:underline">Переименовать</summary>
      <%= form_with url: super_admin_account_path(account), method: :patch, local: true, class: 'mt-2 flex flex-col gap-2 rounded-lg bg-n-slate-2 p-2.5' do %>
        <%= hidden_field_tag :return_to, 'card', id: nil %>
        <%= render 'super_admin/accounts/form_state', account: account %>
        <%= label_tag 'account_name_inline', 'Название аккаунта', class: 'sr-only' %>
        <%= text_field_tag 'account[name]', account.name, id: 'account_name_inline', required: true %>
        <div class="flex justify-end">
          <%= submit_tag t('super_admin.shell.save'), name: nil, class: 'button button--small' %>
        </div>
      <% end %>
    </details>
  </div>

  <dl class="admin-kv">
    <% rows.each do |key, value| %>
      <div class="admin-kv__row">
        <dt class="admin-kv__key"><%= key %></dt>
        <dd class="admin-kv__value"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</div>
