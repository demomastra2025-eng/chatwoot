<%#
# Basic facts of a clinic

A short key/value block of the side column: language (as text: the platform is Russian only for now), time zone,
creation date and when the plan was applied. All times are Astana time.

## Local variables:

- `account`: the clinic (Account).
- `state`: its `SuperAdmin::AccountPlanState`.
%>
<%
  rows = [
    [t('super_admin.clinic_card.info.locale'), LanguageField.name_of(account.locale)],
    [t('super_admin.clinic_card.info.timezone'), SuperAdmin::AccountTimezones.label_for(account.reporting_timezone).presence || t('super_admin.clinic_card.info.timezone_default')],
    [t('super_admin.clinic_card.info.created'), super_admin_time(account.created_at)]
  ]
  # The version of the plan is a technical number: it is under «Для разработчика» (see `_technical`)
  rows << [t('super_admin.clinic_card.info.plan_applied'), super_admin_time(state.applied_at).presence || '—'] if state.assigned?
%>

<section class="admin-block" aria-labelledby="info-title" data-testid="info-block">
  <h2 class="admin-block__title" id="info-title"><%= t('super_admin.clinic_card.info.title') %></h2>
  <dl class="admin-kv">
    <% rows.each do |key, value| %>
      <div class="admin-kv__row">
        <dt class="admin-kv__key"><%= key %></dt>
        <dd class="admin-kv__value"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</section>
