<%#
# Plan of a clinic: the 4 tariff presets and collapsed Fine-Tuning (Custom)

## Local variables:

- `account`: the clinic (Account).
- `state`: its `SuperAdmin::AccountPlanState`.
%>

<%
  chosen = state.modules
  drift = state.drift
  active_tariff = state.custom? ? nil : state.effective_tariff
  held = state.trial_limits_held?
  hint_text = if held
                t('super_admin.clinic_card.plan.hint_restore')
              else
                state.assigned? ? t('super_admin.clinic_card.plan.hint_assigned') : t('super_admin.clinic_card.plan.hint_unassigned')
              end
  feature_label = SuperAdmin::AccountFeaturesHelper.method(:feature_label)
%>

<section class="admin-block" aria-labelledby="plan-title" data-testid="plan-block">
  <div class="admin-block__head-row">
    <div class="admin-block__head">
      <h2 class="admin-block__title" id="plan-title"><%= t('super_admin.clinic_card.plan.title') %></h2>
      
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% badge_tone = if !state.assigned?
                        'admin-badge--quiet'
                      elsif state.custom?
                        'admin-badge--amber hidden'
                      else
                        'admin-badge--iris'
                      end %>
      <span class="admin-badge <%= badge_tone %>" data-testid="plan-label"><%= state.label %></span>
      <% if state.drifted? %>
        <%= render 'super_admin/shared/confirm_action', key: 'reset-plan', label: t('super_admin.plans.drift.reset'),
                   text: [t('super_admin.plans.drift.reset_confirm')], url: apply_plan_super_admin_account_path(account),
                   params: { modules: chosen, tariff: state.effective_tariff }.compact, tone: :primary, submit: t('super_admin.safety.plan.reset_submit'),
                   trigger_class: 'button button--small button--secondary' %>
      <% end %>
    </div>
  </div>

  <% unless state.assigned? %>
    <div class="admin-notice" role="status" data-testid="plan-unassigned">
      <span class="flex flex-col gap-0.5">
        <span class="font-medium"><%= t('super_admin.clinic_card.plan.unassigned_title') %></span>
        <span class="text-[13px] text-n-slate-11"><%= t('super_admin.clinic_card.plan.unassigned_text') %></span>
      </span>
    </div>
  <% end %>

  <% if state.drifted? %>
    <div class="admin-notice admin-notice--amber hidden" aria-hidden="true" data-testid="plan-drift">
      <span class="flex min-w-0 flex-col gap-0.5">
        <span class="font-medium"><%= t('super_admin.plans.drift.summary', extra: drift[:extra].size, missing: drift[:missing].size, plan: state.base_label) %></span>
        <% if drift[:extra].any? %>
          <span class="text-[13px]"><%= t('super_admin.plans.drift.extra', features: drift[:extra].map { |name| feature_label.call(name) }.sort.join(', ')) %></span>
        <% end %>
        <% if drift[:missing].any? %>
          <span class="text-[13px]"><%= t('super_admin.plans.drift.missing', features: drift[:missing].map { |name| feature_label.call(name) }.sort.join(', ')) %></span>
        <% end %>
      </span>
    </div>
  <% end %>

  <%= form_with url: apply_plan_super_admin_account_path(account), method: :post, local: true, class: 'flex flex-col gap-4',
                data: { plan_form: true, assigned: state.assigned?.to_s, limits_held: held.to_s, initial_modules: chosen.to_json,
                        initial_tariff: active_tariff.to_s, preview_url: plan_preview_super_admin_account_path(account) } do %>
    <%= render 'plan_cards', chosen: chosen, tariff: active_tariff %>

    <div data-plan-preview aria-live="polite" hidden></div>

    <noscript>
      <p class="admin-block__note"><%= t('super_admin.clinic_card.plan.no_script') %></p>
    </noscript>

    <div class="admin-block__footer">
      <span class="admin-block__note" data-plan-hint><%= hint_text %></span>
      <%= button_tag(state.apply_label, type: 'submit', class: 'button', data: { plan_submit: true }) %>
    </div>
  <% end %>

  <details class="admin-collapse mt-2 border-t border-n-weak pt-3" id="fine-tuning" data-testid="fine-tuning-block">
    <summary>
      <span class="flex min-w-0 flex-col gap-0.5">
        <span class="text-heading-3 text-n-slate-12"><%= t('super_admin.fine_tuning.title') %></span>
        <span class="text-xs text-n-slate-11"><%= t('super_admin.fine_tuning.hint') %></span>
      </span>
      <span class="admin-collapse__chevron i-lucide-chevron-down size-4" aria-hidden="true"></span>
    </summary>
    <div class="admin-collapse__body">
      <%= form_with url: super_admin_account_path(account), method: :patch, local: true, class: 'flex flex-col gap-5', data: { service_flags_form: true } do %>
        <%= render 'fine_tuning', account: account, include_service_switches: true %>
        <div class="admin-block__footer sticky bottom-0 z-10 border-t border-n-weak bg-n-solid-2 py-3">
          <%= submit_tag t('super_admin.shell.save'), name: nil, class: 'button' %>
        </div>
      <% end %>
    </div>
  </details>
</section>

<script>
  (function () {
    var form = document.querySelector('[data-plan-form]');
    if (!form) return;
    var box = form.querySelector('[data-plan-preview]');
    var submit = form.querySelector('[data-plan-submit]');
    var hint = form.querySelector('[data-plan-hint]');
    var assigned = form.getAttribute('data-assigned') === 'true';
    var held = form.getAttribute('data-limits-held') === 'true';
    var initial = JSON.parse(form.getAttribute('data-initial-modules') || '[]').slice().sort().join(',');
    var initialTariff = form.getAttribute('data-initial-tariff') || '';
    var requestId = 0;

    function selected() {
      return Array.prototype.map.call(form.querySelectorAll('input[name="modules[]"]:checked'), function (input) { return input.value; });
    }

    function selectedTariff() {
      var checked = form.querySelector('input[name="tariff"]:checked');
      return checked ? checked.value : '';
    }

    function applyTariffModules(radio) {
      if (!radio || !radio.value) return;
      var wanted = JSON.parse(radio.getAttribute('data-tariff-modules') || '[]');
      Array.prototype.forEach.call(form.querySelectorAll('input[name="modules[]"]'), function (box) {
        box.checked = wanted.indexOf(box.value) !== -1;
      });
    }

    function sync() {
      var modules = selected();
      var tariff = selectedTariff();
      var changed = !assigned || held || tariff !== initialTariff || modules.slice().sort().join(',') !== initial;
      submit.disabled = !changed;
      if (!changed) {
        requestId += 1;
        box.hidden = true;
        box.innerHTML = '';
        hint.hidden = false;
        return;
      }
      var query = new URLSearchParams();
      query.append('fragment', '1');
      if (tariff) query.append('tariff', tariff);
      modules.forEach(function (module) { query.append('modules[]', module); });
      var current = (requestId += 1);
      fetch(form.getAttribute('data-preview-url') + '?' + query.toString(), {
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(function (response) { return response.ok ? response.text() : Promise.reject(response.status); })
        .then(function (html) {
          if (current !== requestId) return;
          box.innerHTML = html;
          box.hidden = false;
          hint.hidden = true;
        })
        .catch(function () {
          if (current !== requestId) return;
          box.hidden = true;
          hint.hidden = false;
        });
    }

    form.addEventListener('change', function (event) {
      if (!event.target) return;
      if (event.target.name === 'tariff') {
        applyTariffModules(event.target);
        sync();
      } else if (event.target.name === 'modules[]') {
        var customRadio = form.querySelector('input[name="tariff"][value=""]');
        if (customRadio) customRadio.checked = true;
        sync();
      }
    });
    sync();

    var serviceForm = document.querySelector('[data-service-flags-form]');
    if (serviceForm) {
      serviceForm.addEventListener('submit', function (event) {
        var questions = [];
        serviceForm.querySelectorAll('input[type="checkbox"]').forEach(function (box) {
          if (box.checked === box.defaultChecked) return;
          var text = box.checked ? box.getAttribute('data-confirm-on') : box.getAttribute('data-confirm-off');
          if (text) questions.push(text);
        });
        if (questions.length > 0 && !window.confirm(questions.join('\n\n'))) event.preventDefault();
      });
    }
  })();
</script>
