<%#
# Collapsed maintenance and danger zone inside the Passport card
%>
<%
  seeding_enabled = Seeders::Seeding.enabled?
  deletion = SuperAdmin::AccountDeletion.new(account: account)
%>

<details class="border-t border-n-weak pt-3" data-testid="maintenance-block">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-xs font-medium text-n-slate-11 hover:text-n-slate-12">
    <span id="maintenance-title"><%= t('super_admin.clinic_card.maintenance.title') %> и удаление</span>
    <span class="admin-collapse__chevron i-lucide-chevron-down size-3.5" aria-hidden="true"></span>
  </summary>

  <div class="mt-3 flex flex-col gap-3">
    <div class="flex flex-wrap gap-2">
      <%= render 'super_admin/shared/confirm_action', key: 'reset-cache', label: t('super_admin.clinic_card.maintenance.reset_cache'),
                 text: [t('super_admin.clinic_card.maintenance.reset_cache_confirm')], url: reset_cache_super_admin_account_path(account),
                 tone: :primary, submit: t('super_admin.safety.maintenance.reset_cache_submit') %>
      <% if seeding_enabled %>
        <%= render 'super_admin/shared/confirm_action', key: 'seed', label: t('super_admin.clinic_card.maintenance.seed'),
                   text: [t('super_admin.clinic_card.maintenance.seed_confirm')], url: seed_super_admin_account_path(account),
                   submit: t('super_admin.safety.maintenance.seed_submit') %>
      <% end %>
    </div>

    <% if deletion.scheduled? %>
      <p class="admin-block__note" data-testid="deletion-note"><%= t('super_admin.clinic_card.maintenance.deletion_scheduled', date: super_admin_time(deletion.deletion_at)) %></p>
    <% else %>
      <details class="rounded-lg outline outline-1 -outline-offset-1 outline-n-ruby-4" data-testid="deletion-form">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-xs font-medium text-n-ruby-11">
          <span><%= t('super_admin.clinic_card.maintenance.destroy') %></span>
          <span class="admin-collapse__chevron i-lucide-chevron-down size-3.5" aria-hidden="true"></span>
        </summary>
        <%= form_with url: super_admin_account_path(account), method: :delete, local: true, class: 'flex flex-col gap-2 px-3 pb-3' do %>
          <p class="admin-block__note"><%= t('super_admin.clinic_card.maintenance.destroy_hint', days: SuperAdmin::AccountDeletion::GRACE_PERIOD.in_days.to_i) %></p>
          <%= label_tag :confirm_name, t('super_admin.clinic_card.maintenance.destroy_confirm_label', name: account.name), class: 'text-xs text-n-slate-11' %>
          <%= text_field_tag :confirm_name, nil, autocomplete: 'off', required: true, placeholder: account.name %>
          <%= submit_tag t('super_admin.clinic_card.maintenance.destroy'), name: nil, class: 'button button--small button--danger w-fit' %>
        <% end %>
      </details>
    <% end %>
  </div>
</details>
