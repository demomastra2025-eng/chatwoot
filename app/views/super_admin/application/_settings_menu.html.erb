<%#
# Sidebar: instance settings

A collapsible sidebar entry. The summary links to the instance settings page,
the chevron opens the list of config pages (general, channels, integrations).
The AI models page has its own entry in the "ИИ" group and is not repeated here.

## Local variables:

- `open`: true while a settings page is shown, so the list starts expanded.
%>
<%
  on_settings_page = super_admin_nav_active?(:settings)
  current_config = params[:config].presence || 'general'
  summary_state = if on_settings_page
                    'bg-n-brand-solid font-medium text-n-brand-contrast hover:text-n-brand-contrast'
                  else
                    'text-n-slate-11 hover:bg-n-alpha-2 hover:text-n-slate-11'
                  end
%>
<details class="group" <%= 'open' if open %>>
  <summary class="flex h-8 cursor-pointer list-none items-center gap-1 rounded-lg pe-1.5 text-sm [&::-webkit-details-marker]:hidden <%= summary_state %>">
    <%= link_to super_admin_settings_path, class: 'flex h-8 min-w-0 flex-1 items-center gap-2 ps-2', aria: { current: (on_settings_page ? 'page' : nil) } do %>
      <span class="i-lucide-settings size-4 shrink-0" aria-hidden="true"></span>
      <span class="min-w-0 truncate"><%= t('super_admin.navigation.items.settings') %></span>
    <% end %>
    <span class="i-lucide-chevron-down size-4 shrink-0 transition-transform duration-200 group-open:rotate-180" aria-hidden="true"></span>
  </summary>
  <div class="mt-0.5 flex flex-col gap-0.5 ps-6">
    <% settings_pages.each do |feature_key, attrs| %>
      <% next if attrs['config_key'] == 'captain' %>
      <% page_active = super_admin_nav_active?(:app_configs) && current_config == attrs['config_key'] %>
      <%= link_to super_admin_app_config_path(config: attrs['config_key']),
                  class: "flex h-8 items-center rounded-lg px-2 text-sm hover:bg-n-alpha-2 #{page_active ? 'bg-n-alpha-2 font-medium text-n-slate-12 hover:text-n-slate-12' : 'text-n-slate-11 hover:text-n-slate-11'}",
                  aria: { current: (page_active ? 'page' : nil) } do %>
        <span class="min-w-0 truncate"><%= attrs['name'] %></span>
      <% end %>
    <% end %>
  </div>
</details>
