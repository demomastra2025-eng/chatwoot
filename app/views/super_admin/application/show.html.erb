<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<header class="main-content__header">
  <div class="main-content__heading">
    <h1 class="main-content__page-title">
      <%= content_for(:title) %>
    </h1>
  </div>

  <div class="main-content__actions">
    <%= link_to(
      t("administrate.actions.edit"),
      [:edit, namespace, page.resource],
      class: "button",
    ) if accessible_action?(page.resource, :edit) %>

    <%# Asks «точно?» with the name of the object and what happens to it (shared/_confirm_action) %>
    <% if accessible_action?(page.resource, :destroy) %>
      <% kind = page.resource_name.to_s %>
      <% object_name = kind == 'platform_banner' ? truncate(page.resource.banner_message.to_s, length: 60) : page.dashboard.display_resource(page.resource) %>
      <%= render 'super_admin/shared/confirm_action', key: "delete-#{kind}", label: t('administrate.actions.destroy'), floating: true,
                 title: t("super_admin.safety.destroy.#{kind}.title", name: object_name, default: t('super_admin.safety.destroy.generic.title', name: object_name)),
                 text: [t("super_admin.safety.destroy.#{kind}.text", default: t('super_admin.safety.destroy.generic.text')), t('super_admin.safety.audited')],
                 url: polymorphic_path([namespace, page.resource]), http_method: :delete, submit: t('super_admin.safety.destroy.generic.submit'),
                 trigger_class: 'button button--danger' %>
    <% end %>
  </div>
</header>

<section class="main-content__body">
  <div class="flex flex-col gap-5">
    <% page.attributes.each do |title, attributes| %>
      <%= render "attribute_list", title: title, attributes: attributes, page: page %>
    <% end %>
  </div>
</section>
