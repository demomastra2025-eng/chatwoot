<%#
# Javascript Partial

This partial imports the necessary javascript on each page.
By default, it includes the application JS,
but each page can define additional JS sources
by providing a `content_for(:javascript)` block.
%>

<% Administrate::Engine.javascripts.each do |js_path| %>
  <%= javascript_include_tag js_path %>
<% end %>

<%# The name of the chosen file next to the button that stands in for a native file input (fields/active_storage/_form). %>
<script>
  document.addEventListener('change', function (event) {
    var input = event.target;
    if (!input.matches || !input.matches('.file-picker__input')) return;
    var label = input.parentNode.querySelector('[data-file-picker-name]');
    if (!label) return;
    var names = Array.prototype.map.call(input.files || [], function (file) { return file.name; });
    label.textContent = names.length ? names.join(', ') : label.getAttribute('data-empty');
  });
</script>

<%# A group of choices (`data-choice-group`, the cards of shared/_choice): only the fields of the chosen card are shown. %>
<script>
  document.addEventListener('change', function (event) {
    var radio = event.target;
    if (!radio.matches || !radio.matches('input[type="radio"]')) return;
    var group = radio.closest('[data-choice-group]');
    if (!group) return;
    group.querySelectorAll('[data-choice]').forEach(function (choice) {
      var body = choice.querySelector(':scope > [data-choice-body]');
      var input = choice.querySelector(':scope > .admin-choice__head input[type="radio"]');
      if (body && input) body.hidden = !input.checked;
    });
  });
</script>

<%# A form that creates things (`data-single-submit`) is sent once: a second click while the first is on its way would create it twice. %>
<script>
  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (!form.matches || !form.matches('form[data-single-submit]')) return;
    if (form.dataset.sent) { event.preventDefault(); return; }
    form.dataset.sent = '1';
  });
  // The page comes back from the cache with «Назад»: the form can be sent again
  window.addEventListener('pageshow', function (event) {
    if (!event.persisted) return;
    document.querySelectorAll('form[data-single-submit]').forEach(function (form) { delete form.dataset.sent; });
  });
</script>

<%# The question before a dangerous action (shared/_confirm_action, a <details>): «Отмена» and Escape close it. A click or a key inside it
    never reaches the row of a table it stands in (Administrate opens the page of the row on a click and on Enter / Space), and
    the link «Изменить» of a block that sits in a collapsed <details> opens that block first. %>
<script>
  (function () {
    function closePanel(panel) {
      panel.open = false;
      var trigger = panel.querySelector('summary');
      if (trigger) trigger.focus();
    }
    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      var close = target.closest('[data-confirm-close]');
      if (close) closePanel(close.closest('details'));
      var opener = target.closest('a[data-open-details]');
      if (opener) {
        var section = document.getElementById((opener.getAttribute('href') || '').replace(/^#/, ''));
        if (section && section.tagName === 'DETAILS') section.open = true;
      }
      if (target.closest('.admin-ask') && target.closest('.js-table-row')) event.stopPropagation();
    }, true);
    document.addEventListener('keydown', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      var panel = target.closest('.admin-ask');
      if (!panel) return;
      if (event.key === 'Escape' && panel.open) closePanel(panel);
      if (target.closest('.js-table-row')) event.stopPropagation();
    }, true);
  })();
</script>

<%= yield :javascript %>

<% if Rails.env.test? %>
  <%= javascript_tag do %>
    $.fx.off = true;
    $.ajaxSetup({ async: false });
  <% end %>
<% end %>
