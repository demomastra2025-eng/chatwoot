<%#
# Javascript Partial

This partial imports the necessary javascript on each page.
By default, it includes the application JS,
but each page can define additional JS sources
by providing a `content_for(:javascript)` block.
%>

<% Administrate::Engine.javascripts.each do |js_path| %>
  <%= javascript_include_tag js_path %>
<% end %>

<%# The name of the chosen file next to the button that stands in for a native file input (fields/active_storage/_form). %>
<script>
  document.addEventListener('change', function (event) {
    var input = event.target;
    if (!input.matches || !input.matches('.file-picker__input')) return;
    var label = input.parentNode.querySelector('[data-file-picker-name]');
    if (!label) return;
    var names = Array.prototype.map.call(input.files || [], function (file) { return file.name; });
    label.textContent = names.length ? names.join(', ') : label.getAttribute('data-empty');
  });
</script>

<%# A group of choices (`data-choice-group`, the cards of shared/_choice): only the fields of the chosen card are shown. %>
<script>
  document.addEventListener('change', function (event) {
    var radio = event.target;
    if (!radio.matches || !radio.matches('input[type="radio"]')) return;
    var group = radio.closest('[data-choice-group]');
    if (!group) return;
    group.querySelectorAll('[data-choice]').forEach(function (choice) {
      var body = choice.querySelector(':scope > [data-choice-body]');
      var input = choice.querySelector(':scope > .admin-choice__head input[type="radio"]');
      if (body && input) body.hidden = !input.checked;
    });
  });
</script>

<%= yield :javascript %>

<% if Rails.env.test? %>
  <%= javascript_tag do %>
    $.fx.off = true;
    $.ajaxSetup({ async: false });
  <% end %>
<% end %>
