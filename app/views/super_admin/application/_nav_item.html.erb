<li class="px-4 mb-1">
  <% text_class_name = current_page?(url) ? 'text-n-slate-12 bg-n-alpha-2 font-medium' : 'text-n-slate-11' %>
  <%= link_to(url, class: text_class_name + " -ml-1 focus:outline-none cursor-pointer flex items-center px-2 py-1.5 hover:text-n-slate-12 hover:bg-n-alpha-2 rounded-lg", title: local_assigns[:title]) do %>
    <svg width="16" height="16"><use xlink:href="#<%= icon %>" /></svg>
    <span class="ml-2 text-sm"><%= label %></span>
  <% end %>
</li>
