<%#
# Filters

This partial is used on the `index` page to display available filters
for a collection of resources, as a segmented control: one link per filter,
the current one marked with `aria-current`. A filter is the `name:` search
prefix of the dashboard (`COLLECTION_FILTERS`).

## Local variables:

- `page`:
  An instance of [Administrate::Page::Collection][1].
  Contains helper methods to help display a table,
  and knows which attributes should be displayed in the resource's table.

Labels come from `super_admin.shell.filters.<name>`; a filter without a
translation shows its humanized name. An optional tooltip comes from
`super_admin.shell.filter_hints.<name>`.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Collection
%>

<%
  dashboard_class = "#{page.resource_name.classify}Dashboard".constantize

  # The filter in use is the part of the search term before the colon.
  current_filter = nil
  search_param = params[:search]
  if search_param.is_a?(String) && search_param.include?(':')
    current_filter = search_param.split(':').first
  end
%>

<% if dashboard_class.const_defined?(:COLLECTION_FILTERS) && !dashboard_class::COLLECTION_FILTERS.empty? %>
  <div class="segmented" role="group" aria-label="<%= t('super_admin.shell.filter') %>">
    <%# `list_scope_params` is what else narrows the list (the organization of the account list): a click keeps it. %>
    <%= link_to t('super_admin.shell.filter_all'), url_for({ search: nil }.merge(list_scope_params)), class: 'segmented__item', aria: { current: (current_filter.nil? ? 'true' : nil) } %>
    <% dashboard_class::COLLECTION_FILTERS.each_key do |filter_name| %>
      <%# A filter that counts differently from what the list shows says so in a tooltip (`super_admin.shell.filter_hints.<name>`). %>
      <%= link_to t("super_admin.shell.filters.#{filter_name}", default: filter_name.to_s.titleize),
                  url_for({ search: "#{filter_name}:" }.merge(list_scope_params)),
                  class: 'segmented__item',
                  title: t("super_admin.shell.filter_hints.#{filter_name}", default: '').presence,
                  aria: { current: (filter_name.to_s == current_filter ? 'true' : nil) } %>
    <% end %>
  </div>
<% end %>
