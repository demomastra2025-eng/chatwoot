<%#
# Search

The search box of the index page: magnifier inside the field, a clear button
while a term is active.

## Local variables:

- `search_term`: the term currently searched for (may be blank).
- `resource_name`: label of the searched resource, used for the placeholder.
%>
<form class="search" role="search">
  <%# What else narrows the list (the organization of the account list) stays when a term is searched. %>
  <% list_scope_params.each do |name, value| %>
    <%= hidden_field_tag name, value, id: nil %>
  <% end %>
  <label class="sr-only" for="search">
    <%= t("administrate.search.label", resource: resource_name) %>
  </label>
  <span class="search__eyeglass-icon i-lucide-search" aria-hidden="true"></span>

  <input class="search__input"
         id="search"
         type="search"
         name="search"
         placeholder="<%= t("administrate.search.label", resource: resource_name) %>"
         value="<%= search_term %>">

  <% if search_term.present? %>
    <%= link_to clear_search_params.merge(list_scope_params), class: "search__clear-link", title: t("administrate.search.clear") do %>
      <span class="i-lucide-x size-4" aria-hidden="true"></span>
      <span class="sr-only"><%= t("administrate.search.clear") %></span>
    <% end %>
  <% end %>
</form>
