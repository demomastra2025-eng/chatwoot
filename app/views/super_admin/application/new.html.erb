<%#
# New

This view is the template for the "new resource" page.
It displays a header, and then renders the `_form` partial
to do the heavy lifting.

Copied from Administrate 0.20.1 (`administrate/application/new`) and restyled.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Form][1].
  Contains helper methods to help display a form,
  and knows which attributes should be displayed in the resource's form.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Form
%>

<%# Each resource names its own «new» page in super_admin.index.<resource>.new («Новый пользователь»); a lower-cased
    resource name would break names like «AI-бот». %>
<% content_for(:title) do %>
  <%= I18n.t("super_admin.index.#{page.resource_name}.new", default: nil) || t(
    "administrate.actions.new_resource",
    name: display_resource_name(page.resource_name, singular: true).downcase
  ) %>
<% end %>

<header class="main-content__header">
  <div class="main-content__heading">
    <h1 class="main-content__page-title">
      <%= content_for(:title) %>
    </h1>
  </div>

  <div class="main-content__actions">
    <%= link_to(:back, class: "button button--secondary") do %>
      <span class="i-lucide-arrow-left size-4" aria-hidden="true"></span>
      <%= t("administrate.actions.back") %>
    <% end %>
  </div>
</header>

<section class="main-content__body">
  <%= render "form", page: page %>
</section>
