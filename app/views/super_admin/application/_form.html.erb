<%#
# Form Partial

This partial is rendered on a resource's `new` and `edit` pages,
and renders all form fields for a resource's editable attributes.

Copied from Administrate 0.20.1 (`administrate/application/_form`) and
restyled: one outlined card, validation errors as a banner on top, the submit
button in a footer row. Keep the gem partials of the fields untouched; diff
against the gem when it is upgraded.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Form][1].
  Contains helper methods to display a form,
  and knows which attributes should be displayed in the resource's form.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Form
%>

<%= form_for([namespace, page.resource], html: { class: "form flex max-w-3xl flex-col gap-4" }) do |f| %>
  <% if page.resource.errors.any? %>
    <div id="error_explanation" role="alert" class="rounded-xl bg-n-ruby-2 px-4 py-3 text-sm text-n-ruby-11 outline outline-1 -outline-offset-1 outline-n-ruby-4">
      <h2 class="m-0 text-heading-3 text-n-ruby-11">
        <%= t(
          "administrate.form.errors",
          count: page.resource.errors.count,
          pluralized_errors: pluralize(page.resource.errors.count, t("administrate.form.error")),
          resource_name: display_resource_name(page.resource_name, singular: true)
        ) %>
      </h2>

      <ul class="mt-1 list-disc ps-5">
        <% page.resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# The state of the account this form was drawn from: a section somebody else changed meanwhile is not overwritten. %>
  <%= render 'super_admin/accounts/form_state', account: page.resource if page.resource_name.to_s == 'account' && page.resource.persisted? %>

  <div class="admin-card">
    <div class="flex flex-col px-5 pb-0 pt-5">
      <% page.attributes(controller.action_name).each do |title, attributes| -%>
        <fieldset class="form-section <%= "field-unit--nested" if title.present? %>">
          <% if title.present? %>
            <legend><%= t "helpers.label.#{f.object_name}.#{title}", default: title %></legend>
          <% end %>

          <% attributes.each do |attribute| %>
            <div class="field-unit field-unit--<%= attribute.html_class %> field-unit--<%= requireness(attribute) %>">
              <%= render_field attribute, f: f %>

              <% hint_key = "administrate.field_hints.#{page.resource_name}.#{attribute.name}" %>
              <% if I18n.exists?(hint_key) -%>
                <div class="field-unit__hint">
                  <%= I18n.t(hint_key) %>
                </div>
              <% end -%>
            </div>
          <% end %>
        </fieldset>
      <% end -%>
    </div>

    <div class="form-actions border-t border-n-weak px-5 py-4">
      <%= f.submit page.resource.persisted? ? t("super_admin.shell.save") : t("super_admin.shell.create") %>
    </div>
  </div>
<% end %>
