<%#
# The model of the knowledge base search (under «Для разработчика»), shown and not editable

Vectors of two models cannot be compared, so the model is not a setting that this page can change: the developer changes it with
`rake onelink:embeddings:apply`, which stores the new vectors of every table and switches the setting in one step (the server refuses a
changed value too, see SuperAdmin::AiModelsForm).

## Local variables:

- `slot`: the `SuperAdmin::AiModelsPage::Slot` of `CAPTAIN_EMBEDDING_MODEL`.
%>
<%
  scope = 'super_admin.app_config.captain'
  stored = slot.value.to_s.strip
%>
<div class="admin-slot admin-slot--wide <%= 'admin-slot--invalid' if slot.invalid? %>" data-config="<%= slot.key %>" data-source="<%= slot.configured ? 'set' : 'default' %>">
  <div class="admin-slot__head">
    <span class="admin-slot__title" id="label_<%= slot.key %>"><%= slot.title %></span>
  </div>
  <p class="admin-slot__hint"><%= slot.hint %></p>
  <div class="admin-notice admin-notice--amber"><%= t("#{scope}.developer.embedding_warning") %></div>

  <p class="admin-slot__status" data-testid="slot-status">
    <% if stored.blank? %>
      <%= t("#{scope}.status.builtin", name: slot.choices.builtin_name || t("#{scope}.models.builtin_unknown")) %>
    <% else %>
      <%= t("#{scope}.status.chosen", name: ai_model_name(stored)) %>
    <% end %>
  </p>

  <%= render 'ai_slot_errors', slot: slot %>
  <p class="admin-field__key" data-tech-name><%= slot.key %></p>
</div>
