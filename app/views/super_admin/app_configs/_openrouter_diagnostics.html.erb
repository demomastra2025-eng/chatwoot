<%#
# OpenRouter: details for a developer

A folded block inside «Для разработчика»: where the catalog of models comes from and how it was refreshed, the providers
and their endpoints, the events of the last 24 hours, what changed in the catalog and which models each function can use.
What a person needs (is the key working, the balance, the spend, is the catalog loaded) is on the first tab in plain words
(SuperAdmin::AiConnectionState). Times are Astana time and no key is ever shown.

## Local variables:

- `diagnostics`: the hash of Llm::OpenRouterDiagnostics (may be empty).
%>
<%
  scope = 'super_admin.app_config.captain.diagnostics'
  key_status = diagnostics[:key_status].to_h
  key_health = key_status[:health].to_h
  key_details = key_health[:key].to_h
  catalog = diagnostics[:catalog].to_h
  endpoints = diagnostics[:endpoints].to_h
  runtime = diagnostics[:runtime].to_h
  catalog_diff = (catalog[:last_refresh_diff] || {}).to_h
  endpoint_diff = (endpoints[:last_refresh_diff] || {}).to_h
  features = diagnostics[:features].to_h
  key_state = key_health[:status].presence || (key_status[:effective_configured] ? 'not_checked' : 'missing')
  yes_no = ->(flag) { (flag ? t('super_admin.app_config.yes') : t('super_admin.app_config.no')).downcase }
  none = t("#{scope}.none")
  types = catalog[:counts_by_type].to_h.map { |type, count| "#{t("#{scope}.types.#{type}", default: type.to_s)}: #{diagnostics_count(count)}" }
%>

<details class="admin-collapse" id="openrouter-diagnostics" data-testid="openrouter-diagnostics">
  <summary>
    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="text-heading-2 text-n-slate-12"><%= t("#{scope}.title") %></span>
      <span class="text-body-main text-n-slate-11"><%= t("#{scope}.hint") %></span>
    </span>
    <span class="admin-collapse__chevron i-lucide-chevron-down size-4" aria-hidden="true"></span>
  </summary>

  <div class="admin-collapse__body flex flex-col gap-5">
    <div class="admin-stat-grid">
      <div class="admin-stat" data-testid="diagnostics-key-details">
        <p class="admin-stat__label"><%= t('super_admin.app_config.captain.connection.key') %></p>
        <p class="admin-stat__value"><%= diagnostics_status(:key, key_state) %></p>
        <p class="admin-stat__note"><%= t("#{scope}.key_line", global: yes_no.call(key_status[:global_configured]), account: yes_no.call(key_status[:account_configured])) %></p>
        <% if key_details[:key_type].present? %>
          <p class="admin-stat__note"><%= t("#{scope}.key_type", type: key_details[:key_type]) %></p>
        <% end %>
      </div>

      <div class="admin-stat" data-testid="diagnostics-catalog-details">
        <p class="admin-stat__label"><%= t('super_admin.app_config.captain.connection.catalog') %></p>
        <p class="admin-stat__value"><%= diagnostics_time(catalog[:last_refreshed_at]).upcase_first %></p>
        <p class="admin-stat__note"><%= t("#{scope}.catalog_line", status: diagnostics_status(:refresh, catalog[:refresh_status]).downcase, source: diagnostics_status(:source, catalog[:source])) %></p>
        <% if types.any? %>
          <p class="admin-stat__note"><%= t("#{scope}.catalog_types", types: types.join(', ')) %></p>
        <% end %>
        <p class="admin-stat__note"><%= t("#{scope}.catalog_stale", stale: diagnostics_count(catalog[:stale_models]), disabled: diagnostics_count(catalog[:disabled_models])) %></p>
      </div>

      <div class="admin-stat" data-testid="diagnostics-providers">
        <p class="admin-stat__label"><%= t("#{scope}.provider_title") %></p>
        <p class="admin-stat__note">
          <%= t("#{scope}.provider_line", number: diagnostics_count(endpoints[:total_endpoints]), status: diagnostics_status(:refresh, endpoints[:refresh_status]).downcase,
                                          providers: Array(endpoints[:providers]).first(5).join(', ').presence || none) %>
        </p>
        <p class="admin-stat__note"><%= t("#{scope}.provider_stale", stale: diagnostics_count(endpoints[:stale_endpoints]), pending: diagnostics_count(endpoints[:pending_model_count])) %></p>
      </div>

      <div class="admin-stat" data-testid="diagnostics-events-details">
        <p class="admin-stat__label"><%= t('super_admin.app_config.captain.connection.spend') %></p>
        <p class="admin-stat__note">
          <%= t("#{scope}.events_line", events: diagnostics_count(runtime[:total_events]), requests: diagnostics_count(runtime[:request_count]),
                                        errors: diagnostics_count(runtime[:error_count]), provider: diagnostics_count(runtime[:provider_failure_count])) %>
        </p>
        <p class="admin-stat__note"><%= diagnostics_time(runtime[:last_event_at]).upcase_first %></p>
      </div>
    </div>

    <% if endpoints[:last_refresh_error].present? %>
      <div class="admin-notice admin-notice--amber"><%= t("#{scope}.provider_error", error: endpoints[:last_refresh_error]) %></div>
    <% end %>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex flex-col gap-2">
        <p class="m-0 text-xs font-medium text-n-slate-11"><%= t("#{scope}.catalog_changes") %></p>
        <div class="admin-chips">
          <% %i[new changed removed capability_changed price_changed].each do |diff_key| %>
            <span class="admin-chip"><%= t("#{scope}.diff.#{diff_key}") %>: <%= diagnostics_count(catalog_diff.fetch(diff_key, {}).to_h[:count]) %></span>
          <% end %>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <p class="m-0 text-xs font-medium text-n-slate-11"><%= t("#{scope}.provider_changes") %></p>
        <div class="admin-chips">
          <% %i[new changed removed provider_changed price_changed failed_model_ids].each do |diff_key| %>
            <span class="admin-chip"><%= t("#{scope}.diff.#{diff_key}") %>: <%= diagnostics_count(endpoint_diff.fetch(diff_key, {}).to_h[:count]) %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <p class="m-0 text-xs font-medium text-n-slate-11"><%= t("#{scope}.features") %></p>
      <div class="grid gap-2 md:grid-cols-2">
        <% features.each do |feature_key, feature| %>
          <% feature = feature.to_h %>
          <% selected_diagnostics = feature[:selected_model_diagnostics].to_h %>
          <div class="admin-stat" data-feature="<%= feature_key %>">
            <p class="admin-stat__value"><%= t("#{scope}.feature_names.#{feature_key}", default: feature_key.to_s.humanize) %></p>
            <p class="admin-stat__note">
              <%= t("#{scope}.features_line", available: diagnostics_count(feature[:available_model_count]),
                                              selected: feature[:selected_model].presence || none, built_in: feature[:default_model].presence || none) %>
            </p>
            <% if selected_diagnostics[:allowed] == false && selected_diagnostics[:reason_codes].present? %>
              <p class="admin-stat__note text-n-amber-11"><%= t("#{scope}.features_warning", reasons: selected_diagnostics[:reason_codes].join(', ')) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</details>
