<%#
# Diagnostics of OpenRouter

A collapsed block under the settings of the AI models page: the state of the
key and the credits, the model catalog, the providers and the events of the last
24 hours, and the two actions that refresh them. Everything is in Russian, the
times are Astana time, and no key is ever shown. The details (what changed in the
catalog, which models each function can use) are one more level down.

## Local variables:

- `diagnostics`: the hash of Llm::OpenRouterDiagnostics (may be empty).
%>
<%
  scope = 'super_admin.app_config.captain.diagnostics'
  key_status = diagnostics[:key_status].to_h
  key_health = key_status[:health].to_h
  key_details = key_health[:key].to_h
  credits = key_health[:credits].to_h
  catalog = diagnostics[:catalog].to_h
  endpoints = diagnostics[:endpoints].to_h
  runtime = diagnostics[:runtime].to_h
  catalog_diff = (catalog[:last_refresh_diff] || {}).to_h
  endpoint_diff = (endpoints[:last_refresh_diff] || {}).to_h
  features = diagnostics[:features].to_h
  key_state = key_health[:status].presence || (key_status[:effective_configured] ? 'not_checked' : 'missing')
  yes_no = ->(flag) { flag ? t('super_admin.app_config.yes') : t('super_admin.app_config.no') }
  none = t("#{scope}.none")
  unknown = t("#{scope}.unknown")
%>

<details class="admin-collapse" id="openrouter-diagnostics" data-testid="openrouter-diagnostics">
  <summary>
    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="text-heading-2 text-n-slate-12"><%= t("#{scope}.title") %></span>
      <span class="text-body-main text-n-slate-11"><%= t("#{scope}.hint") %></span>
    </span>
    <span class="admin-collapse__chevron i-lucide-chevron-down size-4" aria-hidden="true"></span>
  </summary>

  <div class="admin-collapse__body flex flex-col gap-5">
    <div class="admin-stat-grid">
      <div class="admin-stat" data-testid="diagnostics-key">
        <p class="admin-stat__label"><%= t("#{scope}.key.title") %></p>
        <p class="admin-stat__value"><%= diagnostics_status(:key, key_state) %></p>
        <p class="admin-stat__note"><%= t("#{scope}.key.sources", global: yes_no.call(key_status[:global_configured]), account: yes_no.call(key_status[:account_configured])) %></p>
        <p class="admin-stat__note">
          <%= t("#{scope}.key.checked", time: diagnostics_time(key_health[:checked_at])) %>
          <% if key_details[:key_type].present? %>
            · <%= t("#{scope}.key.type", type: key_details[:key_type]) %>
          <% end %>
        </p>
        <% if key_health[:error].present? %>
          <p class="admin-stat__note text-n-ruby-11"><%= key_health[:error] %></p>
        <% end %>
      </div>

      <div class="admin-stat" data-testid="diagnostics-credits">
        <p class="admin-stat__label"><%= t("#{scope}.credits.title") %></p>
        <% if credits[:status] == 'available' %>
          <p class="admin-stat__value"><%= t("#{scope}.credits.remaining", value: diagnostics_amount(credits[:remaining_credits])) %></p>
          <p class="admin-stat__note"><%= t("#{scope}.credits.totals", total: diagnostics_amount(credits[:total_credits]), used: diagnostics_amount(credits[:total_usage])) %></p>
        <% else %>
          <p class="admin-stat__value"><%= diagnostics_status(:credits, credits[:status].presence || 'not_checked') %></p>
          <% if credits[:status].blank? || credits[:status] == 'management_key_required' %>
            <p class="admin-stat__note"><%= t("#{scope}.credits.management_key_needed") %></p>
          <% elsif credits[:error].present? %>
            <p class="admin-stat__note"><%= credits[:error] %></p>
          <% end %>
        <% end %>
        <p class="admin-stat__note">
          <%= t("#{scope}.credits.key_limit", limit: key_details[:limit].present? ? diagnostics_amount(key_details[:limit]) : none,
                                              left: key_details[:limit_remaining].present? ? diagnostics_amount(key_details[:limit_remaining]) : unknown) %>
        </p>
      </div>

      <div class="admin-stat" data-testid="diagnostics-catalog">
        <p class="admin-stat__label"><%= t("#{scope}.catalog.title") %></p>
        <p class="admin-stat__value"><%= diagnostics_time(catalog[:last_refreshed_at]) %></p>
        <p class="admin-stat__note">
          <%= t("#{scope}.catalog.status", status: diagnostics_status(:refresh, catalog[:refresh_status]), source: diagnostics_status(:source, catalog[:source])) %>
        </p>
        <p class="admin-stat__note">
          <%= t("#{scope}.catalog.models", number: diagnostics_count(catalog[:total_models])) %>
          <% types = catalog[:counts_by_type].to_h.map { |type, count| "#{t("#{scope}.types.#{type}", default: type.to_s)}: #{count}" } %>
          <%= "(#{types.join(', ')})" if types.any? %>
        </p>
        <p class="admin-stat__note"><%= t("#{scope}.catalog.stale", stale: diagnostics_count(catalog[:stale_models]), disabled: diagnostics_count(catalog[:disabled_models])) %></p>
        <% if catalog[:last_started_at].present? %>
          <p class="admin-stat__note"><%= t("#{scope}.catalog.started", time: diagnostics_time(catalog[:last_started_at])) %></p>
        <% end %>
      </div>

      <div class="admin-stat" data-testid="diagnostics-providers">
        <p class="admin-stat__label"><%= t("#{scope}.providers.title") %></p>
        <p class="admin-stat__value"><%= t("#{scope}.providers.endpoints", number: diagnostics_count(endpoints[:total_endpoints])) %></p>
        <p class="admin-stat__note">
          <%= t("#{scope}.providers.status", status: diagnostics_status(:refresh, endpoints[:refresh_status]),
                                             providers: Array(endpoints[:providers]).first(5).join(', ').presence || none) %>
        </p>
        <p class="admin-stat__note"><%= t("#{scope}.providers.stale", stale: diagnostics_count(endpoints[:stale_endpoints]), pending: diagnostics_count(endpoints[:pending_model_count])) %></p>
      </div>

      <div class="admin-stat" data-testid="diagnostics-events">
        <p class="admin-stat__label"><%= t("#{scope}.events.title") %></p>
        <p class="admin-stat__value"><%= t("#{scope}.events.totals", events: diagnostics_count(runtime[:total_events]), requests: diagnostics_count(runtime[:request_count])) %></p>
        <p class="admin-stat__note"><%= t("#{scope}.events.errors", errors: diagnostics_count(runtime[:error_count]), provider: diagnostics_count(runtime[:provider_failure_count])) %></p>
        <p class="admin-stat__note"><%= t("#{scope}.events.cost", cost: number_with_precision(runtime[:estimated_cost].to_f, precision: 6, delimiter: ' ', separator: ','), last: diagnostics_time(runtime[:last_event_at])) %></p>
      </div>
    </div>

    <% if catalog[:last_refresh_error].present? %>
      <div class="admin-notice admin-notice--ruby"><%= t("#{scope}.catalog.last_error", error: catalog[:last_refresh_error]) %></div>
    <% end %>
    <% if endpoints[:last_refresh_error].present? %>
      <div class="admin-notice admin-notice--amber"><%= t("#{scope}.providers.last_error", error: endpoints[:last_refresh_error]) %></div>
    <% end %>

    <div class="flex flex-wrap gap-2">
      <%= button_to t("#{scope}.actions.check_key"), refresh_openrouter_key_health_super_admin_app_config_path(config: 'captain'),
                    method: :post, class: 'button button--small button--secondary', form_class: 'inline-block' %>
      <%= button_to t("#{scope}.actions.refresh_catalog"), refresh_openrouter_models_super_admin_app_config_path(config: 'captain'),
                    method: :post, class: 'button button--small', form_class: 'inline-block' %>
    </div>

    <details class="admin-collapse" data-testid="diagnostics-details">
      <summary>
        <span class="text-heading-3 text-n-slate-12"><%= t("#{scope}.details.title") %></span>
        <span class="admin-collapse__chevron i-lucide-chevron-down size-4" aria-hidden="true"></span>
      </summary>
      <div class="admin-collapse__body flex flex-col gap-5">
        <div class="grid gap-4 md:grid-cols-2">
          <div class="flex flex-col gap-2">
            <p class="m-0 text-xs font-medium text-n-slate-11"><%= t("#{scope}.details.catalog_changes") %></p>
            <div class="admin-chips">
              <% %i[new changed removed capability_changed price_changed].each do |diff_key| %>
                <span class="admin-chip"><%= t("#{scope}.diff.#{diff_key}") %>: <%= diagnostics_count(catalog_diff.fetch(diff_key, {}).to_h[:count]) %></span>
              <% end %>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <p class="m-0 text-xs font-medium text-n-slate-11"><%= t("#{scope}.details.provider_changes") %></p>
            <div class="admin-chips">
              <% %i[new changed removed provider_changed price_changed failed_model_ids].each do |diff_key| %>
                <span class="admin-chip"><%= t("#{scope}.diff.#{diff_key}") %>: <%= diagnostics_count(endpoint_diff.fetch(diff_key, {}).to_h[:count]) %></span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <p class="m-0 text-xs font-medium text-n-slate-11"><%= t("#{scope}.details.features") %></p>
          <div class="grid gap-2 md:grid-cols-2">
            <% features.each do |feature_key, feature| %>
              <% feature = feature.to_h %>
              <% selected_diagnostics = feature[:selected_model_diagnostics].to_h %>
              <div class="admin-stat" data-feature="<%= feature_key %>">
                <p class="admin-stat__value"><%= t("#{scope}.feature_names.#{feature_key}", default: feature_key.to_s.humanize) %></p>
                <p class="admin-stat__note">
                  <%= t("#{scope}.features.line", available: diagnostics_count(feature[:available_model_count]),
                                                  selected: feature[:selected_model].presence || none, built_in: feature[:default_model].presence || none) %>
                </p>
                <% if selected_diagnostics[:allowed] == false && selected_diagnostics[:reason_codes].present? %>
                  <p class="admin-stat__note text-n-amber-11"><%= t("#{scope}.features.warning", reasons: selected_diagnostics[:reason_codes].join(', ')) %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </details>
  </div>
</details>
