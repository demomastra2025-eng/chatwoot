<%#
# Config page

The settings of one part of the platform (general, a channel, an integration, the
AI models). The AI models page is its own layout (cards grouped by purpose and the
OpenRouter diagnostics); every other page is one list of fields.

## Local variables (controller instance variables):

- `@config`: the name of the page.
%>
<% content_for(:title) { app_config_page_title(@config) } %>

<header class="main-content__header" role="banner">
  <div class="main-content__heading">
    <h1 class="main-content__page-title" id="page-title"><%= content_for(:title) %></h1>
    <p class="main-content__description"><%= t(@config == 'captain' ? 'super_admin.app_config.captain.description' : 'super_admin.app_config.description') %></p>
  </div>
</header>

<section class="main-content__body">
  <%= render(@config == 'captain' ? 'captain' : 'generic') %>
</section>

<%= render 'scripts' %>
