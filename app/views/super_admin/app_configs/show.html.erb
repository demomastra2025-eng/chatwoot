<% content_for(:title) do %>
  Configure Settings - <%= @config.titleize %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<style>
.eye-icon.eye-hide path {
  d: path('M3 3l18 18M10.5 10.677a2 2 0 002.823 2.823M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5');
}
</style>

<section class="main-content__body">
  <% if @config == 'captain' %>
    <% diagnostics = @openrouter_diagnostics.to_h %>
    <% key_status = diagnostics[:key_status].to_h %>
    <% catalog = diagnostics[:catalog].to_h %>
    <% endpoints = diagnostics[:endpoints].to_h %>
    <% runtime = diagnostics[:runtime].to_h %>
    <% catalog_diff = (catalog[:last_refresh_diff] || {}).to_h %>
    <% endpoint_diff = (endpoints[:last_refresh_diff] || {}).to_h %>
    <% workspace_policy = diagnostics[:workspace_policy].to_h %>
    <% guardrails_summary = diagnostics[:guardrails].to_h %>
    <% features = diagnostics[:features].to_h %>
    <% model_eligibility = Array(diagnostics[:model_eligibility]) %>
    <div class="mb-8 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="font-medium text-slate-900">OpenRouter diagnostics</div>
          <div class="mt-1 text-slate-500">
            Super admin operations panel for key status, catalog freshness, endpoint/provider health, and model eligibility. API keys are never rendered.
          </div>

          <div class="mt-4 grid gap-3 md:grid-cols-4">
            <div class="rounded-md border border-slate-100 bg-slate-50 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Key status</div>
              <div class="mt-1 font-semibold text-slate-900"><%= key_status[:effective_configured] ? 'Configured' : 'Missing' %></div>
              <div class="text-xs text-slate-500">
                Global: <%= key_status[:global_configured] ? 'yes' : 'no' %>, account: <%= key_status[:account_configured] ? 'yes' : 'no' %>
              </div>
            </div>
            <div class="rounded-md border border-slate-100 bg-slate-50 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Catalog freshness</div>
              <div class="mt-1 font-semibold text-slate-900"><%= catalog[:last_refreshed_at].presence || 'never' %></div>
              <div class="text-xs text-slate-500">Status: <%= catalog[:refresh_status] || 'unknown' %>, source: <%= catalog[:source] || 'unknown' %><%= catalog[:using_fallback] ? ' (fallback)' : '' %></div>
              <% if catalog[:last_started_at].present? %>
                <div class="text-xs text-slate-400">Started: <%= catalog[:last_started_at] %></div>
              <% end %>
            </div>
            <div class="rounded-md border border-slate-100 bg-slate-50 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Model counts</div>
              <div class="mt-1 font-semibold text-slate-900"><%= catalog[:total_models] || 0 %> models</div>
              <div class="text-xs text-slate-500"><%= catalog[:counts_by_type].to_h.map { |type, count| "#{type}: #{count}" }.join(', ') %></div>
              <div class="text-xs text-slate-400">Stale: <%= catalog[:stale_models] || 0 %>, disabled: <%= catalog[:disabled_models] || 0 %></div>
            </div>
            <div class="rounded-md border border-slate-100 bg-slate-50 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Endpoints</div>
              <div class="mt-1 font-semibold text-slate-900"><%= endpoints[:total_endpoints] || 0 %> endpoints</div>
              <div class="text-xs text-slate-500">Status: <%= endpoints[:refresh_status] || 'unknown' %>, providers: <%= Array(endpoints[:providers]).first(5).join(', ').presence || 'none' %></div>
              <div class="text-xs text-slate-400">Stale endpoints: <%= endpoints[:stale_endpoints] || 0 %>, pending refresh: <%= endpoints[:pending_model_count] || 0 %></div>
            </div>
            <div class="rounded-md border border-slate-100 bg-slate-50 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Runtime telemetry</div>
              <div class="mt-1 font-semibold text-slate-900"><%= runtime[:total_events] || 0 %> events / <%= runtime[:request_count] || 0 %> requests</div>
              <div class="text-xs text-slate-500">Errors: <%= runtime[:error_count] || 0 %>, provider failures: <%= runtime[:provider_failure_count] || 0 %></div>
              <div class="text-xs text-slate-400">Cost: <%= number_with_precision(runtime[:estimated_cost].to_f, precision: 6) %>, last: <%= runtime[:last_event_at].presence || 'never' %></div>
            </div>
          </div>

          <% if catalog[:last_refresh_error].present? %>
            <div class="mt-3 rounded-md bg-red-50 px-3 py-2 text-red-700">Last catalog error: <%= catalog[:last_refresh_error] %></div>
          <% end %>
          <% if endpoints[:last_refresh_error].present? %>
            <div class="mt-3 rounded-md bg-amber-50 px-3 py-2 text-amber-700">Endpoint refresh warning: <%= endpoints[:last_refresh_error] %></div>
          <% end %>

          <div class="mt-4 grid gap-3 md:grid-cols-2">
            <div class="rounded-md border border-slate-100 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Catalog diff</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% %i[new changed removed capability_changed price_changed].each do |diff_key| %>
                  <% diff_item = catalog_diff.fetch(diff_key, {}).to_h %>
                  <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= diff_key %>: <%= diff_item[:count] || 0 %></span>
                <% end %>
              </div>
            </div>
            <div class="rounded-md border border-slate-100 p-3">
              <div class="text-xs font-medium uppercase text-slate-500">Endpoint diff</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% %i[new changed removed provider_changed price_changed failed_model_ids].each do |diff_key| %>
                  <% diff_item = endpoint_diff.fetch(diff_key, {}).to_h %>
                  <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= diff_key %>: <%= diff_item[:count] || 0 %></span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-3">
            <div>
              <div class="text-xs font-medium uppercase text-slate-500">Capability counts</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% catalog[:capability_counts].to_h.each do |capability, count| %>
                  <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= capability %>: <%= count %></span>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase text-slate-500">Endpoint/provider details</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% endpoints[:provider_counts].to_h.first(8).each do |provider, count| %>
                  <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= provider %>: <%= count %></span>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase text-slate-500">Runtime top signals</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% runtime[:by_feature].to_h.first(6).each do |feature, count| %>
                  <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= feature %>: <%= count %></span>
                <% end %>
                <% runtime[:recent_error_codes].to_h.first(4).each do |code, count| %>
                  <span class="rounded-full bg-amber-50 px-2 py-1 text-xs text-amber-700"><%= code %>: <%= count %></span>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase text-slate-500">Workspace policy</div>
              <% if workspace_policy[:error].present? %>
                <div class="mt-2 rounded-md bg-red-50 px-2 py-1 text-xs text-red-700"><%= workspace_policy[:error] %></div>
              <% else %>
                <% provider_preferences = workspace_policy[:provider_preferences].to_h %>
                <% guardrails = workspace_policy[:guardrails].to_h %>
                <div class="mt-2 text-xs text-slate-600">
                  Profile: <%= workspace_policy[:privacy_profile] %>, workspace: <%= workspace_policy[:workspace] %>
                </div>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% provider_preferences.each do |key, value| %>
                    <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= key %>: <%= value %></span>
                  <% end %>
                </div>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% guardrails.each do |guardrail_key, guardrail| %>
                    <span class="rounded-full bg-slate-50 px-2 py-1 text-xs text-slate-600"><%= guardrail_key %>: <%= guardrail.to_h[:status] %></span>
                  <% end %>
                </div>
                <% if guardrails_summary[:status_counts].present? %>
                  <div class="mt-2 text-xs text-slate-500">
                    Feature guardrails: <%= guardrails_summary[:status_counts].to_h.map { |status, count| "#{status}: #{count}" }.join(', ') %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="mt-4">
            <div class="text-xs font-medium uppercase text-slate-500">Feature availability</div>
            <div class="mt-2 grid gap-2 md:grid-cols-2">
              <% features.each do |feature_key, feature| %>
                <% selected_diagnostics = feature.to_h[:selected_model_diagnostics].to_h %>
                <% feature_policy = feature.to_h[:policy].to_h %>
                <div class="rounded-md border border-slate-100 p-2">
                  <div class="font-medium text-slate-800"><%= feature_key %></div>
                  <div class="text-xs text-slate-500">
                    available: <%= feature.to_h[:available_model_count] || 0 %>, selected: <%= feature.to_h[:selected_model].presence || 'none' %>, default: <%= feature.to_h[:default_model].presence || 'none' %>
                  </div>
                  <% if feature_policy.present? %>
                    <div class="mt-1 text-xs text-slate-500">
                      policy: cache <%= feature_policy[:cache_policy] || 'disabled' %>, tools <%= Array(feature_policy[:allowed_server_tools]).join(', ').presence || 'blocked' %>, plugins <%= Array(feature_policy[:allowed_plugins]).join(', ').presence || 'blocked' %>
                    </div>
                  <% end %>
                  <% if selected_diagnostics[:allowed] == false && selected_diagnostics[:reason_codes].present? %>
                    <div class="mt-1 text-xs text-amber-700">Selected model warning: <%= selected_diagnostics[:reason_codes].join(', ') %></div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mt-4">
            <div class="text-xs font-medium uppercase text-slate-500">Model eligibility samples</div>
            <div class="mt-2 grid gap-2 md:grid-cols-2">
              <% model_eligibility.first(6).each do |model| %>
                <% hidden_reasons = model.to_h[:features].to_h.values.flat_map { |feature| Array(feature[:reason_codes]) }.uniq.first(5) %>
                <div class="rounded-md border border-slate-100 p-2">
                  <div class="truncate font-medium text-slate-800"><%= model[:display_name] || model[:id] %></div>
                  <div class="truncate text-xs text-slate-500"><%= model[:id] %></div>
                  <div class="mt-1 text-xs text-slate-500">
                    type: <%= model[:type].presence || 'unknown' %>, endpoints: <%= model[:endpoint_count] || 0 %>, providers: <%= Array(model[:endpoint_providers]).first(3).join(', ').presence || 'none' %>
                  </div>
                  <% if hidden_reasons.present? %>
                    <div class="mt-1 text-xs text-amber-700">Why hidden: <%= hidden_reasons.join(', ') %></div>
                  <% else %>
                    <div class="mt-1 text-xs text-emerald-700">No sampled hidden reasons</div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <%= button_to 'Queue OpenRouter Catalog Refresh',
                      refresh_openrouter_models_super_admin_app_config_path(config: 'captain'),
                      method: :post,
                      class: 'inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800' %>
      </div>
    </div>
  <% end %>

  <%= form_with url: super_admin_app_config_url(config: @config) , method: :post do |form| %>
    <% @allowed_configs.each do |key| %>
      <div class="flex mb-8">
        <div class="field-unit__label">
          <%= form.label "app_config[#{key}]", @installation_configs[key]&.dig('display_title') || key %>
        </div>
        <div class="-mt-2 field-unit__field ">
          <% if key == Captain::Assistant::GLOBAL_SYSTEM_PROMPTS_INSTALLATION_CONFIG %>
            <% current_system_prompts = Array(@app_config[key]).map { |entry| entry.respond_to?(:to_h) ? entry.to_h : entry } %>
            <%= form.hidden_field "app_config[#{key}]",
                value: current_system_prompts.to_json,
                id: "app_config_#{key}" %>
            <div
              id="captain-system-prompts-builder"
              class="mt-2 flex flex-col gap-3"
              data-target-input="app_config_<%= key %>"
              data-initial-prompts="<%= h(current_system_prompts.to_json) %>"
            >
              <div data-role="rows" class="flex flex-col gap-3"></div>
              <button
                type="button"
                class="reset-base inline-flex w-fit items-center rounded-md border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 add-captain-system-prompt"
              >
                Add system prompt
              </button>
              <template>
                <div data-role="prompt-row" class="rounded-lg border border-slate-200 bg-white p-4">
                  <div class="mb-3 flex items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-800">System prompt</p>
                    <button
                      type="button"
                      class="reset-base rounded-md border border-rose-200 px-2 py-1 text-xs font-medium text-rose-600 hover:bg-rose-50 remove-captain-system-prompt"
                    >
                      Remove
                    </button>
                  </div>
                  <input type="hidden" data-field="id" />
                  <div class="mb-3">
                    <label class="mb-1 block text-xs font-medium text-slate-600">Group</label>
                    <input
                      type="text"
                      data-field="group"
                      class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm"
                      placeholder="Strict rules"
                    />
                  </div>
                  <div class="mb-3">
                    <label class="mb-1 block text-xs font-medium text-slate-600">Prompt text</label>
                    <textarea
                      data-field="content"
                      rows="5"
                      class="w-full rounded-md border border-slate-200 px-2 py-1.5 font-mono text-xs"
                      placeholder="Write the system prompt here"
                    ></textarea>
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-slate-600">Slot (optional, advanced)</label>
                    <input
                      type="text"
                      data-field="slot"
                      class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm"
                      placeholder="assistant_system_context"
                    />
                  </div>
                </div>
              </template>
            </div>
          <% elsif @installation_configs[key]&.dig('type') == 'boolean' %>
            <%= form.select "app_config[#{key}]",
              [["True", true], ["False", false]],
              { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) },
              class: "mt-2 border border-slate-100 p-1 rounded-md"
            %>
          <% elsif @installation_configs[key]&.dig('type') == 'code' %>
            <%= form.text_area "app_config[#{key}]",
                value: @app_config[key],
                rows: 12,
                wrap: 'off',
                class: "mt-2 border font-mono text-xs border-slate-100 p-1 rounded-md overflow-scroll"
            %>
          <% elsif @installation_configs[key]&.dig('type') == 'secret' %>
            <% mask_secret_value = masked_secret_config?(key) && @app_config[key].present? %>
            <div class="relative">
              <%= form.password_field "app_config[#{key}]",
                  id: "app_config_#{key}",
                  value: mask_secret_value ? nil : @app_config[key],
                  placeholder: mask_secret_value ? 'Configured — leave blank to keep current key' : nil,
                  class: "mt-2 border border-slate-100 p-1.5 pr-8 rounded-md w-full"
              %>
              <button
                type="button"
                class="absolute reset-base !bg-white top-1/2 !outline-0 !text-n-slate-11 -translate-y-1/2 right-2 p-1 hover:!bg-n-slate-5 rounded-sm toggle-password"
                data-target="app_config_<%= key %>"
              >
                <svg class="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                  <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                </svg>
              </button>
            </div>
          <% elsif @installation_configs[key]&.dig('type') == 'select' && @installation_configs[key]&.dig('options').present? %>
            <%= form.select "app_config[#{key}]",
              @installation_configs[key]['options'].map { |val, label| [label, val] },
              { selected: @app_config[key] },
              class: "mt-2 border border-slate-100 p-1 rounded-md"
            %>
        <% else %>
          <%= form.text_field "app_config[#{key}]", value: @app_config[key] %>
        <% end %>
          <%if @installation_configs[key]&.dig('description').present? %>
            <p class="pt-2 text-xs italic text-slate-400">
              <%= @installation_configs[key]&.dig('description') %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="form-actions">
      <%= form.submit "Submit" %>
    </div>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;

        // Toggle icon
        const svg = button.querySelector('.eye-icon');
        if (type === 'password') {
          svg.classList.remove('eye-hide')
        } else {
          svg.classList.add('eye-hide')
        }
      });
    });

    const builder = document.getElementById('captain-system-prompts-builder');
    if (!builder) return;

    const hiddenInput = document.getElementById(builder.dataset.targetInput);
    const rowsContainer = builder.querySelector('[data-role="rows"]');
    const template = builder.querySelector('template');
    const addButton = builder.querySelector('.add-captain-system-prompt');
    const nextPromptId = () => `system_prompt_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

    const syncRows = () => {
      const prompts = [...rowsContainer.querySelectorAll('[data-role="prompt-row"]')]
        .map(row => ({
          id: row.querySelector('[data-field="id"]').value || nextPromptId(),
          type: 'system',
          group: row.querySelector('[data-field="group"]').value.trim(),
          content: row.querySelector('[data-field="content"]').value.trim(),
          slot: row.querySelector('[data-field="slot"]').value.trim() || null,
        }))
        .filter(prompt => prompt.content);

      hiddenInput.value = JSON.stringify(prompts);
    };

    const bindRow = row => {
      row.querySelectorAll('[data-field]').forEach(field => {
        field.addEventListener('input', syncRows);
      });
      row.querySelector('.remove-captain-system-prompt').addEventListener('click', () => {
        row.remove();
        syncRows();
      });
    };

    const addRow = prompt => {
      const fragment = template.content.cloneNode(true);
      const row = fragment.querySelector('[data-role="prompt-row"]');
      row.querySelector('[data-field="id"]').value = prompt.id || nextPromptId();
      row.querySelector('[data-field="group"]').value = prompt.group || '';
      row.querySelector('[data-field="content"]').value = prompt.content || '';
      row.querySelector('[data-field="slot"]').value = prompt.slot || '';
      bindRow(row);
      rowsContainer.appendChild(fragment);
      syncRows();
    };

    let initialPrompts = [];
    try {
      initialPrompts = JSON.parse(builder.dataset.initialPrompts || '[]');
    } catch (error) {
      initialPrompts = [];
    }

    if (!initialPrompts.length) {
      addRow({ group: 'Strict rules', content: '', slot: '' });
    } else {
      initialPrompts.forEach(addRow);
    }

    addButton.addEventListener('click', () => addRow({ group: 'Strict rules', content: '', slot: '' }));
    builder.closest('form')?.addEventListener('submit', syncRows);
  });
  </script>
<% end %>
