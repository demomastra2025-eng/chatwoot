<% content_for(:title) do %>
  Настройка параметров: <%= @config.titleize %>
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<style>
.eye-icon.eye-hide path {
  d: path('M3 3l18 18M10.5 10.677a2 2 0 002.823 2.823M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5');
}
</style>

<section class="main-content__body">
  <% if @config == 'captain' %>
    <% diagnostics = @openrouter_diagnostics.to_h %>
    <% key_status = diagnostics[:key_status].to_h %>
    <% key_health = key_status[:health].to_h %>
    <% key_details = key_health[:key].to_h %>
    <% credits = key_health[:credits].to_h %>
    <% catalog = diagnostics[:catalog].to_h %>
    <% endpoints = diagnostics[:endpoints].to_h %>
    <% runtime = diagnostics[:runtime].to_h %>
    <% catalog_diff = (catalog[:last_refresh_diff] || {}).to_h %>
    <% endpoint_diff = (endpoints[:last_refresh_diff] || {}).to_h %>
    <% workspace_policy = diagnostics[:workspace_policy].to_h %>
    <% guardrails_summary = diagnostics[:guardrails].to_h %>
    <% features = diagnostics[:features].to_h %>
    <% model_eligibility = Array(diagnostics[:model_eligibility]) %>
    <% admin_operations = diagnostics[:admin_operations].to_h %>
    <% openrouter_operations = Array(admin_operations[:operations]) %>
    <% extension_label_map = {
      'structured_response_recovery' => 'Восстановление JSON',
      'long_context_protection' => 'Защита длинного контекста',
      'system_time' => 'Системное время',
      'web_search' => 'Веб-поиск',
      'pdf_inputs' => 'PDF-вход',
      'image_generation' => 'Генерация изображений'
    } %>
    <div class="mb-8 rounded-lg border border-n-weak bg-n-solid-2 px-4 py-3 text-sm text-n-slate-12">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="font-medium text-n-slate-12">OpenRouter</div>
          <div class="mt-1 text-n-slate-11">
            Состояние ключа, кредитов, каталога моделей, endpoint-провайдеров, политик и admin-операций. API-ключи здесь не отображаются.
          </div>

          <div class="mt-4 grid gap-3 md:grid-cols-4">
            <div class="rounded-md border border-n-weak bg-n-slate-3 p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Ключ</div>
              <div class="mt-1 font-semibold text-n-slate-12"><%= key_health[:status].presence || (key_status[:effective_configured] ? 'configured' : 'missing') %></div>
              <div class="text-xs text-n-slate-11">
                Глобальный: <%= key_status[:global_configured] ? 'да' : 'нет' %>, workspace: <%= key_status[:account_configured] ? 'да' : 'нет' %>
              </div>
              <div class="text-xs text-n-slate-10">
                Тип: <%= key_details[:key_type].presence || 'неизвестно' %>, проверен: <%= super_admin_time(key_health[:checked_at]) || 'никогда' %>
              </div>
              <% if key_health[:error].present? %>
                <div class="mt-1 text-xs text-n-ruby-11"><%= key_health[:error] %></div>
              <% end %>
            </div>
            <div class="rounded-md border border-n-weak bg-n-slate-3 p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Кредиты и лимиты</div>
              <% if credits[:status] == 'available' %>
                <div class="mt-1 font-semibold text-n-slate-12">
                  <%= number_with_precision(credits[:remaining_credits].to_f, precision: 2) %> осталось
                </div>
                <div class="text-xs text-n-slate-11">
                  Всего: <%= number_with_precision(credits[:total_credits].to_f, precision: 2) %>, расход: <%= number_with_precision(credits[:total_usage].to_f, precision: 2) %>
                </div>
              <% else %>
                <div class="mt-1 font-semibold text-n-slate-12"><%= credits[:status].presence || 'не проверялось' %></div>
                <div class="text-xs text-n-slate-11"><%= credits[:reason].presence || credits[:error].presence || 'Для синхронизации кредитов нужен management key.' %></div>
              <% end %>
              <div class="text-xs text-n-slate-10">
                Лимит ключа: <%= key_details[:limit].present? ? number_with_precision(key_details[:limit].to_f, precision: 2) : 'нет' %>,
                осталось: <%= key_details[:limit_remaining].present? ? number_with_precision(key_details[:limit_remaining].to_f, precision: 2) : 'неизвестно' %>
              </div>
            </div>
            <div class="rounded-md border border-n-weak bg-n-slate-3 p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Каталог моделей</div>
              <div class="mt-1 font-semibold text-n-slate-12"><%= super_admin_time(catalog[:last_refreshed_at]) || 'никогда' %></div>
              <div class="text-xs text-n-slate-11">Статус: <%= catalog[:refresh_status] || 'неизвестно' %>, источник: <%= catalog[:source] || 'неизвестно' %><%= catalog[:using_fallback] ? ' (fallback)' : '' %></div>
              <% if catalog[:last_started_at].present? %>
                <div class="text-xs text-n-slate-10">Старт: <%= super_admin_time(catalog[:last_started_at]) %></div>
              <% end %>
            </div>
            <div class="rounded-md border border-n-weak bg-n-slate-3 p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Модели</div>
              <div class="mt-1 font-semibold text-n-slate-12"><%= catalog[:total_models] || 0 %> моделей</div>
              <div class="text-xs text-n-slate-11"><%= catalog[:counts_by_type].to_h.map { |type, count| "#{type}: #{count}" }.join(', ') %></div>
              <div class="text-xs text-n-slate-10">Устаревшие: <%= catalog[:stale_models] || 0 %>, отключенные: <%= catalog[:disabled_models] || 0 %></div>
            </div>
            <div class="rounded-md border border-n-weak bg-n-slate-3 p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Endpoints</div>
              <div class="mt-1 font-semibold text-n-slate-12"><%= endpoints[:total_endpoints] || 0 %> endpoint</div>
              <div class="text-xs text-n-slate-11">Статус: <%= endpoints[:refresh_status] || 'неизвестно' %>, провайдеры: <%= Array(endpoints[:providers]).first(5).join(', ').presence || 'нет' %></div>
              <div class="text-xs text-n-slate-10">Устаревшие: <%= endpoints[:stale_endpoints] || 0 %>, ждут refresh: <%= endpoints[:pending_model_count] || 0 %></div>
            </div>
            <div class="rounded-md border border-n-weak bg-n-slate-3 p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Runtime</div>
              <div class="mt-1 font-semibold text-n-slate-12"><%= runtime[:total_events] || 0 %> событий / <%= runtime[:request_count] || 0 %> запросов</div>
              <div class="text-xs text-n-slate-11">Ошибки: <%= runtime[:error_count] || 0 %>, провайдер: <%= runtime[:provider_failure_count] || 0 %></div>
              <div class="text-xs text-n-slate-10">Стоимость: <%= number_with_precision(runtime[:estimated_cost].to_f, precision: 6) %>, последнее: <%= super_admin_time(runtime[:last_event_at]) || 'никогда' %></div>
            </div>
          </div>

          <% if catalog[:last_refresh_error].present? %>
            <div class="mt-3 rounded-md bg-n-ruby-2 px-3 py-2 text-n-ruby-11">Последняя ошибка каталога: <%= catalog[:last_refresh_error] %></div>
          <% end %>
          <% if endpoints[:last_refresh_error].present? %>
            <div class="mt-3 rounded-md bg-n-amber-2 px-3 py-2 text-n-amber-11">Предупреждение обновления endpoints: <%= endpoints[:last_refresh_error] %></div>
          <% end %>

          <div class="mt-4 grid gap-3 md:grid-cols-2">
            <div class="rounded-md border border-n-weak p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Изменения каталога</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% %i[new changed removed capability_changed price_changed].each do |diff_key| %>
                  <% diff_item = catalog_diff.fetch(diff_key, {}).to_h %>
                  <span class="rounded-full bg-n-slate-5 px-2 py-1 text-xs text-n-slate-12"><%= diff_key %>: <%= diff_item[:count] || 0 %></span>
                <% end %>
              </div>
            </div>
            <div class="rounded-md border border-n-weak p-3">
              <div class="text-xs font-medium uppercase text-n-slate-11">Изменения endpoints</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% %i[new changed removed provider_changed price_changed failed_model_ids].each do |diff_key| %>
                  <% diff_item = endpoint_diff.fetch(diff_key, {}).to_h %>
                  <span class="rounded-full bg-n-slate-5 px-2 py-1 text-xs text-n-slate-12"><%= diff_key %>: <%= diff_item[:count] || 0 %></span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-3">
            <div>
              <div class="text-xs font-medium uppercase text-n-slate-11">Возможности моделей</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% catalog[:capability_counts].to_h.each do |capability, count| %>
                  <span class="rounded-full bg-n-slate-5 px-2 py-1 text-xs text-n-slate-12"><%= capability %>: <%= count %></span>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase text-n-slate-11">Endpoint-провайдеры</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% endpoints[:provider_counts].to_h.first(8).each do |provider, count| %>
                  <span class="rounded-full bg-n-slate-5 px-2 py-1 text-xs text-n-slate-12"><%= provider %>: <%= count %></span>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase text-n-slate-11">Runtime-сигналы</div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% runtime[:by_feature].to_h.first(6).each do |feature, count| %>
                  <span class="rounded-full bg-n-slate-5 px-2 py-1 text-xs text-n-slate-12"><%= feature %>: <%= count %></span>
                <% end %>
                <% runtime[:recent_error_codes].to_h.first(4).each do |code, count| %>
                  <span class="rounded-full bg-n-amber-2 px-2 py-1 text-xs text-n-amber-11"><%= code %>: <%= count %></span>
                <% end %>
              </div>
            </div>
            <div>
              <div class="text-xs font-medium uppercase text-n-slate-11">Политика workspace</div>
              <% if workspace_policy[:error].present? %>
                <div class="mt-2 rounded-md bg-n-ruby-2 px-2 py-1 text-xs text-n-ruby-11"><%= workspace_policy[:error] %></div>
              <% else %>
                <% provider_preferences = workspace_policy[:provider_preferences].to_h %>
                <% guardrails = workspace_policy[:guardrails].to_h %>
                <div class="mt-2 text-xs text-n-slate-11">
                  Профиль: <%= workspace_policy[:privacy_profile] %>, workspace: <%= workspace_policy[:workspace] %>
                </div>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% provider_preferences.each do |key, value| %>
                    <span class="rounded-full bg-n-slate-5 px-2 py-1 text-xs text-n-slate-12"><%= key %>: <%= value %></span>
                  <% end %>
                </div>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% guardrails.each do |guardrail_key, guardrail| %>
                    <span class="rounded-full bg-n-slate-3 px-2 py-1 text-xs text-n-slate-11"><%= guardrail_key %>: <%= guardrail.to_h[:status] %></span>
                  <% end %>
                </div>
                <% if guardrails_summary[:status_counts].present? %>
                  <div class="mt-2 text-xs text-n-slate-11">
                    Защита функций: <%= guardrails_summary[:status_counts].to_h.map { |status, count| "#{status}: #{count}" }.join(', ') %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="mt-4">
            <div class="text-xs font-medium uppercase text-n-slate-11">Доступность функций</div>
            <div class="mt-2 grid gap-2 md:grid-cols-2">
              <% features.each do |feature_key, feature| %>
                <% selected_diagnostics = feature.to_h[:selected_model_diagnostics].to_h %>
                <% feature_policy = feature.to_h[:policy].to_h %>
                <% feature_extensions = Array(feature_policy[:extensions]) %>
                <div class="rounded-md border border-n-weak p-2">
                  <div class="font-medium text-n-slate-12"><%= feature_key %></div>
                  <div class="text-xs text-n-slate-11">
                    Доступно: <%= feature.to_h[:available_model_count] || 0 %>, выбрано: <%= feature.to_h[:selected_model].presence || 'нет' %>, default: <%= feature.to_h[:default_model].presence || 'нет' %>
                  </div>
                  <% if feature_policy.present? %>
                    <div class="mt-1 text-xs text-n-slate-11">
                      Политика: cache <%= feature_policy[:cache_policy] || 'disabled' %>, tools <%= Array(feature_policy[:allowed_server_tools]).join(', ').presence || 'blocked' %>, plugins <%= Array(feature_policy[:allowed_plugins]).join(', ').presence || 'blocked' %>
                    </div>
                  <% end %>
                  <% if feature_extensions.present? %>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      <% feature_extensions.each do |extension| %>
                        <% extension = extension.to_h.with_indifferent_access %>
                        <% extension_status = extension[:status].to_s %>
                        <% extension_status_class = extension_status == 'implemented' ? 'border-n-teal-4 bg-n-teal-2 text-n-teal-11' : 'border-n-amber-4 bg-n-amber-2 text-n-amber-11' %>
                        <span class="rounded-full border px-2 py-0.5 text-xs <%= extension_status_class %>">
                          <%= extension_label_map[extension[:product_label_key].to_s] || extension[:product_label_key].to_s.humanize %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                  <% if selected_diagnostics[:allowed] == false && selected_diagnostics[:reason_codes].present? %>
                    <div class="mt-1 text-xs text-n-amber-11">Предупреждение по выбранной модели: <%= selected_diagnostics[:reason_codes].join(', ') %></div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mt-4">
            <div class="text-xs font-medium uppercase text-n-slate-11">Диагностика моделей</div>
            <div class="mt-2 grid gap-2 md:grid-cols-2">
              <% model_eligibility.first(6).each do |model| %>
                <% hidden_reasons = model.to_h[:features].to_h.values.flat_map { |feature| Array(feature[:reason_codes]) }.uniq.first(5) %>
                <div class="rounded-md border border-n-weak p-2">
                  <div class="truncate font-medium text-n-slate-12"><%= model[:display_name] || model[:id] %></div>
                  <div class="truncate text-xs text-n-slate-11"><%= model[:id] %></div>
                  <div class="mt-1 text-xs text-n-slate-11">
                    Тип: <%= model[:type].presence || 'неизвестно' %>, endpoints: <%= model[:endpoint_count] || 0 %>, провайдеры: <%= Array(model[:endpoint_providers]).first(3).join(', ').presence || 'нет' %>
                  </div>
                  <% if hidden_reasons.present? %>
                    <div class="mt-1 text-xs text-n-amber-11">Почему скрыта: <%= hidden_reasons.join(', ') %></div>
                  <% else %>
                    <div class="mt-1 text-xs text-n-teal-11">В sample нет причин скрывать модель</div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mt-5 rounded-md border border-n-weak bg-n-slate-3 p-3">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="text-xs font-medium uppercase text-n-slate-11">Операции</div>
                <div class="mt-1 text-xs text-n-slate-11">
                  Что OpenRouter-слой умеет выполнять из админки сейчас, а что намеренно закрыто до отдельного rollout.
                </div>
              </div>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-n-teal-2 px-2 py-1 text-n-teal-11">
                  готово: <%= Array(admin_operations[:implemented]).size %>
                </span>
                <span class="rounded-full bg-n-amber-2 px-2 py-1 text-n-amber-11">
                  отложено: <%= Array(admin_operations[:deferred]).size %>
                </span>
              </div>
            </div>

            <div class="mt-3 overflow-x-auto">
              <table class="min-w-full divide-y divide-n-weak text-left text-xs">
                <thead class="text-n-slate-11">
                  <tr>
                    <th class="py-2 pr-4 font-medium">Операция</th>
                    <th class="py-2 pr-4 font-medium">Статус</th>
                    <th class="py-2 pr-4 font-medium">Область</th>
                    <th class="py-2 pr-4 font-medium">Возможности</th>
                    <th class="py-2 font-medium">Комментарий</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-n-weak text-n-slate-12">
                  <% openrouter_operations.each do |operation| %>
                    <% operation = operation.to_h.with_indifferent_access %>
                    <% status = operation[:status].to_s %>
                    <% status_label = status == 'implemented' ? 'Готово' : 'Отложено' %>
                    <% status_class = status == 'implemented' ? 'border-n-teal-4 bg-n-teal-2 text-n-teal-11' : 'border-n-amber-4 bg-n-amber-2 text-n-amber-11' %>
                    <tr>
                      <td class="py-2 pr-4 font-medium text-n-slate-12"><%= operation[:title] || operation[:id] %></td>
                      <td class="py-2 pr-4">
                        <span class="rounded-full border px-2 py-0.5 <%= status_class %>"><%= status_label %></span>
                      </td>
                      <td class="py-2 pr-4"><%= operation[:scope].presence || 'superadmin' %></td>
                      <td class="py-2 pr-4"><%= Array(operation[:capabilities]).join(', ').presence || 'нет' %></td>
                      <td class="py-2"><%= operation[:reason].presence || 'Без комментария.' %></td>
                    </tr>
                  <% end %>
                  <% if openrouter_operations.blank? %>
                    <tr>
                      <td colspan="5" class="py-3 text-n-slate-11">Операции OpenRouter пока не описаны.</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <%= button_to 'Проверить ключ и кредиты',
                        refresh_openrouter_key_health_super_admin_app_config_path(config: 'captain'),
                        method: :post,
                        class: 'reset-base inline-flex items-center rounded-md border border-n-strong bg-n-solid-2 px-4 py-2 text-sm font-medium text-n-slate-12 hover:bg-n-alpha-1' %>
          <%= button_to 'Обновить каталог моделей',
                        refresh_openrouter_models_super_admin_app_config_path(config: 'captain'),
                        method: :post,
                        class: 'reset-base inline-flex items-center rounded-lg bg-n-brand-solid px-4 py-2 text-sm font-medium text-n-brand-contrast hover:brightness-110' %>
        </div>
      </div>
    </div>
  <% end %>

  <%= form_with url: super_admin_app_config_url(config: @config) , method: :post do |form| %>
    <% @allowed_configs.each do |key| %>
      <div class="flex mb-8">
        <div class="field-unit__label">
          <%= form.label "app_config[#{key}]", @installation_configs[key]&.dig('display_title') || key %>
        </div>
        <div class="-mt-2 field-unit__field ">
          <% if key == Captain::Assistant::GLOBAL_SYSTEM_PROMPTS_INSTALLATION_CONFIG %>
            <% current_system_prompts = Array(@app_config[key]).map { |entry| entry.respond_to?(:to_h) ? entry.to_h : entry } %>
            <%= form.hidden_field "app_config[#{key}]",
                value: current_system_prompts.to_json,
                id: "app_config_#{key}" %>
            <div
              id="captain-system-prompts-builder"
              class="mt-2 flex flex-col gap-3"
              data-target-input="app_config_<%= key %>"
              data-initial-prompts="<%= h(current_system_prompts.to_json) %>"
            >
              <div data-role="rows" class="flex flex-col gap-3"></div>
              <button
                type="button"
                class="reset-base inline-flex w-fit items-center rounded-md border border-n-weak px-3 py-1.5 text-sm font-medium text-n-slate-12 hover:bg-n-alpha-1 add-captain-system-prompt"
              >
                + Добавить системный промпт
              </button>
              <template>
                <div data-role="prompt-row" class="rounded-lg border border-n-weak bg-n-solid-2 p-4">
                  <div class="mb-3 flex items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-n-slate-12">Системный промпт</p>
                    <button
                      type="button"
                      class="reset-base rounded-md border border-n-ruby-4 px-2 py-1 text-xs font-medium text-n-ruby-11 hover:bg-n-ruby-3 remove-captain-system-prompt"
                    >
                      Удалить
                    </button>
                  </div>
                  <input type="hidden" data-field="id" />
                  <div class="mb-3">
                    <label class="mb-1 block text-xs font-medium text-n-slate-11">Группа</label>
                    <input
                      type="text"
                      data-field="group"
                      class="w-full rounded-md border border-n-weak px-2 py-1.5 text-sm"
                      placeholder="Строгие правила"
                    />
                  </div>
                  <div class="mb-3">
                    <label class="mb-1 block text-xs font-medium text-n-slate-11">Текст промпта</label>
                    <textarea
                      data-field="content"
                      rows="5"
                      class="w-full rounded-md border border-n-weak px-2 py-1.5 font-mono text-xs"
                      placeholder="Введите текст системного промпта"
                    ></textarea>
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-n-slate-11">Слот (опционально)</label>
                    <input
                      type="text"
                      data-field="slot"
                      class="w-full rounded-md border border-n-weak px-2 py-1.5 text-sm"
                      placeholder="assistant_system_context"
                    />
                  </div>
                </div>
              </template>
            </div>
          <% elsif @installation_configs[key]&.dig('type') == 'boolean' %>
            <%= form.select "app_config[#{key}]",
              [["True", true], ["False", false]],
              { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) },
              class: "mt-2 border border-n-weak p-1 rounded-md"
            %>
          <% elsif @installation_configs[key]&.dig('type') == 'code' %>
            <%= form.text_area "app_config[#{key}]",
                value: @app_config[key],
                rows: 12,
                wrap: 'off',
                class: "mt-2 border font-mono text-xs border-n-weak p-1 rounded-md overflow-scroll"
            %>
          <% elsif @installation_configs[key]&.dig('type') == 'secret' %>
            <% mask_secret_value = masked_secret_config?(key) && @app_config[key].present? %>
            <div class="relative">
              <%= form.password_field "app_config[#{key}]",
                  id: "app_config_#{key}",
                  value: mask_secret_value ? nil : @app_config[key],
                  placeholder: mask_secret_value ? 'Configured — leave blank to keep current key' : nil,
                  class: "mt-2 border border-n-weak p-1.5 pr-8 rounded-md w-full"
              %>
              <button
                type="button"
                class="absolute reset-base !bg-n-solid-2 top-1/2 !outline-0 !text-n-slate-11 -translate-y-1/2 right-2 p-1 hover:!bg-n-slate-5 rounded-sm toggle-password"
                data-target="app_config_<%= key %>"
              >
                <svg class="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                  <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                </svg>
              </button>
            </div>
          <% elsif @installation_configs[key]&.dig('type') == 'select' && @installation_configs[key]&.dig('options').present? %>
            <%= form.select "app_config[#{key}]",
              @installation_configs[key]['options'].map { |val, label| [label, val] },
              { selected: @app_config[key] },
              class: "mt-2 border border-n-weak p-1 rounded-md"
            %>
        <% else %>
          <%= form.text_field "app_config[#{key}]", value: @app_config[key] %>
        <% end %>
          <%if @installation_configs[key]&.dig('description').present? %>
            <p class="pt-2 text-xs italic text-n-slate-10">
              <%= @installation_configs[key]&.dig('description') %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="form-actions">
      <%= form.submit "Сохранить настройки" %>
    </div>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;

        // Toggle icon
        const svg = button.querySelector('.eye-icon');
        if (type === 'password') {
          svg.classList.remove('eye-hide')
        } else {
          svg.classList.add('eye-hide')
        }
      });
    });

    const builder = document.getElementById('captain-system-prompts-builder');
    if (!builder) return;

    const hiddenInput = document.getElementById(builder.dataset.targetInput);
    const rowsContainer = builder.querySelector('[data-role="rows"]');
    const template = builder.querySelector('template');
    const addButton = builder.querySelector('.add-captain-system-prompt');
    const nextPromptId = () => `system_prompt_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

    const syncRows = () => {
      const prompts = [...rowsContainer.querySelectorAll('[data-role="prompt-row"]')]
        .map(row => ({
          id: row.querySelector('[data-field="id"]').value || nextPromptId(),
          type: 'system',
          group: row.querySelector('[data-field="group"]').value.trim(),
          content: row.querySelector('[data-field="content"]').value.trim(),
          slot: row.querySelector('[data-field="slot"]').value.trim() || null,
        }))
        .filter(prompt => prompt.content);

      hiddenInput.value = JSON.stringify(prompts);
    };

    const bindRow = row => {
      row.querySelectorAll('[data-field]').forEach(field => {
        field.addEventListener('input', syncRows);
      });
      row.querySelector('.remove-captain-system-prompt').addEventListener('click', () => {
        row.remove();
        syncRows();
      });
    };

    const addRow = prompt => {
      const fragment = template.content.cloneNode(true);
      const row = fragment.querySelector('[data-role="prompt-row"]');
      row.querySelector('[data-field="id"]').value = prompt.id || nextPromptId();
      row.querySelector('[data-field="group"]').value = prompt.group || '';
      row.querySelector('[data-field="content"]').value = prompt.content || '';
      row.querySelector('[data-field="slot"]').value = prompt.slot || '';
      bindRow(row);
      rowsContainer.appendChild(fragment);
      syncRows();
    };

    let initialPrompts = [];
    try {
      initialPrompts = JSON.parse(builder.dataset.initialPrompts || '[]');
    } catch (error) {
      initialPrompts = [];
    }

    if (!initialPrompts.length) {
      addRow({ group: 'Strict rules', content: '', slot: '' });
    } else {
      initialPrompts.forEach(addRow);
    }

    addButton.addEventListener('click', () => addRow({ group: 'Strict rules', content: '', slot: '' }));
    builder.closest('form')?.addEventListener('submit', syncRows);
  });
  </script>
<% end %>
