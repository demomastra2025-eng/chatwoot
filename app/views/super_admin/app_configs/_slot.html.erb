<%#
# A card of an AI setting that is not a model

A key (only «задан» / «не задан»: a secret is never printed), the token limit, the address of OpenRouter, an instruction
for the agents or the builder of the rules of the platform: the Russian title and a one-line explanation, the control, what
is in force, and the error of the last save when it was refused. The technical name of the setting shows only under
«Показать технические имена».

## Local variables:

- `slot`: a `SuperAdmin::AiModelsPage::Slot`.
%>
<%
  scope = 'super_admin.app_config.captain'
  slot_scope = "#{scope}.status"
  configured = slot.configured
  field_id = "app_config_#{slot.key}"
  builtin = slot.default_items.join(', ').presence
%>

<div class="admin-slot <%= 'admin-slot--wide' if slot.wide? %> <%= 'admin-slot--invalid' if slot.invalid? %>" data-config="<%= slot.key %>" data-source="<%= configured ? 'set' : 'default' %>">
  <div class="admin-slot__head">
    <label class="admin-slot__title" for="<%= field_id %>"><%= slot.title %></label>
    <% if slot.secret? %>
      <span class="admin-badge <%= configured ? 'admin-badge--teal' : 'admin-badge--quiet' %>" data-testid="slot-source"><%= t("super_admin.app_config.captain.slot.#{configured ? 'secret_set' : 'secret_unset'}") %></span>
    <% elsif slot.editor != :prompts %>
      <span class="admin-badge admin-badge--amber" data-unsaved-badge hidden><%= t("#{slot_scope}.unsaved") %></span>
    <% end %>
  </div>

  <% if slot.hint.present? %>
    <p class="admin-slot__hint"><%= slot.hint %></p>
  <% end %>

  <div>
    <%= render 'editor', key: slot.key, kind: slot.editor, value: slot.input, masked: slot.secret? && configured,
                         placeholder: builtin, show_state: false %>
  </div>

  <% if slot.editor == :number %>
    <p class="admin-slot__status" data-testid="slot-status"><%= configured ? t("#{slot_scope}.number_set", count: slot.value.to_s.to_i) : t("#{slot_scope}.no_limit") %></p>
  <% elsif slot.key == 'CAPTAIN_OPENROUTER_ENDPOINT' %>
    <p class="admin-slot__status" data-testid="slot-status"><%= configured ? t("#{slot_scope}.endpoint_set") : t("#{slot_scope}.builtin", name: builtin) %></p>
  <% end %>

  <%= render 'ai_slot_errors', slot: slot %>
  <p class="admin-field__key" data-tech-name><%= slot.key %></p>
</div>
