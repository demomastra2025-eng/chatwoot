<%#
# A card of a model setting

One function of the platform and the model it uses: the title and a one-line explanation, the list to pick the model from,
what is in force («Используется встроенная: …» or «Выбрано: … — Вернуть встроенную»), what it was before the last
change («Было: …, изменил … — Вернуть», from the audit log), and the error of the last save, if it was refused. The
technical name of the setting shows only under «Показать технические имена».

## Local variables:

- `slot`: a `SuperAdmin::AiModelsPage::Slot` of a model setting.
%>
<%
  scope = 'super_admin.app_config.captain'
  choices = slot.choices
  # the name the lists use: an old spelling of a model (`claude-sonnet-4.6`) is the same model as `claude-sonnet-4-6`
  stored = Llm::Models.canonical_model_name(slot.value.to_s.strip)
  previous = slot.previous
%>
<div class="admin-slot <%= 'admin-slot--invalid' if slot.invalid? %>" data-config="<%= slot.key %>" data-source="<%= slot.configured ? 'set' : 'default' %>">
  <div class="admin-slot__head">
    <label class="admin-slot__title" for="app_config_<%= slot.key %>" id="label_<%= slot.key %>"><%= slot.title %></label>
    <span class="admin-badge admin-badge--amber" data-unsaved-badge hidden><%= t("#{scope}.status.unsaved") %></span>
  </div>

  <% if slot.hint.present? %>
    <p class="admin-slot__hint"><%= slot.hint %></p>
  <% end %>

  <%= render 'ai_model_select', slot: slot %>

  <% if choices.missing && choices.missing.id == stored %>
    <p class="admin-slot__warn" data-testid="slot-missing">
      <%= t("#{scope}.models.missing_hint_#{choices.missing.reason}") %>
    </p>
  <% end %>

  <p class="admin-slot__status" data-testid="slot-status">
    <% if stored.blank? %>
      <%= choices.builtin_id.present? ? t("#{scope}.status.builtin", name: choices.builtin_name) : t("#{scope}.models.not_configured") %>
    <% else %>
      <%= t("#{scope}.status.chosen", name: ai_model_name(stored)) %>
      <button type="button" class="admin-link-button reset-base" data-revert="<%= slot.key %>" data-revert-value="" hidden><%= t("#{scope}.status.#{choices.builtin_id.present? ? 'revert_builtin' : 'clear_model'}") %></button>
    <% end %>
  </p>

  <% if previous %>
    <p class="admin-slot__history" data-testid="slot-history">
      <% name = ai_model_name(previous.value, builtin: choices.builtin_id.present?) %>
      <% when_text = SuperAdmin::DisplayHelper.format_time(previous.at) %>
      <%= previous.actor.present? ? t("#{scope}.status.was", name: name, who: previous.actor, when: when_text) : t("#{scope}.status.was_no_actor", name: name, when: when_text) %>
      <button type="button" class="admin-link-button reset-base" data-revert="<%= slot.key %>" data-revert-value="<%= previous.value %>" hidden><%= t("#{scope}.status.revert") %></button>
    </p>
  <% end %>

  <%= render 'ai_slot_errors', slot: slot %>
  <p class="admin-field__key" data-tech-name><%= slot.key %></p>
</div>
