<%#
# Account User Form Partial

This partial renders the account user creation form.
Used by both account and user show pages.

## Local variables:

- `page`: The Administrate page object (Account or User)
- `namespace`: The current namespace (usually :super_admin)
- `resource_type`: Either 'account' or 'user' to determine hidden field
- `embedded` (optional): true when the form sits inside a block of the page
  (the clinic card): no outer section, no card, no title.
%>

<% embedded = local_assigns.fetch(:embedded, false) %>
<% account_user_page = Administrate::Page::Form.new(AccountUserDashboard.new, AccountUser.new) %>

<%= content_tag(embedded ? :div : :section, class: ('main-content__body' unless embedded)) do %>
  <%= form_for([namespace, account_user_page.resource], html: { class: (embedded ? 'form flex flex-col gap-4' : 'form admin-card max-w-3xl') }) do |f| %>
    <% unless embedded %>
      <h2 class="admin-card__title">
        <%= resource_type == 'account' ? t('super_admin.shell.add_user_to_account') : t('super_admin.shell.add_to_account') %>
      </h2>
    <% end %>

    <div class="<%= embedded ? 'flex flex-col' : 'px-5 pb-0 pt-5' %>">
      <% if account_user_page.resource.errors.any? %>
        <div id="error_explanation" role="alert" class="mb-5 rounded-xl bg-n-ruby-2 px-4 py-3 text-sm text-n-ruby-11 outline outline-1 -outline-offset-1 outline-n-ruby-4">
          <h3 class="m-0 text-heading-3 text-n-ruby-11">
            <%= t(
              "administrate.form.errors",
              count: account_user_page.resource.errors.count,
              pluralized_errors: pluralize(
                account_user_page.resource.errors.count,
                t("administrate.form.error")
              ),
              resource_name: display_resource_name(account_user_page.resource_name)
            ) %>
          </h3>

          <ul class="mt-1 list-disc ps-5">
            <% account_user_page.resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% account_user_page.attributes.each do |title, attributes| -%>
        <% attributes.each do |attribute| %>
          <% if attribute.name == resource_type %>
            <%= f.hidden_field("#{resource_type}_id", value: page.resource.id) %>
          <% else %>
            <div class="field-unit field-unit--<%= attribute.html_class %> field-unit--<%= requireness(attribute) %>">
              <%= render_field attribute, f: f %>
            </div>
          <% end %>
        <% end %>
      <% end -%>
    </div>

    <div class="<%= embedded ? 'form-actions' : 'form-actions border-t border-n-weak px-5 py-4' %>">
      <%= f.submit t("super_admin.shell.add") %>
    </div>
  <% end %>
<% end %>
