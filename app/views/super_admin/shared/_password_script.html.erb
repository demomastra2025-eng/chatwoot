<%#
# The script of the password field of a new person

Works for every `data-password-widget` on the page (it runs once, however many times the partial is drawn):

* «Сгенерировать» (`data-password-generate`) fills the field with a random password that follows the rules: a capital and a small
  Latin letter, a digit and a special character, 14 characters, without the letters and digits that look alike;
* «Скопировать» (`data-password-copy`) copies the field of its widget, or the field named in `data-copy-from`;
* the rules under the field (`data-rule`) get a tick while the password follows them (the same rules as
  SuperAdmin::PasswordRules, whose lengths and special characters come in the data attributes of the widget).

The buttons are drawn hidden and shown by this script, so without JavaScript there is no button that does nothing. The tick
icons (`i-lucide-check`, `i-lucide-circle`) are named here because the icon styles are built from the names found in the views.
%>
<script>
  (function () {
    if (window.adminPasswordWidget) return;
    window.adminPasswordWidget = true;

    var UPPER = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
    var LOWER = 'abcdefghijkmnpqrstuvwxyz';
    var DIGITS = '23456789';
    var SPECIAL = '!@#$%*+=-';
    var LENGTH = 14;

    // An unbiased random index below `limit` from the random numbers of the browser
    function randomBelow(limit) {
      var values = new Uint32Array(1);
      var ceiling = Math.floor(4294967296 / limit) * limit;
      do { window.crypto.getRandomValues(values); } while (values[0] >= ceiling);
      return values[0] % limit;
    }

    function pick(set) { return set.charAt(randomBelow(set.length)); }

    function generate() {
      var all = UPPER + LOWER + DIGITS + SPECIAL;
      var chars = [pick(UPPER), pick(LOWER), pick(DIGITS), pick(SPECIAL)];
      while (chars.length < LENGTH) chars.push(pick(all));
      for (var i = chars.length - 1; i > 0; i -= 1) {
        var j = randomBelow(i + 1);
        var swap = chars[i];
        chars[i] = chars[j];
        chars[j] = swap;
      }
      return chars.join('');
    }

    function followed(rule, password, widget) {
      var specials = widget.getAttribute('data-specials') || '';
      if (rule === 'length') {
        return password.length >= Number(widget.getAttribute('data-min-length')) && password.length <= Number(widget.getAttribute('data-max-length'));
      }
      if (rule === 'uppercase') return /[A-Z]/.test(password);
      if (rule === 'lowercase') return /[a-z]/.test(password);
      if (rule === 'number') return /[0-9]/.test(password);
      return password.split('').some(function (char) { return specials.indexOf(char) !== -1; });
    }

    function showRules(widget) {
      var input = widget.querySelector('[data-password-input]');
      if (!input) return;
      widget.querySelectorAll('[data-rule]').forEach(function (item) {
        var ok = followed(item.getAttribute('data-rule'), input.value, widget);
        item.setAttribute('data-state', ok ? 'ok' : 'todo');
        var icon = item.querySelector('.admin-rule__icon');
        if (icon) {
          icon.classList.toggle('i-lucide-check', ok);
          icon.classList.toggle('i-lucide-circle', !ok);
        }
      });
    }

    function copyText(text, done) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () {});
        return;
      }
      var scratch = document.createElement('textarea');
      scratch.value = text;
      document.body.appendChild(scratch);
      scratch.select();
      try { if (document.execCommand('copy')) done(); } catch (error) { /* nothing to do: the field stays selected */ }
      document.body.removeChild(scratch);
    }

    document.addEventListener('click', function (event) {
      var button = event.target.closest ? event.target.closest('[data-password-generate], [data-password-copy]') : null;
      if (!button) return;
      var widget = button.closest('[data-password-widget]');
      var source = button.getAttribute('data-copy-from');
      var input = source ? document.getElementById(source) : (widget && widget.querySelector('[data-password-input]'));
      if (!input) return;

      if (button.hasAttribute('data-password-generate')) {
        input.value = generate();
        input.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      input.select();
      copyText(input.value, function () {
        var label = button.textContent;
        button.textContent = button.getAttribute('data-copied') || label;
        window.setTimeout(function () { button.textContent = label; }, 2000);
      });
    });

    document.addEventListener('input', function (event) {
      var widget = event.target.closest ? event.target.closest('[data-password-widget]') : null;
      if (widget) showRules(widget);
    });

    function reveal() {
      document.querySelectorAll('[data-password-generate], [data-password-copy]').forEach(function (button) { button.hidden = false; });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal);
    else reveal();
  })();
</script>
