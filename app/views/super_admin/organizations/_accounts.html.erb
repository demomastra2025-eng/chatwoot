<%#
# «Аккаунты» of an organization

The accounts that belong to the organization, 25 to a page (`accounts_page`): name (a link to the account), plan chips,
operators used / limit, channels and status, with «Отвязать» per row (asks first; the account itself stays as it is) and a
totals row that adds up ALL the accounts of the organization, not only the ones on the page (grouped SQL, see
`SuperAdmin::OrganizationAccountsPage`). Below the table, «Привязать аккаунт»: a search field (a part of the name, or
#number) and a select with at most 20 of the accounts that have no organization yet. The search is a GET on the card.

## Local variables:

- `organization`: the Organization.
%>
<%
  block = SuperAdmin::OrganizationAccountsPage.new(organization, page: params[:accounts_page], search: params[:account_search])
  rows = block.rows
  totals = block.totals
  status_tones = { active: 'teal', suspended: 'amber', deleting: 'ruby' }
%>

<section class="admin-card" aria-labelledby="organization-accounts-title" data-testid="accounts-block">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-n-weak px-5 py-4">
    <h2 class="m-0 text-heading-2 text-n-slate-12" id="organization-accounts-title"><%= t('super_admin.organizations.card.accounts.title') %></h2>
    <span class="text-xs tabular-nums text-n-slate-11"><%= t('super_admin.organizations.card.accounts.total', count: totals.accounts) %></span>
  </div>

  <div class="admin-card--table">
    <table aria-labelledby="organization-accounts-title">
      <thead>
        <tr>
          <th scope="col"><%= t('super_admin.accounts.columns.clinic') %></th>
          <th scope="col"><%= t('super_admin.accounts.columns.plan') %></th>
          <th scope="col" class="cell-label--number"><%= t('super_admin.accounts.columns.operators') %></th>
          <th scope="col" class="cell-label--number"><%= t('super_admin.accounts.columns.channels') %></th>
          <th scope="col"><%= t('super_admin.accounts.columns.status') %></th>
          <th scope="col"><span class="sr-only"><%= t('super_admin.accounts.columns.actions') %></span></th>
        </tr>
      </thead>

      <tbody>
        <% if rows.empty? %>
          <tr>
            <td colspan="6" class="py-8 text-center text-n-slate-11"><%= t('super_admin.organizations.card.accounts.empty') %></td>
          </tr>
        <% end %>

        <% rows.each do |account, row| %>
          <tr data-account-id="<%= account.id %>">
            <td>
              <%= link_to account.name, super_admin_account_path(account), class: 'font-medium text-n-slate-12 hover:text-n-brand' %>
              <div class="text-xs tabular-nums text-n-slate-10">#<%= account.id %></div>
            </td>

            <td>
              <div class="flex flex-wrap items-center gap-1.5">
                <% row.plan.chips.each do |chip| %>
                  <span class="admin-badge admin-badge--<%= chip.tone %>"><%= chip.text %></span>
                <% end %>
                <% if row.plan.drifted? %>
                  <span class="text-xs text-n-amber-11" title="<%= t('super_admin.plans.drift.title') %>"><%= t('super_admin.plans.drift.short') %></span>
                <% end %>
              </div>
            </td>

            <td class="cell-data--number whitespace-nowrap">
              <% if row.operators_unlimited? %>
                <span class="tabular-nums"><%= super_admin_number(row.operators_used) %></span>
                <span class="text-xs text-n-slate-10"><%= t('super_admin.accounts.list.no_limit') %></span>
              <% else %>
                <span class="tabular-nums <%= 'text-n-ruby-11 font-medium' if row.operators_used > row.operators_limit %>"><%= super_admin_number(row.operators_used) %></span>
                <span class="text-n-slate-10">/ <%= super_admin_number(row.operators_limit) %></span>
              <% end %>
            </td>

            <td class="cell-data--number tabular-nums"><%= super_admin_number(row.channels) %></td>

            <td>
              <span class="admin-badge admin-badge--<%= status_tones.fetch(row.status) %>"><%= row.plan.status_label %></span>
            </td>

            <td class="text-end">
              <%= button_to t('super_admin.organizations.card.accounts.unlink'), unlink_account_super_admin_organization_path(organization),
                            method: :delete, params: { account_id: account.id },
                            class: 'button button--small button--alt', form_class: 'inline-block',
                            data: { confirm: t('super_admin.organizations.card.accounts.unlink_confirm', account: account.name, organization: organization.name) } %>
            </td>
          </tr>
        <% end %>
      </tbody>

      <% if totals.accounts.positive? %>
        <tfoot>
          <tr data-testid="accounts-totals">
            <th scope="row" class="font-medium"><%= t(block.paginated? ? 'super_admin.organizations.card.accounts.totals_all' : 'super_admin.organizations.card.accounts.totals') %></th>
            <td></td>
            <td class="cell-data--number whitespace-nowrap font-medium">
              <span class="tabular-nums"><%= super_admin_number(totals.operators_used) %></span>
              <% if totals.operators_limit %>
                <span class="font-normal text-n-slate-10">/ <%= super_admin_number(totals.operators_limit) %></span>
              <% end %>
            </td>
            <td class="cell-data--number font-medium tabular-nums"><%= super_admin_number(totals.channels) %></td>
            <td></td>
            <td></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>

  <% if block.paginated? %>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-n-weak px-5 pb-4 pt-3 text-xs text-n-slate-11 [&_.pagination]:mt-0" data-testid="accounts-pager">
      <span class="tabular-nums"><%= t('super_admin.organizations.card.accounts.page', current: block.accounts.current_page, total: block.accounts.total_pages) %></span>
      <%= paginate block.accounts, param_name: :accounts_page %>
    </div>
  <% end %>

  <div class="flex flex-col gap-3 border-t border-n-weak px-5 py-4" data-testid="link-account">
    <% if block.free_accounts? %>
      <%# The search is a GET on the card: the picker below shows the 20 matches at most, however many accounts are free. %>
      <%= form_with url: super_admin_organization_path(organization), method: :get, local: true, class: 'flex flex-wrap items-end gap-3', data: { testid: 'link-account-search' } do %>
        <div class="flex min-w-0 flex-1 basis-64 flex-col gap-1.5">
          <%= label_tag :account_search, t('super_admin.organizations.card.accounts.search_label'), class: 'text-xs text-n-slate-11' %>
          <%= search_field_tag :account_search, block.search, placeholder: t('super_admin.organizations.card.accounts.search_placeholder'),
                               maxlength: SuperAdmin::OrganizationAccountsPage::SEARCH_LENGTH, autocomplete: 'off' %>
        </div>
        <%= submit_tag t('super_admin.organizations.card.accounts.search'), name: nil, class: 'button button--secondary' %>
      <% end %>

      <% if block.candidates.empty? %>
        <p class="admin-block__note" data-testid="no-matches"><%= t('super_admin.organizations.card.accounts.no_matches') %></p>
      <% else %>
        <%= form_with url: link_account_super_admin_organization_path(organization), method: :post, local: true, class: 'flex flex-wrap items-end gap-3' do %>
          <div class="flex min-w-0 flex-1 basis-64 flex-col gap-1.5">
            <%= label_tag :account_id, t('super_admin.organizations.card.accounts.link_label'), class: 'text-xs text-n-slate-11' %>
            <%= select_tag :account_id, options_for_select(block.candidates), prompt: t('super_admin.organizations.card.accounts.link_prompt'), required: true %>
          </div>
          <%= submit_tag t('super_admin.organizations.card.accounts.link'), name: nil %>
        <% end %>
        <% if block.more_candidates? %>
          <p class="admin-block__note" data-testid="more-matches"><%= t('super_admin.organizations.card.accounts.more_matches', count: SuperAdmin::OrganizationAccountsPage::CANDIDATES) %></p>
        <% end %>
      <% end %>
    <% else %>
      <p class="admin-block__note"><%= t('super_admin.organizations.card.accounts.none_to_link') %></p>
    <% end %>
  </div>
</section>
