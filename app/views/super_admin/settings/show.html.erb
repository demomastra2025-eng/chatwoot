<%#
# Instance settings

The identifier of this installation and the functions of the platform: which
ones are on in this installation and a link to the settings of the ones that
have a config page. OneLink has no editions to upgrade to, so a function that is
not available is only marked as such.
%>
<% content_for(:title) { t('super_admin.settings.title') } %>

<header class="main-content__header" role="banner">
  <div class="main-content__heading">
    <h1 class="main-content__page-title" id="page-title"><%= content_for(:title) %></h1>
    <p class="main-content__description"><%= t('super_admin.settings.description') %></p>
  </div>
</header>

<section class="main-content__body">
  <div class="flex flex-col gap-6">
    <section class="admin-block" aria-labelledby="installation-title" data-testid="installation-block">
      <div class="admin-block__head">
        <h2 class="admin-block__title" id="installation-title"><%= t('super_admin.settings.installation_identifier') %></h2>
        <p class="admin-block__hint"><%= t('super_admin.settings.identifier_hint') %></p>
      </div>
      <%= javascript_include_tag "secretField" %>
      <%# The buttons must stay direct children of the element: secretField.js reads `parentElement`. %>
      <div data-secret-text="<%= ChatwootHub.installation_identifier %>" class="cell-data__secret-field flex items-center gap-1 text-sm text-n-slate-11">
        <span data-secret-masked="true" class="select-none"></span>
        <button type="button" onclick="toggleSecretField(event)" data-secret-toggler aria-label="<%= t('super_admin.settings.show_secret') %>" class="reset-base">
          <svg width="20" height="20" class="size-5 fill-current" aria-hidden="true">
            <use xlink:href="#eye-show" />
          </svg>
        </button>
        <button type="button" onclick="copySecretField(event)" data-secret-copier aria-label="<%= t('super_admin.settings.copy') %>" class="reset-base">
          <svg width="20" height="20" class="size-5 fill-current" aria-hidden="true">
            <use xlink:href="#icon-copy" />
          </svg>
        </button>
      </div>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="features-title" data-testid="features-block">
      <div class="admin-block__head">
        <h2 class="admin-block__title" id="features-title"><%= t('super_admin.settings.features') %></h2>
        <p class="admin-block__hint"><%= t('super_admin.settings.features_hint') %></p>
      </div>

      <div class="admin-feature-grid">
        <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
          <% enabled = attrs[:enabled] %>
          <div class="admin-feature" data-feature="<%= feature %>" data-enabled="<%= enabled ? 'true' : 'false' %>">
            <div class="admin-feature__head">
              <span class="admin-feature__icon">
                <svg width="20" height="20" aria-hidden="true"><use xlink:href="#<%= attrs[:icon] %>" /></svg>
              </span>
              <span class="admin-badge <%= enabled ? 'admin-badge--teal' : 'admin-badge--quiet' %>">
                <%= enabled ? t('super_admin.settings.feature_enabled') : t('super_admin.settings.feature_unavailable') %>
              </span>
            </div>
            <h3 class="admin-feature__title"><%= feature_label(attrs, feature) %></h3>
            <p class="admin-feature__text"><%= feature_description(feature, attrs) %></p>
            <% if attrs[:config_key].present? && enabled %>
              <%= link_to t('super_admin.settings.configure'), super_admin_app_config_path(config: attrs[:config_key]),
                          class: 'button button--small button--secondary w-fit' %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</section>
