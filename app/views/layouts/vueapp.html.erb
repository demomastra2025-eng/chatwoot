<% auth_page_scrollable = @application_pack == 'v3app' %>
<!DOCTYPE html>
<html class="w-full <%= auth_page_scrollable ? 'auth-page-scrollable' : 'h-full overflow-hidden' %>">
  <head>
    <title>OneLink</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <% if @global_config['DISPLAY_MANIFEST'] %>
      <meta name="msapplication-TileColor" content="#1A1A1A">
      <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
      <meta name="theme-color" content="#1A1A1A">
      <meta name="description" content="<%= @global_config['INSTALLATION_NAME'] %> это решение для поддержки клиентов, которое помогает компаниям взаимодействовать с клиентами через Messenger, Twitter, Telegram и WhatsApp. Просто подключите свои каналы и общайтесь с клиентами из одного места. Легко добавляйте новых операторов в систему и поручайте им вести и решать вопросы клиентов. <%= @global_config['INSTALLATION_NAME'] %> кроме того, система предоставляет отчеты в режиме реального времени для оценки эффективности работы вашей команды, готовые шаблоны ответов для быстрого реагирования на часто задаваемые вопросы, а также личные заметки, позволяющие операторам обмениваться информацией между собой.">
      <% if ENV['IOS_APP_IDENTIFIER'].present? %>
        <meta name="apple-itunes-app" content='app-id=<%= ENV['IOS_APP_IDENTIFIER'] %>'>
      <% end %>
      <link rel="icon" href="/favicon.ico?v=onelink-brand">
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=onelink-brand">
      <link rel="shortcut icon" href="/favicon-32x32.png?v=onelink-brand">
      <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=onelink-brand">
      <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=onelink-brand">
      <link rel="manifest" href="/manifest.json">
    <% end %>
    <link rel="icon" href="/favicon.ico?v=onelink-brand">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=onelink-brand">
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=onelink-brand">
    <%= csrf_meta_tags %>
    <script>
      window.chatwootConfig = {
        hostURL: '<%= ENV.fetch('FRONTEND_URL', '') %>',
        helpCenterURL: '<%= ENV.fetch('HELPCENTER_URL', '') %>',
        fbAppId: '<%= @global_config['FB_APP_ID'] %>',
        instagramAppId: '<%= @global_config['INSTAGRAM_APP_ID'] %>',
        tiktokAppId: '<%= @global_config['TIKTOK_APP_ID'] %>',
        slackConfigured: <%= @global_config['SLACK_CONFIGURED'].to_json.html_safe %>,
        twitterConfigured: <%= @global_config['TWITTER_CONFIGURED'].to_json.html_safe %>,
        googleOAuthClientId: '<%= ENV.fetch('GOOGLE_OAUTH_CLIENT_ID', nil) %>',
        googleOAuthCallbackUrl: '<%= ENV.fetch('GOOGLE_OAUTH_CALLBACK_URL', nil) %>',
        allowedLoginMethods: <%= @global_config['ALLOWED_LOGIN_METHODS'].to_json.html_safe %>,
        fbApiVersion: '<%= @global_config['FACEBOOK_API_VERSION'] %>',
        whatsappAppId: '<%= @global_config['WHATSAPP_APP_ID'] %>',
        whatsappConfigurationId: '<%= @global_config['WHATSAPP_CONFIGURATION_ID'] %>',
        whatsappApiVersion: '<%= @global_config['WHATSAPP_API_VERSION'] %>',
        whatsappProactiveReauthorizationEnabled: <%= @global_config['WHATSAPP_PROACTIVE_REAUTHORIZATION_ENABLED'].to_json.html_safe %>,
        signupEnabled: '<%= @global_config['ENABLE_ACCOUNT_SIGNUP'] %>',
        isEnterprise: '<%= @global_config['IS_ENTERPRISE'] %>',
        isMfaEnabled: '<%= Chatwoot.mfa_enabled? %>',
        <% if @global_config['IS_ENTERPRISE'] %>
        enterprisePlanName: '<%= @global_config['INSTALLATION_PRICING_PLAN'] %>',
        <% end %>
        <% if @global_config['VAPID_PUBLIC_KEY'] %>
        vapidPublicKey: new Uint8Array(<%= Base64.urlsafe_decode64(@global_config['VAPID_PUBLIC_KEY']).bytes %>),
        <% end %>
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        helpUrls: <%= feature_help_urls.to_json.html_safe %>,
        selectedLocale: '<%= I18n.locale %>'
      }
      window.globalConfig = <%= raw @global_config.to_json %>
      window.browserConfig = {
        browser_name: '<%= browser.name %>',
      }
      window.errorLoggingConfig = '<%= ENV['SENTRY_FRONTEND_DSN'].presence || ENV['SENTRY_DSN'].presence || '' %>'
    </script>
    <% if @global_config['CLOUD_ANALYTICS_TOKEN'].present? %>
    <script>
      window.analyticsConfig = {
        token: '<%= @global_config['CLOUD_ANALYTICS_TOKEN'] %>',
      }
    </script>
    <% end %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag @application_pack %>
  </head>
  <body class="w-full <%= auth_page_scrollable ? 'auth-page-scrollable' : 'h-full overflow-hidden' %> text-slate-600">
    <div id="app"></div>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <%= yield %>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
