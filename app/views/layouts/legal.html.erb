<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for?(:title) ? "#{content_for(:title)} | OneLink" : 'OneLink' %></title>
    <link rel="icon" href="/favicon.ico?v=onelink-brand">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=onelink-brand">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=onelink-brand">
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f5f5f5;
        color: #111111;
      }
      .page {
        max-width: 960px;
        margin: 0 auto;
        padding: 32px 20px 56px;
      }
      .card {
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 8px 30px rgba(17, 17, 17, 0.06);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #111111;
        text-decoration: none;
        font-weight: 700;
      }
      .brand img {
        width: 40px;
        height: 40px;
      }
      .meta {
        color: #525252;
        margin-top: 8px;
        margin-bottom: 24px;
      }
      .locale-nav {
        display: flex;
        gap: 12px;
        margin: 16px 0 24px;
        flex-wrap: wrap;
      }
      .locale-nav a {
        color: #525252;
        text-decoration: none;
      }
      .locale-nav a.active {
        color: #111111;
        font-weight: 600;
      }
      h1, h2 {
        color: #111111;
      }
      h1 {
        font-size: 32px;
        margin-bottom: 8px;
      }
      h2 {
        margin-top: 28px;
        margin-bottom: 10px;
        font-size: 20px;
      }
      p, li {
        color: #262626;
        line-height: 1.7;
      }
      ul {
        padding-left: 20px;
      }
      a {
        color: #111111;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #111111;
          color: #f5f5f5;
        }
        .card {
          background: #1c1c1c;
          border-color: #2a2a2a;
          box-shadow: none;
        }
        .brand, .brand a, h1, h2, a {
          color: #f5f5f5;
        }
        .meta, .locale-nav a, p, li {
          color: #d4d4d4;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <%= yield %>
    </div>
  </body>
</html>
