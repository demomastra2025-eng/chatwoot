backend: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} ACTIVE_JOB_QUEUE_ADAPTER=${ACTIVE_JOB_QUEUE_ADAPTER:-sidekiq} bin/rails s -b 0.0.0.0 -p ${PORT:-3002}
worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} SIDEKIQ_CONCURRENCY=${SIDEKIQ_CONCURRENCY:-5} ENABLE_SIDEKIQ_CRON=${ENABLE_SIDEKIQ_CRON:-false} DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq.yml
telegram_personal_history_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY=${TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_personal_history.yml
history_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_history.yml
echo_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_echo.yml
vite: VITE_RUBY_HOST=${VITE_RUBY_HOST:-127.0.0.1} VITE_RUBY_CONFIG_PATH=${VITE_RUBY_CONFIG_PATH:-config/vite.hybrid.json} VITE_DEV_SERVER_BIND_HOST=${VITE_DEV_SERVER_BIND_HOST:-127.0.0.1} VITE_DEV_SERVER_HOST=${VITE_DEV_SERVER_HOST:-127.0.0.1} VITE_DEV_SERVER_PROTOCOL=${VITE_DEV_SERVER_PROTOCOL:-wss} VITE_DEV_SERVER_CLIENT_PORT=${VITE_DEV_SERVER_CLIENT_PORT:-443} VITE_DEV_SERVER_PORT=${VITE_DEV_SERVER_PORT:-3037} bin/vite dev
