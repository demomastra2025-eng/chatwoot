backend: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} DB_POOL=${DEV_WEB_DB_POOL:-6} ACTIVE_JOB_QUEUE_ADAPTER=${ACTIVE_JOB_QUEUE_ADAPTER:-sidekiq} bin/rails s -b ${BINDING:-127.0.0.1} -p ${PORT:-3002}
worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} SIDEKIQ_CONCURRENCY=${SIDEKIQ_CONCURRENCY:-5} SIDEKIQ_DB_POOL=${DEV_SIDEKIQ_DB_POOL:-5} ENABLE_SIDEKIQ_CRON=${ENABLE_SIDEKIQ_CRON:-false} DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq.yml
telegram_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_INBOUND_SIDEKIQ_CONCURRENCY=${TELEGRAM_INBOUND_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_TELEGRAM_INBOUND_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_inbound.yml
telegram_personal_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_PERSONAL_INBOUND_SIDEKIQ_CONCURRENCY=${TELEGRAM_PERSONAL_INBOUND_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_TELEGRAM_PERSONAL_INBOUND_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_personal_inbound.yml
captain_runtime_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} CAPTAIN_RUNTIME_SIDEKIQ_CONCURRENCY=${CAPTAIN_RUNTIME_SIDEKIQ_CONCURRENCY:-2} SIDEKIQ_DB_POOL=${DEV_CAPTAIN_RUNTIME_DB_POOL:-3} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_captain_runtime.yml
outbound_messages_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} OUTBOUND_MESSAGES_SIDEKIQ_CONCURRENCY=${OUTBOUND_MESSAGES_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_OUTBOUND_MESSAGES_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_outbound_messages.yml
reminders_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} REMINDERS_SIDEKIQ_CONCURRENCY=${REMINDERS_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_REMINDERS_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_reminders.yml
telephony_realtime_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEPHONY_REALTIME_SIDEKIQ_CONCURRENCY=${TELEPHONY_REALTIME_SIDEKIQ_CONCURRENCY:-2} SIDEKIQ_DB_POOL=${DEV_TELEPHONY_REALTIME_DB_POOL:-3} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telephony_realtime.yml
telegram_personal_history_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY=${TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_TELEGRAM_PERSONAL_HISTORY_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_personal_history.yml
whatsapp_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPP_INBOUND_SIDEKIQ_CONCURRENCY=${WHATSAPP_INBOUND_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_WHATSAPP_INBOUND_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsapp_inbound.yml
whatsappweb_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_INBOUND_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_INBOUND_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_WHATSAPPWEB_INBOUND_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_inbound.yml
history_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_WHATSAPPWEB_HISTORY_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_history.yml
echo_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY:-1} SIDEKIQ_DB_POOL=${DEV_WHATSAPPWEB_ECHO_DB_POOL:-2} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_echo.yml
weixin_gateway: cd services/weixin-personal-gateway && WEIXIN_GATEWAY_HOST=${WEIXIN_GATEWAY_HOST:-127.0.0.1} WEIXIN_GATEWAY_PORT=${WEIXIN_GATEWAY_PORT:-8097} WEIXIN_GATEWAY_TOKEN=${WEIXIN_GATEWAY_TOKEN:-local-weixin-gateway} PYTHONPATH=. python3 -m weixin_gateway.server
kaspi_adapter: cd services/kaspi-pay-adapter && PORT=${KASPI_PAY_ADAPTER_PORT:-4077} TOKEN_SECRET_KEY=${KASPI_PAY_TOKEN_SECRET_KEY} KASPI_PAY_INTERNAL_SECRET=${KASPI_PAY_INTERNAL_SECRET} KASPI_PAY_ADAPTER_STATE_DIR=${KASPI_PAY_ADAPTER_STATE_DIR:-/root/crafty/runtime/kaspi-pay-adapter-dev} npm start
vite: VITE_RUBY_HOST=${VITE_RUBY_HOST:-127.0.0.1} VITE_RUBY_CONFIG_PATH=${VITE_RUBY_CONFIG_PATH:-config/vite.hybrid.json} VITE_DEV_SERVER_BIND_HOST=${VITE_DEV_SERVER_BIND_HOST:-127.0.0.1} VITE_DEV_SERVER_HOST=${VITE_DEV_SERVER_HOST:-127.0.0.1} VITE_DEV_SERVER_PROTOCOL=${VITE_DEV_SERVER_PROTOCOL:-wss} VITE_DEV_SERVER_CLIENT_PORT=${VITE_DEV_SERVER_CLIENT_PORT:-443} VITE_DEV_SERVER_PORT=${VITE_DEV_SERVER_PORT:-3037} bin/vite dev
