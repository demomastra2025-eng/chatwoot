backend: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} DB_POOL=${DEV_WEB_DB_POOL:-6} ACTIVE_JOB_QUEUE_ADAPTER=${ACTIVE_JOB_QUEUE_ADAPTER:-sidekiq} bin/rails s -b ${BINDING:-127.0.0.1} -p ${PORT:-3002}
voice_backend: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} DB_POOL=${DEV_VOICE_WEB_DB_POOL:-6} RAILS_MAX_THREADS=${DEV_VOICE_WEB_THREADS:-5} ACTIVE_JOB_QUEUE_ADAPTER=${ACTIVE_JOB_QUEUE_ADAPTER:-sidekiq} PIDFILE=tmp/pids/voice-server.pid bin/rails s -b 127.0.0.1 -p ${DEV_VOICE_WEB_PORT:-3003}
worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} SIDEKIQ_CONCURRENCY=${SIDEKIQ_CONCURRENCY:-5} SIDEKIQ_DB_POOL=${DEV_SIDEKIQ_DB_POOL:-5} ENABLE_SIDEKIQ_CRON=${ENABLE_SIDEKIQ_CRON:-false} DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq.yml
