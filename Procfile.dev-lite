backend: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} ACTIVE_JOB_QUEUE_ADAPTER=${ACTIVE_JOB_QUEUE_ADAPTER:-sidekiq} bin/rails s -b ${BINDING:-127.0.0.1} -p ${PORT:-3002}
worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} SIDEKIQ_CONCURRENCY=${SIDEKIQ_CONCURRENCY:-5} ENABLE_SIDEKIQ_CRON=${ENABLE_SIDEKIQ_CRON:-false} DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq.yml
telegram_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_INBOUND_SIDEKIQ_CONCURRENCY=${TELEGRAM_INBOUND_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_inbound.yml
telegram_personal_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_PERSONAL_INBOUND_SIDEKIQ_CONCURRENCY=${TELEGRAM_PERSONAL_INBOUND_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_personal_inbound.yml
outbound_messages_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} OUTBOUND_MESSAGES_SIDEKIQ_CONCURRENCY=${OUTBOUND_MESSAGES_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_outbound_messages.yml
reminders_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} REMINDERS_SIDEKIQ_CONCURRENCY=${REMINDERS_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_reminders.yml
telegram_personal_history_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY=${TELEGRAM_PERSONAL_HISTORY_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_telegram_personal_history.yml
whatsappweb_inbound_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_INBOUND_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_INBOUND_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_inbound.yml
history_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_HISTORY_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_history.yml
echo_worker: REDIS_TIMEOUT=${REDIS_TIMEOUT:-5} REDIS_RECONNECT_ATTEMPTS=${REDIS_RECONNECT_ATTEMPTS:-5} WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY=${WHATSAPPWEB_ECHO_SIDEKIQ_CONCURRENCY:-1} ENABLE_SIDEKIQ_CRON=false DISABLE_SIDEKIQ_ALIVE=true bundle exec sidekiq -C config/sidekiq_whatsappweb_echo.yml
vite: VITE_RUBY_HOST=127.0.0.1 bin/vite dev
